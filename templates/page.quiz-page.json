ons__option\"] {\n    padding: 12px 14px !important; min-height: 48px !important;\n    margin-bottom: 8px !important; font-size: 14px !important;\n  }\n\n  .octane-ai-quiz-rendered .oct-quiz-btn--primary,\n  .octane-ai-quiz-rendered button[class*=\"oct-quiz-btn\"]:not([class*=\"back\"]):not([class*=\"secondary\"]) {\n    background: #3f745d !important; color: #fff !important; border-color: #3f745d !important;\n  }\n  .octane-ai-quiz-rendered .oct-quiz-btn--primary:hover {\n    background: #234134 !important; border-color: #234134 !important;\n  }\n\n  .octane-ai-quiz-rendered [class*=\"smart-copy\"],\n  .octane-ai-quiz-rendered [class*=\"smart-copy\"] *,\n  .bb-smart-copy, .bb-smart-copy * { text-align: left !important; }\n  .bb-smart-copy {\n    background: #fff; border: 1px solid #e5e5e1; border-radius: 10px;\n    padding: 16px 18px; margin: 12px 0;\n  }\n  .bb-smart-copy .bb-bullet {\n    display: block; padding-left: 18px; text-indent: -14px;\n    margin-bottom: 10px; line-height: 1.5; font-size: 14px; color: #234134;\n  }\n\n  .octane-ai-quiz-rendered select,\n  .octane-ai-quiz-rendered [role=\"combobox\"] {\n    border: 2px solid #3f745d !important; border-radius: 6px !important;\n    padding: 10px 32px 10px 12px !important; background: #fff !important;\n    font-weight: 600 !important; color: #234134 !important; cursor: pointer !important;\n    appearance: none !important; -webkit-appearance: none !important;\n    background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='8' viewBox='0 0 14 8'><path d='M1 1l6 6 6-6' stroke='%233f745d' stroke-width='2' fill='none'/></svg>\") !important;\n    background-repeat: no-repeat !important; background-position: right 10px center !important;\n  }\n\n  .octane-ai-quiz-rendered [class*=\"oct-quiz-back\"],\n  .octane-ai-quiz-rendered button[class*=\"back\"],\n  .bb-hidden-back, .bb-hero-atc-hidden { display: none !important; }\n\n  .bb-banner {\n    background: #234134; color: #fff; padding: 8px 12px;\n    text-align: center; font-size: 12px; letter-spacing: 0.2px; line-height: 1.3;\n    margin: 0 0 12px 0;\n  }\n  .bb-banner b { color: #F2CB49; font-weight: 700; }\n\n  .bb-bundled-badge {\n    display: flex; align-items: center; justify-content: center; gap: 8px;\n    background: #EAF1ED; color: #234134; border: 2px solid #3f745d; border-radius: 8px;\n    padding: 12px 16px; font-weight: 600; font-size: 14px; letter-spacing: 0.3px;\n    text-align: center; margin: 12px 0;\n  }\n  .bb-bundled-badge::before { content: \"✓\"; color: #3f745d; font-weight: 700; }\n\n  .bb-checkout-bar {\n    position: fixed; left: 0; right: 0; bottom: 0; padding: 12px; background: #fff;\n    border-top: 1px solid #e5e5e1; z-index: 999; box-shadow: 0 -4px 20px rgba(0,0,0,0.06);\n  }\n  .bb-checkout-bar a {\n    display: block; width: 100%; max-width: 600px; margin: 0 auto;\n    background: #234134; color: #fff; padding: 14px 16px; border: none; border-radius: 8px;\n    font-size: 15px; font-weight: 700; letter-spacing: 0.4px; text-decoration: none;\n    text-align: center; cursor: pointer; text-transform: uppercase;\n  }\n  .bb-checkout-bar a:hover { background: #3f745d; }\n</style>\n\n<script>\n(function () {\n  'use strict';\n\n  function injectBanner() {\n    if (document.querySelector('.bb-banner')) return;\n    var embed = document.querySelector('.octane-ai-quiz, .octane-ai-quiz-rendered');\n    if (!embed) return;\n    var banner = document.createElement('div');\n    banner.className = 'bb-banner';\n    banner.innerHTML = 'Your personalized bundle expires in <b id=\"bb-timer\">10:00</b> — finish to save 20% + free shipping';\n    embed.parentNode.insertBefore(banner, embed);\n  }\n\n  var startMs = parseInt(localStorage.getItem('bb-quiz-start') || '0', 10);\n  if (!startMs) { startMs = Date.now(); try { localStorage.setItem('bb-quiz-start', String(startMs)); } catch (e) {} }\n  function tickTimer() {\n    var elapsed = Math.floor((Date.now() - startMs) / 1000);\n    var remain = Math.max(0, 600 - elapsed);\n    var m = Math.floor(remain / 60), s = remain % 60;\n    var el = document.getElementById('bb-timer');\n    if (el) el.textContent = m + ':' + (s < 10 ? '0' + s : s);\n  }\n  setInterval(tickTimer, 1000); tickTimer();\n\n  function rewriteHeroLinks() {\n    document.querySelectorAll('a[href*=\"/products/betterlungs-old\"]').forEach(function (a) {\n      a.setAttribute('href', a.getAttribute('href').replace(\n        /\\/products\\/betterlungs-old\\?variant=\\d+/,\n        '/products/betterlungs?variant=50318075461931'\n      ));\n    });\n  }\n\n  function decorateQ1Labels() {\n    document.querySelectorAll('[class*=\"picture-choice-options__option\"]').forEach(function (li) {\n      if (li.dataset.bbQ1Done === '1') return;\n      var walker = document.createTreeWalker(li, NodeFilter.SHOW_TEXT, null, false);\n      var n;\n      while ((n = walker.nextNode())) {\n        var m = (n.textContent || '').match(/^\\s*(.+?)\\s*\\(\\$19\\.95\\s*value\\)\\s*$/i);\n        if (!m) continue;\n        var span = document.createElement('span');\n        span.innerHTML = m[1].trim() + '<br><span class=\"bb-q1-strike\">$19.95</span><span class=\"bb-q1-free\">FREE</span>';\n        n.parentNode.replaceChild(span, n);\n        li.dataset.bbQ1Done = '1';\n        break;\n      }\n    });\n  }\n\n  function reformatSmartCopy() {\n    document.querySelectorAll('div, p, span').forEach(function (el) {\n      if (el.dataset.bbSmartCopyDone === '1') return;\n      if (el.children && el.children.length > 0) return;\n      if (el.classList && el.classList.contains('bb-bullet')) return;\n      var raw = (el.textContent || '').trim();\n      if (!raw || raw.length < 30) return;\n      if ((raw.match(/•/g) || []).length < 2) return;\n      if (!/(Because|Since)\\b/i.test(raw)) return;\n      var parts = raw.split(/\\s*•\\s*/).map(function (s) { return s.trim(); }).filter(Boolean);\n      if (parts.length < 2) return;\n      var wrap = document.createElement('div');\n      wrap.className = 'bb-smart-copy';\n      parts.forEach(function (p) {\n        var b = document.createElement('span');\n        b.className = 'bb-bullet';\n        b.textContent = '• ' + p;\n        wrap.appendChild(b);\n      });\n      el.innerHTML = '';\n      el.appendChild(wrap);\n      el.dataset.bbSmartCopyDone = '1';\n    });\n  }\n\n  function hideGiftIframe() {\n    document.querySelectorAll('iframe').forEach(function (ifr) {\n      var doc;\n      try { doc = ifr.contentDocument || (ifr.contentWindow && ifr.contentWindow.document); } catch (e) { return; }\n      if (!doc || !doc.body) return;\n      var t = (doc.body.textContent || '');\n      if (t.indexOf('Free Gift') === -1 && t.indexOf('Money-Back Guarantee') === -1) return;\n      ifr.style.display = 'none';\n      var wrap = ifr.parentElement;\n      for (var j = 0; j < 3 && wrap; j++) {\n        if (wrap.children && wrap.children.length === 1) wrap.style.display = 'none';\n        wrap = wrap.parentElement;\n      }\n    });\n  }\n\n  function hideBackButtons() {\n    document.querySelectorAll('button, a, div, span').forEach(function (b) {\n      if (b.children && b.children.length > 0) return;\n      var t = (b.textContent || '').trim().toUpperCase().replace(/[\\s←]+/g, '');\n      if (t === 'BACK' && !b.classList.contains('bb-hidden-back')) {\n        b.classList.add('bb-hidden-back');\n        var w = b.closest('button, a');\n        if (w && !w.classList.contains('bb-hidden-back')) w.classList.add('bb-hidden-back');\n      }\n    });\n  }\n\n  var GIFT_HANDLES = ['beepropolis-throat-spray', 'nasal-strips'];\n  var cartAddState = { added: false, attempts: 0 };\n  function getVar(href) { var m = (href || '').match(/[?&]variant=(\\d+)/); return m ? m[1] : null; }\n  function findCard(a) {\n    var el = a;\n    for (var i = 0; i < 10 && el; i++) {\n      var cls = (el.className || '').toString();\n      if (cls.indexOf('oct-quiz-products__item') !== -1) return el;\n      el = el.parentElement;\n    }\n    return a.parentElement;\n  }\n  function decorateCard(card, txt) {\n    if (!card || card.dataset.bbDec === '1') return;\n    card.querySelectorAll('button[class*=\"oct-quiz-btn\"]').forEach(function (b) { b.classList.add('bb-hero-atc-hidden'); });\n    if (!card.querySelector('.bb-bundled-badge')) {\n      var b = document.createElement('div'); b.className = 'bb-bundled-badge'; b.textContent = txt;\n      card.appendChild(b);\n    }\n    card.dataset.bbDec = '1';\n  }\n  function autoAddToCart() {\n    if (cartAddState.attempts > 30) return;\n    var resultPage = document.querySelector('[class*=\"result-page\"], [class*=\"result-item\"]');\n    if (!resultPage) return;\n    var anchors = document.querySelectorAll('a[href*=\"/products/\"]');\n    var gA = null, hA = null;\n    for (var i = 0; i < anchors.length; i++) {\n      var href = anchors[i].getAttribute('href') || '';\n      var isGift = GIFT_HANDLES.some(function (h) { return href.indexOf('/products/' + h) !== -1; });\n      if (isGift && !gA) gA = anchors[i];\n      else if (!isGift && href.indexOf('/products/') !== -1 && !hA) hA = anchors[i];\n    }\n    if (!gA || !hA) return;\n    var gV = getVar(gA.getAttribute('href')), hV = getVar(hA.getAttribute('href'));\n    if (!gV || !hV) return;\n    cartAddState.attempts++;\n    decorateCard(findCard(gA), 'Added to your bundle (FREE)');\n    decorateCard(findCard(hA), 'Added to your bundle');\n    if (!document.querySelector('.bb-checkout-bar')) {\n      var bar = document.createElement('div'); bar.className = 'bb-checkout-bar';\n      var a = document.createElement('a');\n      a.textContent = 'Continue to Checkout →';\n      a.href = '/cart/' + hV + ':1,' + gV + ':1?discount=Free-Kit-20';\n      bar.appendChild(a);\n      document.body.appendChild(bar);\n    }\n    if (!cartAddState.added) {\n      try {\n        fetch('/cart/add.js', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ items: [{ id: parseInt(hV, 10), quantity: 1 }, { id: parseInt(gV, 10), quantity: 1 }] })\n        }).then(function (r) { if (r && r.ok) cartAddState.added = true; }).catch(function () {});\n      } catch (e) {}\n    }\n  }\n\n  function tick() {\n    injectBanner();\n    hideBackButtons();\n    decorateQ1Labels();\n    reformatSmartCopy();\n    hideGiftIframe();\n    rewriteHeroLinks();\n    autoAddToCart();\n  }\n  new MutationObserver(tick).observe(document.body, { childList: true, subtree: true });\n  document.addEventListener('DOMContentLoaded', tick);\n  setInterval(tick, 1000);\n})();\n</script>"
