<script data-bb-bis-script>
(function() {
  if (window.__bbBisInit) return; window.__bbBisInit = true;

  var SUBMIT_URL = 'https://yswqqjakuifsgslwskgq.supabase.co/functions/v1/serve-form/back-in-stock/submit';
  var TRIGGER_LABEL = 'Notify Me When It’s Back';
  var DEBUG = true;
  function log()  { if (DEBUG && window.console) console.log.apply(console, ['[bb-bis]'].concat([].slice.call(arguments))); }
  function warn() { if (window.console) console.warn.apply(console, ['[bb-bis]'].concat([].slice.call(arguments))); }

  log('init · v2.3 · 2026-04-30');

  // ============================================================
  // ESCAPE TRANSFORMED ANCESTOR — move overlay to document.body
  // ============================================================
  // CSS spec: an ancestor with transform/filter/perspective/will-change/contain
  // becomes the containing block for `position: fixed` descendants. If our
  // snippet is rendered inside such an ancestor, the overlay collapses into
  // that ancestor's box instead of covering the viewport. To escape, we
  // physically move the overlay element to be a direct child of <body>.
  function liftOverlayToBody() {
    var overlay = document.getElementById('bb-bis-overlay');
    if (!overlay) return;
    if (overlay.parentNode === document.body) return;
    document.body.appendChild(overlay);
    log('lifted overlay to document.body to escape any transformed ancestor');
  }
  if (document.body) liftOverlayToBody();
  else document.addEventListener('DOMContentLoaded', liftOverlayToBody);

  // ============================================================
  // PRODUCT DATA SANITY CHECK
  // ============================================================
  var p = window.bbBisProduct;
  if (!p) {
    warn('window.bbBisProduct is missing. Did you {%- raw -%}{%- render \'back-in-stock\' -%}{%- endraw -%} OUTSIDE a product context? It must be rendered inside a product section/template where `product` is defined.');
    return;
  }
  if (!p.variants || !p.variants.length) {
    warn('product.variants is empty — snippet won\'t do anything. This usually means the snippet was rendered outside a product page (e.g. theme.liquid). Move it into sections/main-product.liquid or your product template.');
    return;
  }
  var oosCount = p.variants.filter(function(v){ return !v.available; }).length;
  log('product loaded:', p.title, '· variants:', p.variants.length, '· OOS:', oosCount);

  // ============================================================
  // VARIANT LOOKUP
  // ============================================================
  function findVariant(variantId) {
    if (!variantId) return null;
    var idStr = String(variantId);
    for (var i = 0; i < p.variants.length; i++) {
      if (String(p.variants[i].id) === idStr) return p.variants[i];
    }
    return null;
  }

  function readSelectedVariantId() {
    // 1. URL param ?variant= (Section Rendering API canonical source on Dawn-family themes)
    try {
      var url = new URL(window.location.href);
      var qv = url.searchParams.get('variant');
      if (qv) return qv;
    } catch(_) {}
    // 2. Form field name="id" (works on classic and modern themes)
    var hidden = document.querySelector('form[action*="/cart/add"] [name="id"]');
    if (hidden && hidden.value) return hidden.value;
    // 3. Fallback: first available variant, else first variant
    for (var i = 0; i < p.variants.length; i++) if (p.variants[i].available) return p.variants[i].id;
    return p.variants[0] && p.variants[0].id;
  }

  // ============================================================
  // POPUP OPEN / CLOSE
  // ============================================================
  function openBisPopup(variant) {
    var overlay = document.getElementById('bb-bis-overlay');
    if (!overlay) { warn('overlay element not found in DOM'); return; }

    var fullTitle = variant.title && variant.title !== 'Default Title'
      ? p.title + ' — ' + variant.title
      : p.title;
    var imgUrl = variant.image || p.featuredImage;

    var nameEl = overlay.querySelector('[data-bb-bis-name]');
    var captionEl = overlay.querySelector('[data-bb-bis-caption]');
    var imgEl = overlay.querySelector('[data-bb-bis-img]');
    var successProductEl = overlay.querySelector('[data-bb-bis-success-product]');

    if (nameEl) nameEl.textContent = fullTitle;
    if (captionEl) captionEl.textContent = fullTitle;
    if (imgEl && imgUrl) { imgEl.src = imgUrl; imgEl.alt = fullTitle; }
    if (successProductEl) successProductEl.textContent = fullTitle;

    var formSection = overlay.querySelector('[data-bb-bis-form-section]');
    var successSection = overlay.querySelector('[data-bb-bis-success]');
    var errorDiv = overlay.querySelector('[data-bb-bis-error]');
    var submitBtn = overlay.querySelector('[data-bb-bis-submit]');
    if (formSection) formSection.style.display = '';
    if (successSection) successSection.classList.remove('bb-bis-show');
    if (errorDiv) errorDiv.classList.remove('bb-bis-show');
    if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Notify Me When It’s Back'; }

    window.__bbBisActiveVariant = variant;
    overlay.removeAttribute('hidden');
    log('popup opened for variant:', variant.id, variant.title);
  }
  function closeBisPopup() {
    var overlay = document.getElementById('bb-bis-overlay');
    if (overlay) overlay.setAttribute('hidden', '');
  }

  // ============================================================
  // INJECT "NOTIFY ME" TRIGGER BUTTON INTO PRODUCT FORM
  // ============================================================
  function findCartForm() {
    return document.querySelector('form[action*="/cart/add"]');
  }
  function findAtcButton(form) {
    if (!form) return null;
    return form.querySelector(
      'button[name="add"], button[type="submit"][name="add"], [data-add-to-cart], ' +
      'button[type="submit"]:not([data-bb-bis-trigger]):not(.bb-bis-trigger):not([data-bb-bis-close])'
    );
  }

  function syncTriggerForVariant(variant) {
    var form = findCartForm();
    if (!form) {
      // no form on this page — bail (could be a non-product page or fully headless theme)
      return;
    }

    var atc = findAtcButton(form);
    var existing = form.querySelector('[data-bb-bis-trigger]');

    if (variant && !variant.available) {
      // OOS: hide ATC, show our trigger
      if (atc && !atc.hasAttribute('data-bb-bis-hidden-atc')) {
        atc.setAttribute('data-bb-bis-hidden-atc', '');
        log('hid theme ATC button:', atc.tagName + (atc.name ? '[name='+atc.name+']' : ''));
      }
      if (existing) {
        // already showing our button — just update its variant binding
        existing.setAttribute('data-variant-id', variant.id);
        return;
      }
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'bb-bis-trigger';
      btn.setAttribute('data-bb-bis-trigger', '');
      btn.setAttribute('data-variant-id', variant.id);
      btn.textContent = TRIGGER_LABEL;
      // Insert AFTER atc if found, else at the end of the form
      if (atc && atc.parentNode) {
        atc.parentNode.insertBefore(btn, atc.nextSibling);
      } else {
        form.appendChild(btn);
      }
      log('injected Notify Me trigger for OOS variant:', variant.id, variant.title);
    } else {
      // In-stock or unknown: remove our trigger, restore ATC
      if (existing) { existing.remove(); log('removed Notify Me trigger (variant in stock)'); }
      if (atc && atc.hasAttribute('data-bb-bis-hidden-atc')) {
        atc.removeAttribute('data-bb-bis-hidden-atc');
        log('restored theme ATC button');
      }
    }
  }

  function refreshFromCurrentVariant(reason) {
    var vid = readSelectedVariantId();
    var v = findVariant(vid);
    log('refresh ('+(reason||'manual')+') variant:', vid, '· available:', v ? v.available : 'unknown');
    if (!v) return;
    window.__bbBisCurrentVariant = v;
    syncTriggerForVariant(v);
  }

  // ============================================================
  // VARIANT CHANGE WATCHERS
  // ============================================================

  // 1) Listen to changes on the cart form (radio/select variant pickers)
  document.addEventListener('change', function(e) {
    var form = e.target.closest && e.target.closest('form[action*="/cart/add"]');
    if (!form) return;
    // small delay so the theme has time to update name="id" / URL
    setTimeout(function(){ refreshFromCurrentVariant('form change'); }, 50);
  });

  // 2) URL changes via pushState/replaceState (Section Rendering API doesn't fire popstate)
  ['pushState','replaceState'].forEach(function(fnName) {
    var orig = history[fnName];
    history[fnName] = function() {
      var ret = orig.apply(this, arguments);
      setTimeout(function(){ refreshFromCurrentVariant('history.'+fnName); }, 50);
      return ret;
    };
  });
  window.addEventListener('popstate', function(){ refreshFromCurrentVariant('popstate'); });

  // 3) MutationObserver fallback — catches sections that re-render the form HTML wholesale
  var observerInited = false;
  function initObserver() {
    if (observerInited) return;
    var form = findCartForm();
    if (!form) return;
    observerInited = true;
    var mo = new MutationObserver(function(){
      // Debounce
      clearTimeout(window.__bbBisMoDebounce);
      window.__bbBisMoDebounce = setTimeout(function(){ refreshFromCurrentVariant('mutation'); }, 100);
    });
    mo.observe(form, { childList: true, subtree: true, attributes: true, attributeFilter: ['value','name','disabled','hidden'] });
    log('MutationObserver attached to cart form');
  }

  // ============================================================
  // CLICK HANDLER FOR OUR INJECTED BUTTON (and SECONDARY safety-net for stray ATC clicks)
  // ============================================================
  document.addEventListener('click', function(e) {
    // Our trigger button
    var trigger = e.target.closest('[data-bb-bis-trigger]');
    if (trigger) {
      e.preventDefault();
      var vid = trigger.getAttribute('data-variant-id') || readSelectedVariantId();
      var v = findVariant(vid);
      if (v) openBisPopup(v);
      else warn('trigger clicked but no matching variant found for id', vid);
      return;
    }

    // Safety net: if some theme STILL fires an ATC click for an OOS variant
    // (e.g. enabled-but-shows-error pattern), intercept and pop our modal.
    var btn = e.target.closest('button[type="submit"], [name="add"], [data-add-to-cart]');
    if (!btn) return;
    if (btn.hasAttribute('data-bb-bis-hidden-atc')) { e.preventDefault(); return; }
    var form = btn.closest('form[action*="/cart/add"]');
    if (!form) return;
    var variantInput = form.querySelector('[name="id"]');
    if (!variantInput) return;
    var v = findVariant(variantInput.value);
    if (!v || v.available) return;
    log('safety-net: caught ATC click on OOS variant', v.id);
    e.preventDefault();
    e.stopPropagation();
    if (e.stopImmediatePropagation) e.stopImmediatePropagation();
    openBisPopup(v);
  }, true);

  // Block form submits for OOS variants too (covers programmatic submits)
  document.addEventListener('submit', function(e) {
    var form = e.target;
    if (!form || !form.action || form.action.indexOf('/cart/add') === -1) return;
    var variantInput = form.querySelector('[name="id"]');
    if (!variantInput) return;
    var v = findVariant(variantInput.value);
    if (!v || v.available) return;
    log('safety-net: caught form submit for OOS variant', v.id);
    e.preventDefault();
    e.stopPropagation();
    if (e.stopImmediatePropagation) e.stopImmediatePropagation();
    openBisPopup(v);
  }, true);

  // ============================================================
  // CLOSE / KEYBOARD
  // ============================================================
  document.addEventListener('click', function(e) {
    if (e.target.closest('[data-bb-bis-close]')) { closeBisPopup(); return; }
    if (e.target.id === 'bb-bis-overlay') closeBisPopup();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeBisPopup();
  });

  // ============================================================
  // PHONE FORMATTER
  // ============================================================
  document.addEventListener('input', function(e) {
    var ph = e.target.closest('[data-bb-bis-phone]');
    if (!ph) return;
    var v = ph.value.replace(/\D/g, '').slice(0, 10);
    if (v.length > 6) v = '(' + v.slice(0,3) + ') ' + v.slice(3,6) + '-' + v.slice(6);
    else if (v.length > 3) v = '(' + v.slice(0,3) + ') ' + v.slice(3);
    else if (v.length > 0) v = '(' + v;
    ph.value = v;
  });

  // ============================================================
  // FORM SUBMIT TO KLAVIYO BIS API (via Supabase Edge Function)
  // ============================================================
  document.addEventListener('submit', function(e) {
    var form = e.target.closest('[data-bb-bis-form]');
    if (!form) return;
    e.preventDefault();
    e.stopPropagation();

    var modal = form.closest('.bb-bis-modal');
    var emailInput = modal.querySelector('[data-bb-bis-email]');
    var phoneInput = modal.querySelector('[data-bb-bis-phone]');
    var submitBtn = modal.querySelector('[data-bb-bis-submit]');
    var errorDiv = modal.querySelector('[data-bb-bis-error]');
    var formSection = modal.querySelector('[data-bb-bis-form-section]');
    var successSection = modal.querySelector('[data-bb-bis-success]');

    errorDiv.classList.remove('bb-bis-show');
    emailInput.classList.remove('bb-bis-error-field');
    phoneInput.classList.remove('bb-bis-error-field');

    var email = emailInput.value.trim();
    var phoneRaw = phoneInput.value.replace(/\D/g, '');

    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      emailInput.classList.add('bb-bis-error-field');
      errorDiv.textContent = 'Please enter a valid email address.';
      errorDiv.classList.add('bb-bis-show');
      return;
    }
    if (phoneRaw.length !== 10) {
      phoneInput.classList.add('bb-bis-error-field');
      errorDiv.textContent = 'Please enter a valid 10-digit US mobile number.';
      errorDiv.classList.add('bb-bis-show');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting…';

    var v = window.__bbBisActiveVariant || {};
    var payload = {
      email: email,
      phone: '+1' + phoneRaw,
      product: {
        title: p.title,
        variantId: v.id,
        productId: p.productId,
        imageUrl: v.image || p.featuredImage,
        url: p.url
      }
    };
    log('submitting BIS subscription:', payload.email, '·', payload.phone, '·', v.id);

    fetch(SUBMIT_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
    .then(function(r) { return r.json().then(function(j) { return { ok: r.ok, j: j }; }); })
    .then(function(res) {
      if (!res.ok || !res.j.success) throw new Error(res.j.error || 'Subscription failed');
      log('submit success');
      formSection.style.display = 'none';
      successSection.classList.add('bb-bis-show');
      try { localStorage.setItem('bb_bis_' + (v.id || ''), Date.now().toString()); } catch (_) {}
    })
    .catch(function(err) {
      warn('submit failed:', err.message);
      errorDiv.textContent = err.message || 'Network error. Please try again.';
      errorDiv.classList.add('bb-bis-show');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Notify Me When It’s Back';
    });
  }, true);

  // ============================================================
  // SUBSCRIPTION-APP OOS DETECTION (Loop / Stay AI / Skio / etc.)
  // ============================================================
  // Some subscription apps manage inventory separately from Shopify's
  // variant.available. They render their own "Out of stock" text in the
  // widget while Shopify still reports the variant in-stock. This block
  // detects that visible signal — works regardless of which app — and
  // also opportunistically listens for app-specific events.

  var OOS_TEXT_RE = /\b(out\s*of\s*stock|sold\s*out|unavailable|currently\s*unavailable|notify\s*me\s*when\s*available)\b/i;

  function findProductFormScope() {
    // Look for the cart form first; widen to common product-section ancestors
    var form = findCartForm();
    if (!form) return document.body;
    var section = form.closest('[id*="MainProduct"], [id*="product-section"], [class*="product-form"], main, section') || form;
    return section;
  }

  function detectVisibleOosText() {
    var scope = findProductFormScope();
    if (!scope) return false;
    // Only consider visible text nodes
    var texts = scope.innerText || scope.textContent || '';
    if (!OOS_TEXT_RE.test(texts)) return false;
    // Make sure the matching text node is actually visible (not display:none deep in DOM)
    var nodes = scope.querySelectorAll('*');
    for (var i = 0; i < nodes.length; i++) {
      var n = nodes[i];
      if (!OOS_TEXT_RE.test(n.textContent || '')) continue;
      // Skip our own popup nodes
      if (n.closest && n.closest('.bb-bis-overlay')) continue;
      // Skip if has lots of children — only want leaf-ish text
      if (n.children.length > 3) continue;
      var cs = window.getComputedStyle(n);
      if (cs.display === 'none' || cs.visibility === 'hidden' || cs.opacity === '0') continue;
      return true;
    }
    return false;
  }

  function syncFromTextSignal(reason) {
    var hasOosText = detectVisibleOosText();
    var vid = readSelectedVariantId();
    var v = findVariant(vid);

    // v2.3: decouple OOS detection from variant lookup. If Loop (or any
    // subscription app) shows "Out of stock" text, we fire the popup even
    // if we can't identify the exact variant. Loop maintains its own
    // variant state — we shouldn't depend on it being in our variants array
    // or in the URL/form. Use a synthetic fallback variant from the
    // product-level data when our lookup fails.
    if (hasOosText) {
      var override;
      if (v) {
        log('text-signal OOS ('+reason+') — overriding variant.available for', v.id);
        override = { id: v.id, title: v.title, available: false, image: v.image };
      } else {
        log('text-signal OOS ('+reason+') — variant lookup FAILED for vid='+vid+', using product-level fallback');
        override = {
          id: vid || (p.variants[0] && p.variants[0].id) || p.productId,
          title: 'Selected option',
          available: false,
          image: p.featuredImage
        };
      }
      window.__bbBisCurrentVariant = override;
      syncTriggerForVariant(override);
      return;
    }

    if (!v) return; // No OOS text and no variant — nothing to do

    // No OOS text visible — fall back to native variant.available
    window.__bbBisCurrentVariant = v;
    syncTriggerForVariant(v);
  }

  // Watch the product section for text/DOM changes (subscription widget re-renders)
  var textObserverInited = false;
  function initTextObserver() {
    if (textObserverInited) return;
    var scope = findProductFormScope();
    if (!scope || scope === document.body) return;
    textObserverInited = true;
    var mo = new MutationObserver(function(){
      clearTimeout(window.__bbBisTextDebounce);
      window.__bbBisTextDebounce = setTimeout(function(){ syncFromTextSignal('text mutation'); }, 120);
    });
    mo.observe(scope, { childList: true, subtree: true, characterData: true, attributes: true, attributeFilter: ['class','disabled','hidden','style'] });
    log('text-OOS observer attached to product scope');
  }

  // Loop / Stay AI / Skio / generic subscription app event hooks
  // (cheap to attach — if events don't exist, no harm)
  var SUB_APP_EVENTS = [
    'loop:variant:change', 'loop:variantChange', 'loop:variantChanged',
    'loopwork:variant:change', 'loopwork:variantChange',
    'loop:plan:change', 'loop:sellingPlanChange',
    'subscription:variant:change', 'subscription:plan:change',
    'stayai:variantChange', 'skio:variantChange', 'recharge:variantChange',
    'shopify:variant:change', 'variant:change'
  ];
  SUB_APP_EVENTS.forEach(function(ev) {
    document.addEventListener(ev, function(){
      log('subscription-app event fired:', ev);
      setTimeout(function(){ syncFromTextSignal('event:'+ev); }, 50);
    });
  });

  // Diagnostic: log subscription-app presence (visible in console for tightening)
  function logSubscriptionAppPresence() {
    var sig = {
      loopGlobal: !!window.Loop || !!window.LoopSubscriptions || !!window.loopwork,
      loopElements: document.querySelectorAll('[class*="loop-"], [data-loop], loop-subscription-widget, loop-subscription, [id*="loop-widget"]').length,
      stayAi: !!window.stayai || document.querySelectorAll('[class*="stayai"]').length,
      skio: !!window.Skio || document.querySelectorAll('[class*="skio"]').length,
      recharge: !!window.ReChargeWidget || document.querySelectorAll('[id*="recharge"]').length,
      bold: !!window.BOLD || document.querySelectorAll('[class*="bold-subscription"]').length,
      shopifySellingPlan: !!document.querySelector('[name="selling_plan"]'),
      visibleOosTextNow: detectVisibleOosText()
    };
    log('subscription-app signature:', JSON.stringify(sig));
  }

  // ============================================================
  // KICK OFF
  // ============================================================
  function ready(fn) {
    if (document.readyState !== 'loading') fn();
    else document.addEventListener('DOMContentLoaded', fn);
  }
  ready(function(){
    refreshFromCurrentVariant('initial');
    initObserver();
    initTextObserver();
    logSubscriptionAppPresence();
    syncFromTextSignal('initial text-check');
    // Re-check every 750ms for the first 5s in case the theme/widget renders async
    var ticks = 0;
    var iv = setInterval(function(){
      ticks++;
      refreshFromCurrentVariant('tick '+ticks);
      initObserver();
      initTextObserver();
      syncFromTextSignal('tick '+ticks+' text-check');
      if (ticks >= 7) {
        clearInterval(iv);
        logSubscriptionAppPresence();
      }
    }, 750);
  });
})();
</script>
{%- endunless -%}