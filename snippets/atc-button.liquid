<!-- START atc-button (SNIPPET) -->

{% if oos_only %}
  <div
    id="button-out-of-stock"
    class="btn btn-choose-variant"
    {% if variant.available %}
      style="display: none;"
    {% endif %}
  >
    <span class="btn-label">{{ settings.out_of_stock_label | default: '( out of stock )' | escape }}</span>
  </div>
{% else %}
<div
  class="product-form__buttons"
  {% unless product.selected_or_first_available_variant.available %}
    style="display: none"
  {% endunless %}
>
  <button
    type="submit"
    class="{% if settings.disable_cartDrawer != true %} cart-icon {% endif %} btn btn-add-tocart "
    id="AddToCart"
    {% if product.selected_or_first_available_variant.available == false %}
      disabled
    {% endif %}
  >
    <div class="text-btn">
      {%- if settings.enable_price_atc -%}
        <span class="btn-money"><strong>{{ variant.price | money }}</strong></span>
        <span class="divisor"><strong>|</strong></span>
      {%- endif -%}
      <span class="btn-label"><strong>{{ settings.add_to_cart_label }}</strong></span>
      <span class="btn-svg">{%- render 'icon-cart-fill' -%}</span>
      <span class="btn-items">&#40;1 {{ 'products.product.item' | t }}&#41;</span>

      {%- if settings.atc_progress_bar -%}
        <span class="btn-progress"></span>
      {%- endif -%}
    </div>
  </button>
</div>

{%- if product.metafields.custom.sale_text != blank -%}
  <div class="atc-button-stack">
    <p>{{ product.metafields.custom.sale_text | metafield_tag }}</p>
  </div>
{%- endif -%}

<div id="truemed-instructions" style="font-size: 14px;" icon-height="12" data-public-id="tm_qual_9xseuzwifp"></div>
<script src="https://static.truemed.com/widgets/product-page-widget.min.js" defer></script>

<style>
  .truemed-entry-box {
    justify-content: center;
    margin-bottom: 15px;
  }

  .atc-button-stack {
    text-align: center;
    background-color: #c2deb4;
    padding: 10px;
    width: 84%;
    margin: 0 auto 10px;
    border-radius: 10px;
  }

  .atc-button-stack p {
    margin: 0;
  }

  @media (max-width: 767px) {
    .truemed-entry-text {
      font-size: 11px;
    }
    .truemed-entry-box {
        margin-top: 15px;
    }
    .atc-button-stack {
      margin: 10px auto; 
      width: 90%;
    }
  }
</style>
{% endif %}
