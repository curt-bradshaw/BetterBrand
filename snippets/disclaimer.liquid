<!-- Start snippets/disclaimer.liquid -->
{% comment %}
  Product metafield (placeholder): namespace `custom`, key `disclaimer`.
  Create under Settings → Custom data → Products → Add definition (e.g. multi-line text).
{% endcomment %}

{%- if product.metafields.custom.disclaimer != blank -%}
{% comment %} Section-scoped typography (same pattern as product-description.liquid) {% endcomment %}
{%- if section.id != blank -%}
  <style>
    #shopify-section-{{ section.id }} .product-page__disclaimer,
    #shopify-section-{{ section.id }} .product-page__disclaimer * {
      font-size: 15px;
      font-weight: 400;
      font-style: normal;
      text-align: center;
      color: inherit;
    }

    @media (max-width: 1019px) {
      #shopify-section-{{ section.id }} .product-page__disclaimer,
      #shopify-section-{{ section.id }} .product-page__disclaimer * {
        font-size: 14px;
      }
    }

    @media (max-width: 767px) {
      #shopify-section-{{ section.id }} .product-page__disclaimer,
      #shopify-section-{{ section.id }} .product-page__disclaimer * {
        font-size: 14px;
      }
    }
  </style>
{%- endif -%}

{% comment %} Layout and spacing (aligned with meta-short-description / product-page__product-description) {% endcomment %}
<style>
  .product-page__disclaimer {
    margin: 11px 0;
    text-align: center;
    letter-spacing: 0;
    line-height: 1.4;
  }

  @media (max-width: 1019px) {
    .product-page__disclaimer {
      margin: 12px 0 13px;
    }
  }

  @media (max-width: 767px) {
    .product-page__disclaimer {
      margin: 2px 0;
      font-size: 14px;
    }
  }
</style>

<div class="product-page__disclaimer">
  {{ product.metafields.custom.sale_text | metafield_tag }}
</div>
{%- endif -%}

<!-- End snippets/disclaimer.liquid -->
