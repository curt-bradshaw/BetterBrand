{% comment %}
  PDP variant-based "flavor" selector — same circular thumbnail design as
  pdp-related-product-links, but switches between variants of the SAME product
  without leaving the page.

  Requires the product to have an option named (case-insensitive):
    - Flavor   (default)
  Override with `option_name` parameter to target a different option, e.g.:
    {% render 'pdp-flavor-variant-selector', option_name: 'Scent' %}

  Placement is identical to the related-product-links snippet:
    - 'title'   (default) — under the product title
    - 'gallery' — under the mobile gallery (max-width 1019px only)

  Pass suppress_title_on_mobile: true to hide the title placement on mobile
  when the section already renders a `product_images` (gallery) copy.

  Renders nothing when the product has 0 or 1 matching variants.
{% endcomment %}

{%- assign placement = placement | default: 'title' -%}
{%- assign suppress_title_on_mobile = suppress_title_on_mobile | default: false -%}
{%- assign option_name = option_name | default: 'Flavor' -%}
{%- assign option_name_lower = option_name | downcase -%}

{%- assign option_index = -1 -%}
{%- for opt in product.options -%}
  {%- assign opt_lower = opt | downcase -%}
  {%- if opt_lower == option_name_lower -%}
    {%- assign option_index = forloop.index0 -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if option_index >= 0 and product.variants.size > 1 -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign current_value = current_variant.options[option_index] -%}

  {%- assign seen_values = '' -%}
  {%- assign rendered_count = 0 -%}

  <div class="pdp-flavor-variant-selector-root pdp-flavor-variant-selector-root--{{ placement }}">
    <h2
      class="pdp-flavor-variant-selector__heading"
      id="pdp-flavor-variant-heading-{{ section.id }}-{{ placement }}"
    >
      {{ 'products.product.choose_your_flavor' | t }}
    </h2>
    <nav
      class="pdp-flavor-variant-selector"
      aria-labelledby="pdp-flavor-variant-heading-{{ section.id }}-{{ placement }}"
    >
      <ul class="pdp-flavor-variant-selector__list" role="list">
        {%- for v in product.variants -%}
          {%- assign value = v.options[option_index] -%}
          {%- assign marker = '||' | append: value | append: '||' -%}
          {%- if seen_values contains marker -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign seen_values = seen_values | append: marker -%}
          {%- assign rendered_count = rendered_count | plus: 1 -%}

          {%- assign is_current = false -%}
          {%- if value == current_value -%}{%- assign is_current = true -%}{%- endif -%}

          {%- assign thumb_image = v.image | default: product.featured_image -%}

          <li class="pdp-flavor-variant-selector__item">
            <button
              type="button"
              class="pdp-flavor-variant-selector__link{% if is_current %} pdp-flavor-variant-selector__link--current{% endif %}"
              data-variant-id="{{ v.id }}"
              data-flavor-value="{{ value | escape }}"
              title="{{ value | escape }}"
              {% if is_current %}aria-current="true"{% endif %}
            >
              <span class="pdp-flavor-variant-selector__thumb{% if is_current %} pdp-flavor-variant-selector__thumb--current{% endif %}">
                {%- if thumb_image -%}
                  <img
                    class="pdp-flavor-variant-selector__img"
                    src="{{ thumb_image | image_url: width: 160 }}"
                    alt=""
                    role="presentation"
                    width="64"
                    height="64"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="pdp-flavor-variant-selector__placeholder" aria-hidden="true"></span>
                {%- endif -%}
              </span>
              <span class="pdp-flavor-variant-selector__caption">{{ value | escape }}</span>
            </button>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  </div>

  {%- if rendered_count > 1 -%}
    <style>
      .pdp-flavor-variant-selector-root--gallery {
        display: none;
      }
      @media (max-width: 1019px) {
        {% if suppress_title_on_mobile %}
          .pdp-flavor-variant-selector-root--title {
            display: none !important;
          }
        {% endif %}
        .pdp-flavor-variant-selector-root--gallery {
          display: block;
          width: 100%;
        }
        .pdp-flavor-variant-selector-root--gallery .pdp-flavor-variant-selector {
          margin-top: 10px;
          margin-bottom: 18px;
        }
      }

      .pdp-flavor-variant-selector__heading {
        margin: 0 0 10px;
        padding: 0;
        font-family: var(--bookmaniaFont, Georgia, serif);
        font-size: 18px;
        font-weight: 700;
        line-height: 1.2;
        color: #234134;
        text-align: left;
      }
      @media (max-width: 1019px) {
        .pdp-flavor-variant-selector__heading {
          text-align: center;
        }
      }

      .product-page .product-half.rte ul.pdp-flavor-variant-selector__list {
        padding-left: 0;
        margin-left: 0;
      }

      .pdp-flavor-variant-selector {
        margin: 0 0 18px;
        width: 100%;
      }
      .pdp-flavor-variant-selector__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 14px 0px;
        justify-content: flex-start;
      }
      .pdp-flavor-variant-selector__link {
        all: unset;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        width: 92px;
        max-width: 100%;
        cursor: pointer;
        color: #234134;
        transition: transform 0.2s ease;
        background: transparent;
        border: 0;
        text-align: center;
      }
      .pdp-flavor-variant-selector__link:hover,
      .pdp-flavor-variant-selector__link:focus-visible {
        transform: translateY(-2px);
        outline: none;
      }
      .pdp-flavor-variant-selector__link:hover .pdp-flavor-variant-selector__thumb,
      .pdp-flavor-variant-selector__link:focus-visible .pdp-flavor-variant-selector__thumb {
        border-color: #234134;
        box-shadow: 0 0 0 2px #fff, 0 0 0 4px #234134;
      }
      .pdp-flavor-variant-selector__link--current {
        cursor: default;
      }
      .pdp-flavor-variant-selector__link--current:hover,
      .pdp-flavor-variant-selector__link--current:focus-visible {
        transform: none;
      }
      .pdp-flavor-variant-selector__thumb {
        display: block;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        overflow: hidden;
        flex-shrink: 0;
        border: 2px solid #23413433;
        background: #f5f5f0;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }
      .pdp-flavor-variant-selector__thumb--current {
        border-color: #234134;
        box-shadow: 0 0 0 2px #234134;
      }
      .pdp-flavor-variant-selector__link--current:hover .pdp-flavor-variant-selector__thumb,
      .pdp-flavor-variant-selector__link--current:focus-visible .pdp-flavor-variant-selector__thumb {
        box-shadow: 0 0 0 2px #234134;
      }
      .pdp-flavor-variant-selector__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .pdp-flavor-variant-selector__placeholder {
        display: block;
        width: 100%;
        height: 100%;
        background: linear-gradient(145deg, #e8efe4 0%, #d4e0cf 100%);
      }
      .pdp-flavor-variant-selector__caption {
        display: block;
        width: 100%;
        font-family: var(--bookmaniaFont, Georgia, serif);
        font-size: 12px;
        font-weight: 600;
        line-height: 1.25;
        text-align: center;
        word-break: break-word;
        hyphens: auto;
      }
      .pdp-flavor-variant-selector__link--current .pdp-flavor-variant-selector__caption {
        font-weight: 700;
      }
      @media (max-width: 1019px) {
        .pdp-flavor-variant-selector__list {
          justify-content: center;
        }
      }
      @media (max-width: 767px) {
        .pdp-flavor-variant-selector__heading {
          font-size: 16px;
        }
        .pdp-flavor-variant-selector__link {
          width: 80px;
        }
        .pdp-flavor-variant-selector__thumb {
          width: 56px;
          height: 56px;
        }
        .pdp-flavor-variant-selector__caption {
          font-size: 11px;
        }
      }
    </style>

    <script>
      (function () {
        function init(root) {
          if (!root || root.dataset.flavorVariantBound === 'true') return;
          root.dataset.flavorVariantBound = 'true';

          var variantSelect = document.querySelector('select[name="id"]');
          var buttons = root.querySelectorAll('.pdp-flavor-variant-selector__link');

          function setActive(variantId) {
            buttons.forEach(function (btn) {
              var isMatch = btn.getAttribute('data-variant-id') === String(variantId);
              btn.classList.toggle('pdp-flavor-variant-selector__link--current', isMatch);
              var thumb = btn.querySelector('.pdp-flavor-variant-selector__thumb');
              if (thumb) thumb.classList.toggle('pdp-flavor-variant-selector__thumb--current', isMatch);
              if (isMatch) {
                btn.setAttribute('aria-current', 'true');
              } else {
                btn.removeAttribute('aria-current');
              }
            });
          }

          buttons.forEach(function (btn) {
            btn.addEventListener('click', function () {
              var variantId = btn.getAttribute('data-variant-id');
              if (!variantId) return;
              setActive(variantId);

              if (variantSelect) {
                variantSelect.value = variantId;
                variantSelect.dispatchEvent(new Event('change', { bubbles: true }));
              }

              // Sync any plan-card / subscription-card UI that uses the same data-variant-id
              document
                .querySelectorAll('.plan-card[data-variant-id], .subscription-card[data-variant-id]')
                .forEach(function (card) {
                  card.classList.toggle('active', card.getAttribute('data-variant-id') === String(variantId));
                });
            });
          });

          // Keep selector in sync if variant changes from elsewhere (swatch-plans cards, query string, etc.)
          if (variantSelect) {
            variantSelect.addEventListener('change', function () {
              setActive(variantSelect.value);
            });
          }
        }

        function bootstrap() {
          document
            .querySelectorAll('.pdp-flavor-variant-selector-root')
            .forEach(init);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bootstrap);
        } else {
          bootstrap();
        }
      })();
    </script>
  {%- endif -%}
{%- endif -%}
