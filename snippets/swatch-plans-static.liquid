        position: relative;
        top: 1px;
      }

      .subscription-card {
        padding: 20px 12px 16px;
      }

      .subscription-card .plan-price {
        font-size: 18px;
      }

      .subscription-eyebrow {
        font-size: 11px;
        margin-bottom: 14px;
      }

      .plan-title--otp {
        font-size: 13px;
        margin-bottom: 10px;
      }

      .subscrition-name {
        line-height: 1;
