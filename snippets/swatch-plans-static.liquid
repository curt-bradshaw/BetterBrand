        0 0 0 2px #5a9a72,
        0 6px 24px rgba(35, 65, 52, 0.22);
      animation: subscription-glow 3s ease-in-out infinite;
    }

    @keyframes subscription-glow {
      0%, 100% {
        box-shadow:
          0 0 0 2px #5a9a72,
          0 6px 24px rgba(35, 65, 52, 0.18);
      }
      50% {
        box-shadow:
          0 0 0 3px #6db88a,
          0 8px 28px rgba(35, 65, 52, 0.28);
      }
    }

    @keyframes subscription-badge-pulse {
      0%, 100% {
        transform: translateX(-50%) scale(1);
        box-shadow: 0 2px 10px rgba(242, 203, 73, 0.45);
      }
      50% {
        transform: translateX(-50%) scale(1.04);
        box-shadow: 0 4px 14px rgba(242, 203, 73, 0.65);
      }
    }

    .subscription-top {
      display: flex;
      gap: 8px;
      margin-bottom: 6px;
    }

    .subscription-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 25px;
    }

    .subscription-best {
      font-family: var(--copyBodyFont);
      background: #f2cb49;
      color: #234134;
      font-size: 14px;
      font-weight: 700;
      padding: 6px 16px;
      border-radius: 35px;
      position: absolute;
      top: -15px;
      left: 50%;
      transform: translateX(-50%);
