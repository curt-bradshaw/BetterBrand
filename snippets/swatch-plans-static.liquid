{% assign current_variant = product.selected_or_first_available_variant %}

{% comment %} Custom Last Option Variant ID and Selling Plan ID {% endcomment %}
{% assign last_option_variant_id = product.metafields.pdp.variant_id_with_subscription %}
{% assign last_option_selling_plan_id = product.metafields.pdp.selling_plan_id_to_show_on_pdp %}
{% assign last_option_subtitle = product.metafields.pdp.pdp_last_option_subtitle %}
{% comment %} Boolean: true = hide all plan badges; false or unset = show (subject to per-card rules). {% endcomment %}
{% assign hide_plan_badge = product.metafields.pdp.hide_plan_badge.value | default: false %}

{% comment %}
  Detect a "Flavor" option and (if present) the first non-flavor option.

  Three rendering modes:
    1. is_flavor_product && has_other_option  → flavor pills + .plan-card stack for the other option (multi-option)
    2. is_flavor_product && no other option   → flavor pills + .plan-feature panel
    3. no flavor option                       → original .plan-card stack
{% endcomment %}
{% assign flavor_option_position = 0 %}
{% for opt in product.options %}
  {% assign opt_lc = opt | downcase %}
  {% if opt_lc == 'flavor' or opt_lc == 'flavour' %}
    {% assign flavor_option_position = forloop.index %}
    {% break %}
  {% endif %}
{% endfor %}
{% assign is_flavor_product = false %}
{% if flavor_option_position > 0 %}
  {% assign is_flavor_product = true %}
{% endif %}

{% assign other_option_position = 0 %}
{% if is_flavor_product %}
  {% for opt in product.options %}
    {% unless forloop.index == flavor_option_position %}
      {% assign other_option_position = forloop.index %}
      {% break %}
    {% endunless %}
  {% endfor %}
{% endif %}
{% assign has_other_option = false %}
{% if other_option_position > 0 %}
  {% assign has_other_option = true %}
{% endif %}

{% assign flavor_idx = flavor_option_position | minus: 1 %}
{% assign other_idx = other_option_position | minus: 1 %}

{% if is_flavor_product %}
  {% assign current_flavor = current_variant.options[flavor_idx] %}
{% endif %}

{% if last_option_variant_id and last_option_selling_plan_id %}
  {% assign last_option_variant = product.variants | where: 'id', last_option_variant_id | first %}
  {% for allocation in last_option_variant.selling_plan_allocations %}
    {% if allocation.selling_plan.id == last_option_selling_plan_id %}
      {% assign last_option_allocation_to_use = allocation %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if product.variants.size > 1 %}
  <div class="plan-wrapper" id="product-plan-selector">
    <!-- VARIANTS -->
    {% if is_flavor_product and has_other_option %}
    {% comment %}
      MULTI-OPTION: flavor pills on top, original .plan-card stack below for the non-flavor option.
      A JSON lookup map is emitted so JS can resolve (flavor + other) → variant on every interaction.
    {% endcomment %}
    <div class="plan-list plan-list--multi" data-active-variant-id="{{ current_variant.id }}" data-product-id="{{ product.id }}">
      <h3 class="plan-pills__title" id="plan-pills-title-{{ product.id }}-multi">Choose Your Flavor</h3>
      <div class="plan-pills" role="tablist" aria-labelledby="plan-pills-title-{{ product.id }}-multi">
        {%- assign flavor_values = product.options_with_values[flavor_idx].values -%}
        {% for fv in flavor_values %}
          {%- assign flavor_image_variant = nil -%}
          {% for v in product.variants %}
            {% if v.options[flavor_idx] == fv %}
              {%- assign flavor_image_variant = v -%}
              {% break %}
            {% endif %}
          {% endfor %}
          <label
            class="plan-pill plan-flavor-pill {% if fv == current_flavor %}active{% endif %}"
            data-flavor-value="{{ fv | escape }}"
            role="tab"
            aria-selected="{% if fv == current_flavor %}true{% else %}false{% endif %}"
            title="{{ fv | escape }}"
          >
            <input type="radio" hidden>
            <span class="plan-pill__thumb">
              {% if flavor_image_variant.image %}
                <img class="plan-pill__img" src="{{ flavor_image_variant.image | image_url: width: 160 }}" alt="" role="presentation" width="64" height="64" loading="lazy">
              {% elsif product.featured_image %}
                <img class="plan-pill__img" src="{{ product.featured_image | image_url: width: 160 }}" alt="" role="presentation" width="64" height="64" loading="lazy">
              {% else %}
                <span class="plan-pill__placeholder" aria-hidden="true"></span>
              {% endif %}
            </span>
            <span class="plan-pill__name">{{ fv }}</span>
          </label>
        {% endfor %}
      </div>

      <div class="plan-list__cards">
        {%- assign other_values = product.options_with_values[other_idx].values -%}
        {%- assign curr_idx = 1 -%}
        {% for ov in other_values %}
          {%- assign matching_variant = nil -%}
          {% for v in product.variants %}
            {% if v.options[flavor_idx] == current_flavor and v.options[other_idx] == ov %}
              {%- assign matching_variant = v -%}
              {% break %}
            {% endif %}
          {% endfor %}
          {% comment %} Fallback: render this size with any flavor so JS can swap it when flavor changes {% endcomment %}
          {% unless matching_variant %}
            {% for v in product.variants %}
              {% if v.options[other_idx] == ov and v.available %}
                {%- assign matching_variant = v -%}
                {% break %}
              {% endif %}
            {% endfor %}
          {% endunless %}

          {% if matching_variant and matching_variant.available %}
            {% unless matching_variant.metafields.pdp.hide_on_pdp %}
              {% case curr_idx %}
                {% when 2 %}
                  {% assign discount = 10 %}
                {% when 3 %}
                  {% assign discount = 15 %}
                {% else %}
                  {% assign discount = matching_variant.compare_at_price
                    | minus: matching_variant.price
                    | times: 100
                    | divided_by: matching_variant.compare_at_price
                  %}
              {% endcase %}
              {%- assign hide_this_badge = false -%}
              {%- if hide_plan_badge or curr_idx <= 1 -%}
                {%- assign hide_this_badge = true -%}
              {%- endif -%}

              {%- assign items_count = 0 -%}
              {%- assign show_each = false -%}
              {%- if matching_variant.metafields.pdp.amount_of_items -%}
                {%- assign items_count = matching_variant.metafields.pdp.amount_of_items | times: 1 -%}
                {%- assign show_each = true -%}
              {%- endif -%}

              <label
                class="plan-card plan-size-card {% if matching_variant.id == current_variant.id %}active{% endif %}"
                data-variant-id="{{ matching_variant.id }}"
                data-price="{{ matching_variant.price }}"
                data-size-value="{{ ov | escape }}"
                data-card-position="{{ curr_idx }}"
              >
                <input type="radio" hidden>

                <div class="plan-left" data-card-image-wrap>
                  {% if matching_variant.image %}
                    <img src="{{ matching_variant.image | image_url: width: 120 }}" alt="{{ matching_variant.title }}" width="120" height="120" loading="lazy">
                  {% elsif product.featured_image %}
                    <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ matching_variant.title }}" width="120" height="120" loading="lazy">
                  {% else %}
                    <div class="image-placeholder"></div>
                  {% endif %}
                </div>

                <div class="plan-center">
                  <span class="plan-name">
                    <strong>{{ ov }}</strong>
                  </span>
                </div>

                <div class="plan-right">
                  <div class="plan-price" data-card-price data-items="{{ items_count }}">
                    {% if show_each and items_count > 0 %}
                      {%- assign per_item_cents = matching_variant.price | divided_by: items_count -%}
                      {%- assign per_item_dollars = per_item_cents | divided_by: 100 -%}
                      {%- assign per_item_rem = per_item_cents | modulo: 100 -%}
                      ${{ per_item_dollars }}.{% if per_item_rem < 10 %}0{% endif %}{{ per_item_rem }}
                      <span>each</span>
                    {% else %}
                      {%- assign pd = matching_variant.price | divided_by: 100 -%}
                      {%- assign pc = matching_variant.price | modulo: 100 -%}
                      ${{ pd }}.{% if pc < 10 %}0{% endif %}{{ pc }}
                    {% endif %}
                  </div>
                  <div class="plan-badge {% if hide_this_badge %}hidden{% endif %}" data-card-badge>
                    <span><strong>SAVE {{ discount }}%</strong></span>
                  </div>
                </div>
              </label>
              {%- assign curr_idx = curr_idx | plus: 1 -%}
            {% endunless %}
          {% endif %}
        {% endfor %}
      </div>

      {% comment %} JSON lookup: (flavor|other) → variant data, for live JS resolution {% endcomment %}
      <script type="application/json" data-plan-variant-lookup>
        {
          {%- assign first_emit = true -%}
          {%- for v in product.variants -%}
            {%- unless v.available -%}{%- continue -%}{%- endunless -%}
            {%- assign fv_v = v.options[flavor_idx] -%}
            {%- assign ov_v = v.options[other_idx] -%}
            {%- assign items_v = v.metafields.pdp.amount_of_items | default: 0 -%}
            {%- assign img_url = '' -%}
            {%- if v.image -%}{%- assign img_url = v.image | image_url: width: 120 -%}{%- elsif product.featured_image -%}{%- assign img_url = product.featured_image | image_url: width: 120 -%}{%- endif -%}
            {%- assign key = fv_v | append: '|' | append: ov_v -%}
            {%- if first_emit -%}{%- assign first_emit = false -%}{%- else -%},{%- endif -%}
            {{ key | json }}: {
              "id": {{ v.id }},
              "price": {{ v.price }},
              "comparePrice": {{ v.compare_at_price | default: 0 }},
              "items": {{ items_v }},
              "image": {{ img_url | json }},
              "title": {{ v.title | json }}
            }
          {%- endfor -%}
        }
      </script>
    </div>
    {% elsif is_flavor_product %}
    <div class="plan-list plan-list--flavors" data-active-variant-id="{{ current_variant.id }}">
      <h3 class="plan-pills__title" id="plan-pills-title-{{ product.id }}-flavors">Choose Your Flavor</h3>
      <div class="plan-pills" role="tablist" aria-labelledby="plan-pills-title-{{ product.id }}-flavors">
        {% assign curr_idx = 1 %}
        {% for v in product.variants %}
          {% if v.metafields.pdp.hide_on_pdp %}
            {% continue %}
          {% endif %}
          {% if v.available %}
            {%- assign clean_name = v.title -%}
            {% if v.title contains '(' %}
              {% assign clean_name = v.title | split: '(' | first | strip %}
            {% endif %}

            {% case curr_idx %}
              {% when 2 %}
                {% assign discount = 10 %}
              {% when 3 %}
                {% assign discount = 15 %}
              {% else %}
                {% assign discount = v.compare_at_price
                  | minus: v.price
                  | times: 100
                  | divided_by: v.compare_at_price
                %}
            {% endcase %}
            {%- assign hide_this_badge = false -%}
            {%- if hide_plan_badge or curr_idx <= 1 -%}
              {%- assign hide_this_badge = true -%}
            {%- endif -%}

            <label
              class="plan-card plan-pill {% if v.id == current_variant.id %}active{% endif %}"
              data-variant-id="{{ v.id }}"
              data-price="{{ v.price }}"
              role="tab"
              aria-selected="{% if v.id == current_variant.id %}true{% else %}false{% endif %}"
              title="{{ v.title | escape }}"
            >
              <input type="radio" hidden>
              <span class="plan-pill__thumb">
                {% if v.image %}
                  <img
                    class="plan-pill__img"
                    src="{{ v.image | image_url: width: 160 }}"
                    alt=""
                    role="presentation"
                    width="64"
                    height="64"
                    loading="lazy"
                  >
                {% elsif product.featured_image %}
                  <img
                    class="plan-pill__img"
                    src="{{ product.featured_image | image_url: width: 160 }}"
                    alt=""
                    role="presentation"
                    width="64"
                    height="64"
                    loading="lazy"
                  >
                {% else %}
                  <span class="plan-pill__placeholder" aria-hidden="true"></span>
                {% endif %}
              </span>
              <span class="plan-pill__name">{{ clean_name }}</span>
            </label>
          {% endif %}
          {% assign curr_idx = curr_idx | plus: 1 %}
        {% endfor %}
      </div>

      <div class="plan-feature-stack">
        {% assign curr_idx = 1 %}
        {% for v in product.variants %}
          {% if v.metafields.pdp.hide_on_pdp %}
            {% continue %}
          {% endif %}
          {% if v.available %}
            {% case curr_idx %}
              {% when 2 %}
                {% assign discount = 10 %}
              {% when 3 %}
                {% assign discount = 15 %}
              {% else %}
                {% assign discount = v.compare_at_price
                  | minus: v.price
                  | times: 100
                  | divided_by: v.compare_at_price
                %}
            {% endcase %}
            {%- assign hide_this_badge = false -%}
            {%- if hide_plan_badge or curr_idx <= 1 -%}
              {%- assign hide_this_badge = true -%}
            {%- endif -%}

            {%- assign items_count = 0 -%}
            {%- assign show_each = false -%}
            {%- if v.metafields.pdp.amount_of_items -%}
              {%- assign items_count = v.metafields.pdp.amount_of_items | times: 1 -%}
              {%- assign show_each = true -%}
            {%- endif -%}

            {%- assign total_dollars = v.price | divided_by: 100 -%}
            {%- assign total_cents = v.price | modulo: 100 -%}

            <div
              class="plan-feature {% if v.id == current_variant.id %}is-active{% endif %}"
              data-variant-id="{{ v.id }}"
              role="tabpanel"
            >
              <div class="plan-left">
                {% if v.image %}
                  <img src="{{ v.image | image_url: width: 120 }}" alt="{{ v.title }}" width="120" height="120" loading="lazy">
                {% elsif product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ v.title }}" width="120" height="120" loading="lazy">
                {% else %}
                  <div class="image-placeholder"></div>
                {% endif %}
              </div>

              <div class="plan-center">
                <span class="plan-name">
                  {% if v.title contains '(' %}
                    {% assign title_parts = v.title | split: '(' %}
                    <strong>{{ title_parts[0] | strip }}</strong>
                    {% if title_parts.size > 1 %}
                      {% assign title_inside = title_parts[1] | split: ')' | first | strip %}
                      <span>(<strong>{{ title_inside }}</strong>)</span>
                    {% endif %}
                  {% else %}
                    <strong>{{ v.title }}</strong>
                  {% endif %}
                </span>
              </div>

              <div class="plan-right">
                <div class="plan-price">
                  {% if show_each and items_count > 0 %}
                    {%- assign per_item_cents = v.price | divided_by: items_count -%}
                    {%- assign per_item_dollars = per_item_cents | divided_by: 100 -%}
                    {%- assign per_item_rem = per_item_cents | modulo: 100 -%}
                    ${{ per_item_dollars }}.{% if per_item_rem < 10 %}0{% endif %}{{ per_item_rem }}
                    <span>each</span>
                  {% else %}
                    ${{ total_dollars }}.{% if total_cents < 10 %}0{% endif %}{{ total_cents }}
                  {% endif %}
                </div>
                <div class="plan-badge {% if hide_this_badge %}hidden{% endif %}">
                  <span><strong>SAVE {{ discount }}%</strong></span>
                </div>
              </div>
            </div>
          {% endif %}
          {% assign curr_idx = curr_idx | plus: 1 %}
        {% endfor %}
      </div>
    </div>
    {% else %}
    {% comment %} Original .plan-card stack for non-flavor products {% endcomment %}
    <div class="plan-list">
      {% assign curr_idx = 1 %}
      {% for v in product.variants %}
        {% if v.metafields.pdp.hide_on_pdp %}
          {% continue %}
        {% endif %}
        {% if v.available %}
          <label
            class="plan-card {% if v.id == current_variant.id %}active{% endif %}"
            data-variant-id="{{ v.id }}"
            data-price="{{ v.price }}"
          >
            <input type="radio" hidden>

              <div class="plan-left">
                {% if v.image %}
                  <img src="{{ v.image | image_url: width: 120 }}" alt="{{ v.title }}" width="120" height="120" loading="lazy">
                {% elsif product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ v.title }}" width="120" height="120" loading="lazy">
                {% else %}
                  <div class="image-placeholder"></div>
                {% endif %}
              </div>

            <div class="plan-center">
              <span class="plan-name">
                {% if v.title contains '(' %}
                  {% assign title_parts = v.title | split: '(' %}
                  <strong>{{ title_parts[0] | strip }}</strong>
                  {% if title_parts.size > 1 %}
                    {% assign title_inside = title_parts[1] | split: ')' | first | strip %}
                    <span>(<strong>{{ title_inside }}</strong>)</span>
                  {% endif %}
                {% else %}
                  <strong>{{ v.title }}</strong>
                {% endif %}
              </span>
            </div>

            <div class="plan-right">
              <div class="plan-price">
                {% assign variant_title_lower = v.title | downcase %}
                {% assign items_count = 0 %}
                {% assign show_each = false %}

                {% if v.metafields.pdp.amount_of_items %}
                  {% assign items_count = v.metafields.pdp.amount_of_items | times: 1 %}
                  {% assign show_each = true %}
                {% endif %}

                {% if show_each and items_count > 0 %}
                  {% assign total_price_cents = v.price %}
                  {% assign price_per_item_cents = total_price_cents | divided_by: items_count %}
                  {% assign price_per_item_dollars = price_per_item_cents | divided_by: 100 %}
                  {% assign cents_remainder = price_per_item_cents | modulo: 100 %}
                  ${{ price_per_item_dollars }}.{% if cents_remainder < 10 %}0{% endif %}{{ cents_remainder }}
                  <span>each</span>
                {% else %}
                  {% assign price_dollars = v.price | divided_by: 100 %}
                  {% assign price_cents = v.price | modulo: 100 %}
                  ${{ price_dollars }}.{% if price_cents < 10 %}0{% endif %}{{ price_cents }}
                {% endif %}
              </div>
              {% case curr_idx %}
                {% when 2 %}
                  {% assign discount = 10 %}
                {% when 3 %}
                  {% assign discount = 15 %}
                {% else %}
                  {% assign discount = v.compare_at_price
                    | minus: v.price
                    | times: 100
                    | divided_by: v.compare_at_price
                  %}
              {% endcase %}
              {%- assign hide_this_badge = false -%}
              {%- if hide_plan_badge or curr_idx <= 1 -%}
                {%- assign hide_this_badge = true -%}
              {%- endif -%}
              <div class="plan-badge {% if hide_this_badge %}hidden{% endif %}">
                <span><strong>SAVE {{ discount }}%</strong></span>
              </div>
            </div>
          </label>
        {% endif %}
        {% assign curr_idx = curr_idx | plus: 1 %}
      {% endfor %}
    </div>
    {% endif %}

    <!-- SELECT REAL SHOPIFY -->
  </div>


  {% if last_option_variant and last_option_allocation_to_use and last_option_subtitle %}

    <div class="subscription-wrapper" id="subscription-options">
      <div class="subscription-group" data-variant-id="{{ last_option_variant.id }}">
        <label
          class="subscription-card"
          data-price="{{ last_option_allocation_to_use.price }}"
          data-selling-plan-id="{{ last_option_allocation_to_use.selling_plan.id }}"
          data-variant-id="{{ last_option_variant.id }}"
        >
          <input type="radio" hidden value="{{ last_option_variant.id }}">
          <span class="subscription-best"><strong>Best Value</strong></span>
          <div class="content">
            <p class="subscrition-name">
              <span class="subscription-title">
                <strong>Subscribe & Save</strong>
              </span>
              <br>
              <span class="subscription-frequency">
                <strong>{{ last_option_subtitle }}</strong>
              </span>
            </p>
            <div class="plan-right">
              <div class="plan-badge{% if hide_plan_badge %} hidden{% endif %}">
                <span><strong>SAVE 20%</strong></span>
              </div>
              <div class="plan-price">
                {% assign show_each = false %}
                {% if last_option_variant.metafields.pdp.amount_of_items %}
                  {% assign items_count = last_option_variant.metafields.pdp.amount_of_items | times: 1 %}
                  {% assign show_each = true %}
                {% endif %}
                
                {% if show_each and items_count > 0 %}
                {% assign items_count = last_option_variant.metafields.pdp.amount_of_items | times: 1 %}
                {% assign total_price_cents = last_option_allocation_to_use.price %}
                {% assign price_per_item_cents = total_price_cents | divided_by: items_count %}
                {% assign price_per_item_dollars = price_per_item_cents | divided_by: 100 %}
                {% assign cents_remainder = price_per_item_cents | modulo: 100 %}
                ${{ price_per_item_dollars }}.{% if cents_remainder < 10 %}0{% endif %}{{ cents_remainder }}
                <span>each</span>
                {% else %}
                  {% assign price_dollars = last_option_allocation_to_use.price | divided_by: 100 %}
                  {% assign price_cents = last_option_allocation_to_use.price | modulo: 100 %}
                  ${{ price_dollars }}.{% if price_cents < 10 %}0{% endif %}{{ price_cents }}
                {% endif %}
              </div>
            </div>
          </div>
          
          <div class="subscription-note">
            <span><strong>FREE</strong> Shipping</span>
            <span>Change, Pause or Cancel Anytime</span>
          </div>
        </label>
      </div>
    </div>

    <input type="hidden" name="selling_plan" id="product-selling-plan">
  {% endif %}
{% endif %}

<select
  id="all-product-variants"
  name="id"
  class="product-variant all-variant hide"
  data-productid="{{ product.id }}"
>
  {% for v in product.variants %}
    {% if v.available %}
      <option
        value="{{ v.id }}"
        {% if v.id == current_variant.id %}
          selected
        {% endif %}
        data-available="{{ v.available }}"
        data-options="{{ v.options | join: ',' | escape }}"
        data-sku="{{ v.sku }}"
        data-price="{{ v.price }}"
        data-compare-at-price="{{ v.compare_at_price }}"
        data-variant-inventory="{{ v.inventory_management }}"
        data-inventory-policy="{{ v.inventory_policy }}"
        data-inventory="{% if v.inventory_policy == 'continue' or v.inventory_management == blank %}-1{% else %}{{ v.inventory_quantity }}{% endif %}"
        data-image="{{ v.image.src | split: '?' | first }}"
        data-image-position="{{ v.featured_media.position | default: 0 }}"
        data-items-count="{{ v.metafields.pdp.amount_of_items }}"
      >
        {{ v.title }}
      </option>
    {% endif %}
  {% endfor %}
</select>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const variantCards = document.querySelectorAll('.plan-card,.subscription-card');
    const variantSelect = document.querySelector('select[name="id"]');
    const subscriptionGroups = document.querySelectorAll('.subscription-group');
    const sellingPlanInput = document.querySelector('input[name="selling_plan"]');
    const productForm = variantSelect?.closest('form');

    if (!variantSelect || !productForm) return;

    // Initial check: show quantity only for 1-pack or 1 bottle variants
    function checkAndShowQuantity() {
      const productQuantity = document.querySelector('.product-quantity');
      if (variantCards.length > 1) {
        productQuantity.style.display = 'none';
      }
    }

    // Run initial check
    checkAndShowQuantity();

    /* ===============================
       HELPER FUNCTIONS
    =============================== */
    function syncPlanFeature(variantId) {
      const list = document.querySelector('.plan-list');
      if (!list) return;
      list.dataset.activeVariantId = variantId;
      const panels = list.querySelectorAll('.plan-feature');
      panels.forEach((panel) => {
        if (panel.dataset.variantId === String(variantId)) {
          panel.classList.add('is-active');
        } else {
          panel.classList.remove('is-active');
        }
      });
    }

    function formatMoney(cents) {
      const amount = (parseInt(cents) / 100).toFixed(2);
      // Simple USD format - adjust if needed for other currencies
      return `$${amount}`;
    }

    function formatMoneyWithoutCurrency(cents) {
      return (parseInt(cents) / 100).toFixed(2);
    }

    function updatePriceDisplay(priceInCents) {
      const formattedPrice = formatMoney(priceInCents);
      const priceWithoutCurrency = formatMoneyWithoutCurrency(priceInCents);

      // Update .btn-money in ATC button
      const btnMoney = document.querySelector('.btn-add-tocart .btn-money');
      if (btnMoney) {
        btnMoney.textContent = formattedPrice;
      }

      // Update .current-price (standard layout)
      const currentPrice = document.querySelector('.current-price.price');
      if (currentPrice) {
        currentPrice.textContent = formattedPrice;
      } 

      // Update .new-product-price-value (new layout - without currency symbol)
      const newPriceValue = document.querySelector('.new-product-price-value.jq-new-price');
      if (newPriceValue) {
        newPriceValue.textContent = priceWithoutCurrency;
      }

      // Update data-product-price attribute for consistency
      const priceContainer = document.querySelector('#product-price');
      if (priceContainer) {
        priceContainer.dataset.productPrice = priceInCents;
      }

      // Also update recharger-price class elements
      const rechargerPrices = document.querySelectorAll('.recharger-price');
      rechargerPrices.forEach((el) => {
        if (el.classList.contains('new-product-price-value')) {
          el.textContent = priceWithoutCurrency;
        } else {
          el.textContent = formattedPrice;
        }
      });
    }

    /* ===============================
       VARIANT CLICK
    =============================== */
    variantCards.forEach((card) => {
      card.addEventListener('click', () => {
        console.log('card clicked');
        const variantId = card.dataset.variantId;
        const variantPrice = card.dataset.price;
        const sellingPlanId = card.dataset.sellingPlanId;

        // Update real variant select
        variantSelect.value = variantId;
        variantSelect.dispatchEvent(new Event('change', { bubbles: true }));

        // Update UI
        variantCards.forEach((c) => c.classList.remove('active'));
        card.classList.add('active');

        // Sync expanded feature panel for the new pill UI
        syncPlanFeature(variantId);

        // Remove selling plan and active subscription
        if (sellingPlanId) {
          sellingPlanInput.value = sellingPlanId;
          sellingPlanInput.dispatchEvent(new Event('change', { bubbles: true }));
        } else {
          sellingPlanInput.value = '';
          sellingPlanInput.dispatchEvent(new Event('change', { bubbles: true }));
        }

        // Show quantity only for 1-pack or 1 bottle variants
        const selectedVariantOption = variantSelect.querySelector(`option[value="${variantId}"]`);
        const variantTitle = selectedVariantOption ? selectedVariantOption.textContent : '';
        // const is1Pack = is1PackOr1Bottle(variantTitle);
        
        const productQuantity = document.querySelector('.product-quantity');
        if (productQuantity) {
          productQuantity.style.display = 'none';
        }

        // Update price to selected variant price
        if (variantPrice) {
          updatePriceDisplay(variantPrice);
        }

        // Force theme to recalculate everything
        productForm.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });

    /* ===============================
       MULTI-OPTION FLAVOR PILLS
       Resolves (flavor + other) -> variant via inline JSON lookup,
       then re-syncs the .plan-size-card row (data-variant-id, price, image)
       and finally simulates a click on the active size card so the existing
       variant-change pipeline above fires for the resolved variant.
    =============================== */
    const multiList = document.querySelector('.plan-list--multi');
    if (multiList) {
      const lookupEl = multiList.querySelector('script[data-plan-variant-lookup]');
      let lookup = {};
      try {
        lookup = lookupEl ? JSON.parse(lookupEl.textContent) : {};
      } catch (err) {
        console.warn('plan-variant-lookup parse failed', err);
      }

      const flavorPills = multiList.querySelectorAll('.plan-flavor-pill');
      const sizeCards = multiList.querySelectorAll('.plan-size-card');
      let currentFlavor = (multiList.querySelector('.plan-flavor-pill.active') || flavorPills[0])?.dataset.flavorValue;

      function renderPriceHTML(cents, items) {
        const c = parseInt(cents, 10);
        if (items > 0) {
          const perItem = Math.floor(c / items);
          const d = Math.floor(perItem / 100);
          const r = perItem % 100;
          return `$${d}.${r < 10 ? '0' : ''}${r} <span>each</span>`;
        }
        const d = Math.floor(c / 100);
        const r = c % 100;
        return `$${d}.${r < 10 ? '0' : ''}${r}`;
      }

      function resyncSizeCards(flavorValue) {
        sizeCards.forEach((card) => {
          const sizeValue = card.dataset.sizeValue;
          const data = lookup[`${flavorValue}|${sizeValue}`];
          if (!data) {
            card.hidden = true;
            return;
          }
          card.hidden = false;

          card.dataset.variantId = data.id;
          card.dataset.price = data.price;

          const img = card.querySelector('[data-card-image-wrap] img');
          if (img && data.image) {
            img.src = data.image;
            img.alt = data.title || '';
          }

          const priceEl = card.querySelector('[data-card-price]');
          if (priceEl) {
            const items = parseInt(priceEl.dataset.items || '0', 10);
            priceEl.innerHTML = renderPriceHTML(data.price, items);
          }
        });
      }

      function activateFlavor(flavorValue) {
        if (!flavorValue || flavorValue === currentFlavor) {
          flavorPills.forEach((p) => {
            const isActive = p.dataset.flavorValue === flavorValue;
            p.classList.toggle('active', isActive);
            p.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });
          return;
        }
        currentFlavor = flavorValue;

        flavorPills.forEach((p) => {
          const isActive = p.dataset.flavorValue === flavorValue;
          p.classList.toggle('active', isActive);
          p.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        resyncSizeCards(flavorValue);

        // Trigger variant change via the currently active size card (or first visible one).
        let activeCard = multiList.querySelector('.plan-size-card.active');
        if (!activeCard || activeCard.hidden) {
          activeCard = Array.from(sizeCards).find((c) => !c.hidden) || null;
        }
        if (activeCard) {
          activeCard.click();
        }
      }

      flavorPills.forEach((pill) => {
        pill.addEventListener('click', (e) => {
          e.preventDefault();
          activateFlavor(pill.dataset.flavorValue);
        });
      });
    }
  });
</script>

