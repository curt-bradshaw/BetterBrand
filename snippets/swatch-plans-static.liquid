{% assign current_variant = product.selected_or_first_available_variant %}

{% comment %} Custom Last Option Variant ID and Selling Plan ID {% endcomment %}
{% assign last_option_variant_id = product.metafields.pdp.variant_id_with_subscription %}
{% assign last_option_selling_plan_id = product.metafields.pdp.selling_plan_id_to_show_on_pdp %}
{% assign last_option_subtitle = product.metafields.pdp.pdp_last_option_subtitle %}
{% comment %} Boolean: true = hide all plan badges; false or unset = show (subject to per-card rules). {% endcomment %}
{% assign hide_plan_badge = product.metafields.pdp.hide_plan_badge.value | default: false %}

{% if last_option_variant_id and last_option_selling_plan_id %}
  {% assign last_option_variant = product.variants | where: 'id', last_option_variant_id | first %}
  {% for allocation in last_option_variant.selling_plan_allocations %}
    {% if allocation.selling_plan.id == last_option_selling_plan_id %}
      {% assign last_option_allocation_to_use = allocation %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if product.variants.size > 1 %}
  <div class="plan-wrapper" id="product-plan-selector">
    <!-- VARIANTS -->
    <div class="plan-list" data-active-variant-id="{{ current_variant.id }}">
      <div class="plan-pills" role="tablist" aria-label="Choose your pack">
        {% assign curr_idx = 1 %}
        {% for v in product.variants %}
          {% if v.metafields.pdp.hide_on_pdp %}
            {% continue %}
          {% endif %}
          {% if v.available %}
            {%- assign clean_name = v.title -%}
            {% if v.title contains '(' %}
              {% assign clean_name = v.title | split: '(' | first | strip %}
            {% endif %}

            {% case curr_idx %}
              {% when 2 %}
                {% assign discount = 10 %}
              {% when 3 %}
                {% assign discount = 15 %}
              {% else %}
                {% assign discount = v.compare_at_price
                  | minus: v.price
                  | times: 100
                  | divided_by: v.compare_at_price
                %}
            {% endcase %}
            {%- assign hide_this_badge = false -%}
            {%- if hide_plan_badge or curr_idx <= 1 -%}
              {%- assign hide_this_badge = true -%}
            {%- endif -%}

            {%- assign pill_price_dollars = v.price | divided_by: 100 -%}
            {%- assign pill_price_cents = v.price | modulo: 100 -%}

            <label
              class="plan-card plan-pill {% if v.id == current_variant.id %}active{% endif %}"
              data-variant-id="{{ v.id }}"
              data-price="{{ v.price }}"
              role="tab"
              aria-selected="{% if v.id == current_variant.id %}true{% else %}false{% endif %}"
            >
              <input type="radio" hidden>
              <span class="plan-pill__name">{{ clean_name }}</span>
              <span class="plan-pill__sub">${{ pill_price_dollars }}.{% if pill_price_cents < 10 %}0{% endif %}{{ pill_price_cents }}</span>
              {%- unless hide_this_badge -%}
                <span class="plan-pill__save">−{{ discount }}%</span>
              {%- endunless -%}
            </label>
          {% endif %}
          {% assign curr_idx = curr_idx | plus: 1 %}
        {% endfor %}
      </div>

      <div class="plan-feature-stack">
        {% assign curr_idx = 1 %}
        {% for v in product.variants %}
          {% if v.metafields.pdp.hide_on_pdp %}
            {% continue %}
          {% endif %}
          {% if v.available %}
            {% case curr_idx %}
              {% when 2 %}
                {% assign discount = 10 %}
              {% when 3 %}
                {% assign discount = 15 %}
              {% else %}
                {% assign discount = v.compare_at_price
                  | minus: v.price
                  | times: 100
                  | divided_by: v.compare_at_price
                %}
            {% endcase %}
            {%- assign hide_this_badge = false -%}
            {%- if hide_plan_badge or curr_idx <= 1 -%}
              {%- assign hide_this_badge = true -%}
            {%- endif -%}

            {%- assign items_count = 0 -%}
            {%- assign show_each = false -%}
            {%- if v.metafields.pdp.amount_of_items -%}
              {%- assign items_count = v.metafields.pdp.amount_of_items | times: 1 -%}
              {%- assign show_each = true -%}
            {%- endif -%}

            {%- assign total_dollars = v.price | divided_by: 100 -%}
            {%- assign total_cents = v.price | modulo: 100 -%}

            <div
              class="plan-feature {% if v.id == current_variant.id %}is-active{% endif %}"
              data-variant-id="{{ v.id }}"
              role="tabpanel"
            >
              <div class="plan-feature__image-wrap">
                {% if v.image %}
                  <img class="plan-feature__image" src="{{ v.image | image_url: width: 240 }}" alt="{{ v.title }}" width="240" height="240" loading="lazy">
                {% elsif product.featured_image %}
                  <img class="plan-feature__image" src="{{ product.featured_image | image_url: width: 240 }}" alt="{{ v.title }}" width="240" height="240" loading="lazy">
                {% else %}
                  <div class="plan-feature__image plan-feature__image--placeholder"></div>
                {% endif %}
              </div>

              <div class="plan-feature__body">
                <div class="plan-feature__name">
                  {% if v.title contains '(' %}
                    {% assign title_parts = v.title | split: '(' %}
                    <strong>{{ title_parts[0] | strip }}</strong>
                    {% if title_parts.size > 1 %}
                      {% assign title_inside = title_parts[1] | split: ')' | first | strip %}
                      <span class="plan-feature__name-sub">({{ title_inside }})</span>
                    {% endif %}
                  {% else %}
                    <strong>{{ v.title }}</strong>
                  {% endif %}
                </div>

                <div class="plan-feature__price-row">
                  <div class="plan-feature__total">
                    <span class="plan-feature__total-value">${{ total_dollars }}.{% if total_cents < 10 %}0{% endif %}{{ total_cents }}</span>
                    <span class="plan-feature__total-label">total</span>
                  </div>

                  {% if show_each and items_count > 0 %}
                    {%- assign per_item_cents = v.price | divided_by: items_count -%}
                    {%- assign per_item_dollars = per_item_cents | divided_by: 100 -%}
                    {%- assign per_item_rem = per_item_cents | modulo: 100 -%}
                    <div class="plan-feature__per-item">
                      <span>${{ per_item_dollars }}.{% if per_item_rem < 10 %}0{% endif %}{{ per_item_rem }}</span> each
                    </div>
                  {% endif %}
                </div>

                {%- unless hide_this_badge -%}
                  <div class="plan-feature__savings">
                    <strong>SAVE {{ discount }}%</strong>
                    {% if v.compare_at_price > v.price %}
                      {%- assign cmp_dollars = v.compare_at_price | divided_by: 100 -%}
                      {%- assign cmp_cents = v.compare_at_price | modulo: 100 -%}
                      <span class="plan-feature__compare">${{ cmp_dollars }}.{% if cmp_cents < 10 %}0{% endif %}{{ cmp_cents }}</span>
                    {% endif %}
                  </div>
                {%- endunless -%}
              </div>
            </div>
          {% endif %}
          {% assign curr_idx = curr_idx | plus: 1 %}
        {% endfor %}
      </div>
    </div>

    <!-- SELECT REAL SHOPIFY -->
  </div>


  {% if last_option_variant and last_option_allocation_to_use and last_option_subtitle %}

    <div class="subscription-wrapper" id="subscription-options">
      <div class="subscription-group" data-variant-id="{{ last_option_variant.id }}">
        <label
          class="subscription-card"
          data-price="{{ last_option_allocation_to_use.price }}"
          data-selling-plan-id="{{ last_option_allocation_to_use.selling_plan.id }}"
          data-variant-id="{{ last_option_variant.id }}"
        >
          <input type="radio" hidden value="{{ last_option_variant.id }}">
          <span class="subscription-best"><strong>Best Value</strong></span>
          <div class="content">
            <p class="subscrition-name">
              <span class="subscription-title">
                <strong>Subscribe & Save</strong>
              </span>
              <br>
              <span class="subscription-frequency">
                <strong>{{ last_option_subtitle }}</strong>
              </span>
            </p>
            <div class="plan-right">
              <div class="plan-badge{% if hide_plan_badge %} hidden{% endif %}">
                <span><strong>SAVE 20%</strong></span>
              </div>
              <div class="plan-price">
                {% assign show_each = false %}
                {% if last_option_variant.metafields.pdp.amount_of_items %}
                  {% assign items_count = last_option_variant.metafields.pdp.amount_of_items | times: 1 %}
                  {% assign show_each = true %}
                {% endif %}
                
                {% if show_each and items_count > 0 %}
                {% assign items_count = last_option_variant.metafields.pdp.amount_of_items | times: 1 %}
                {% assign total_price_cents = last_option_allocation_to_use.price %}
                {% assign price_per_item_cents = total_price_cents | divided_by: items_count %}
                {% assign price_per_item_dollars = price_per_item_cents | divided_by: 100 %}
                {% assign cents_remainder = price_per_item_cents | modulo: 100 %}
                ${{ price_per_item_dollars }}.{% if cents_remainder < 10 %}0{% endif %}{{ cents_remainder }}
                <span>each</span>
                {% else %}
                  {% assign price_dollars = last_option_allocation_to_use.price | divided_by: 100 %}
                  {% assign price_cents = last_option_allocation_to_use.price | modulo: 100 %}
                  ${{ price_dollars }}.{% if price_cents < 10 %}0{% endif %}{{ price_cents }}
                {% endif %}
              </div>
            </div>
          </div>
          
          <div class="subscription-note">
            <span><strong>FREE</strong> Shipping</span>
            <span>Change, Pause or Cancel Anytime</span>
          </div>
        </label>
      </div>
    </div>

    <input type="hidden" name="selling_plan" id="product-selling-plan">
  {% endif %}
{% endif %}

<select
  id="all-product-variants"
  name="id"
  class="product-variant all-variant hide"
  data-productid="{{ product.id }}"
>
  {% for v in product.variants %}
    {% if v.available %}
      <option
        value="{{ v.id }}"
        {% if v.id == current_variant.id %}
          selected
        {% endif %}
        data-available="{{ v.available }}"
        data-options="{{ v.options | join: ',' | escape }}"
        data-sku="{{ v.sku }}"
        data-price="{{ v.price }}"
        data-compare-at-price="{{ v.compare_at_price }}"
        data-variant-inventory="{{ v.inventory_management }}"
        data-inventory-policy="{{ v.inventory_policy }}"
        data-inventory="{% if v.inventory_policy == 'continue' or v.inventory_management == blank %}-1{% else %}{{ v.inventory_quantity }}{% endif %}"
        data-image="{{ v.image.src | split: '?' | first }}"
        data-image-position="{{ v.featured_media.position | default: 0 }}"
        data-items-count="{{ v.metafields.pdp.amount_of_items }}"
      >
        {{ v.title }}
      </option>
    {% endif %}
  {% endfor %}
</select>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const variantCards = document.querySelectorAll('.plan-card,.subscription-card');
    const variantSelect = document.querySelector('select[name="id"]');
    const subscriptionGroups = document.querySelectorAll('.subscription-group');
    const sellingPlanInput = document.querySelector('input[name="selling_plan"]');
    const productForm = variantSelect?.closest('form');

    if (!variantSelect || !productForm) return;

    // Initial check: show quantity only for 1-pack or 1 bottle variants
    function checkAndShowQuantity() {
      const productQuantity = document.querySelector('.product-quantity');
      if (variantCards.length > 1) {
        productQuantity.style.display = 'none';
      }
    }

    // Run initial check
    checkAndShowQuantity();

    /* ===============================
       HELPER FUNCTIONS
    =============================== */
    function syncPlanFeature(variantId) {
      const list = document.querySelector('.plan-list');
      if (!list) return;
      list.dataset.activeVariantId = variantId;
      const panels = list.querySelectorAll('.plan-feature');
      panels.forEach((panel) => {
        if (panel.dataset.variantId === String(variantId)) {
          panel.classList.add('is-active');
        } else {
          panel.classList.remove('is-active');
        }
      });
    }

    function formatMoney(cents) {
      const amount = (parseInt(cents) / 100).toFixed(2);
      // Simple USD format - adjust if needed for other currencies
      return `$${amount}`;
    }

    function formatMoneyWithoutCurrency(cents) {
      return (parseInt(cents) / 100).toFixed(2);
    }

    function updatePriceDisplay(priceInCents) {
      const formattedPrice = formatMoney(priceInCents);
      const priceWithoutCurrency = formatMoneyWithoutCurrency(priceInCents);

      // Update .btn-money in ATC button
      const btnMoney = document.querySelector('.btn-add-tocart .btn-money');
      if (btnMoney) {
        btnMoney.textContent = formattedPrice;
      }

      // Update .current-price (standard layout)
      const currentPrice = document.querySelector('.current-price.price');
      if (currentPrice) {
        currentPrice.textContent = formattedPrice;
      } 

      // Update .new-product-price-value (new layout - without currency symbol)
      const newPriceValue = document.querySelector('.new-product-price-value.jq-new-price');
      if (newPriceValue) {
        newPriceValue.textContent = priceWithoutCurrency;
      }

      // Update data-product-price attribute for consistency
      const priceContainer = document.querySelector('#product-price');
      if (priceContainer) {
        priceContainer.dataset.productPrice = priceInCents;
      }

      // Also update recharger-price class elements
      const rechargerPrices = document.querySelectorAll('.recharger-price');
      rechargerPrices.forEach((el) => {
        if (el.classList.contains('new-product-price-value')) {
          el.textContent = priceWithoutCurrency;
        } else {
          el.textContent = formattedPrice;
        }
      });
    }

    /* ===============================
       VARIANT CLICK
    =============================== */
    variantCards.forEach((card) => {
      card.addEventListener('click', () => {
        console.log('card clicked');
        const variantId = card.dataset.variantId;
        const variantPrice = card.dataset.price;
        const sellingPlanId = card.dataset.sellingPlanId;

        // Update real variant select
        variantSelect.value = variantId;
        variantSelect.dispatchEvent(new Event('change', { bubbles: true }));

        // Update UI
        variantCards.forEach((c) => c.classList.remove('active'));
        card.classList.add('active');

        // Sync expanded feature panel for the new pill UI
        syncPlanFeature(variantId);

        // Remove selling plan and active subscription
        if (sellingPlanId) {
          sellingPlanInput.value = sellingPlanId;
          sellingPlanInput.dispatchEvent(new Event('change', { bubbles: true }));
        } else {
          sellingPlanInput.value = '';
          sellingPlanInput.dispatchEvent(new Event('change', { bubbles: true }));
        }

        // Show quantity only for 1-pack or 1 bottle variants
        const selectedVariantOption = variantSelect.querySelector(`option[value="${variantId}"]`);
        const variantTitle = selectedVariantOption ? selectedVariantOption.textContent : '';
        // const is1Pack = is1PackOr1Bottle(variantTitle);
        
        const productQuantity = document.querySelector('.product-quantity');
        if (productQuantity) {
          productQuantity.style.display = 'none';
        }

        // Update price to selected variant price
        if (variantPrice) {
          updatePriceDisplay(variantPrice);
        }

        // Force theme to recalculate everything
        productForm.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });
  });
</script>

<style>
    .subscription-wrapper {
      margin-bottom: 30px;
    }

    .plan-wrapper {
      width: 100%;
    }

    .plan-wrapper *,
    .subscription-wrapper * {
      font-family: var(--bookmaniaFont);
    }

    .plan-title {
      font-size: 20px;
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 0px;
      font-family: var(--bookmaniaFont);
      color: #234134;
      margin-top: 25px;
    }
    .plan-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 23px;
    }

    .plan-badge.hidden {
      display: none;
    }

    .content {
      display: flex;
      justify-content: space-between;
    }

    /* ===== NEW PILL TAB ROW (variants) ===== */
    .plan-pills {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      gap: 6px;
      background: #f3f1e8;
      padding: 6px;
      border-radius: 999px;
      border: 1px solid rgba(35, 65, 52, 0.12);
    }

    .plan-card.plan-pill {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      padding: 10px 14px;
      height: auto;
      min-height: 54px;
      border: 1px solid transparent;
      border-radius: 999px;
      background: transparent;
      color: #234134;
      cursor: pointer;
      transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease;
      position: relative;
      text-align: center;
      box-shadow: none;
    }
    .plan-card.plan-pill:hover {
      background: rgba(35, 65, 52, 0.06);
      border-color: transparent;
    }
    .plan-card.plan-pill.active {
      background: #234134;
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(35, 65, 52, 0.18);
    }

    .plan-pill__name {
      font-family: var(--bookmaniaFont);
      font-size: 14px;
      font-weight: 700;
      line-height: 1.1;
      color: inherit;
      letter-spacing: 0.01em;
    }
    .plan-pill__sub {
      font-size: 12px;
      font-weight: 600;
      color: inherit;
      opacity: 0.85;
    }
    .plan-pill__save {
      position: absolute;
      top: -9px;
      right: 6px;
      background: #f2cb49;
      color: #234134;
      font-size: 10px;
      font-weight: 800;
      padding: 2px 7px;
      border-radius: 999px;
      border: 1px solid #234134;
      letter-spacing: 0.04em;
      line-height: 1.2;
    }

    /* ===== EXPANDED FEATURE PANEL ===== */
    .plan-feature-stack {
      position: relative;
    }
    .plan-feature {
      display: none;
      grid-template-columns: 120px 1fr;
      gap: 18px;
      align-items: center;
      padding: 18px;
      border: 1px solid #234134;
      border-radius: 18px;
      background: #ffffff;
      box-shadow: 0 12px 28px rgba(35, 65, 52, 0.08);
    }
    .plan-feature.is-active {
      display: grid;
      animation: planFeatureFade 0.2s ease-out;
    }
    @keyframes planFeatureFade {
      from { opacity: 0; transform: translateY(4px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .plan-feature__image-wrap {
      width: 120px;
      height: 120px;
      background: #f5f8f0;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .plan-feature__image {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .plan-feature__image--placeholder {
      background: linear-gradient(135deg, #e9ecdf 0%, #f5f8f0 100%);
    }
    .plan-feature__body {
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-width: 0;
    }
    .plan-feature__name {
      font-family: var(--bookmaniaFont);
      font-size: 22px;
      font-weight: 700;
      color: #234134;
      line-height: 1.15;
    }
    .plan-feature__name-sub {
      font-weight: 500;
      font-size: 16px;
      opacity: 0.75;
      margin-left: 4px;
    }
    .plan-feature__price-row {
      display: flex;
      align-items: baseline;
      gap: 14px;
      flex-wrap: wrap;
    }
    .plan-feature__total {
      display: flex;
      align-items: baseline;
      gap: 6px;
      color: #234134;
    }
    .plan-feature__total-value {
      font-size: 28px;
      font-weight: 800;
      line-height: 1;
      font-family: var(--bookmaniaFont);
    }
    .plan-feature__total-label {
      font-size: 13px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      opacity: 0.65;
    }
    .plan-feature__per-item {
      font-size: 14px;
      color: #5b7363;
    }
    .plan-feature__per-item span {
      font-weight: 700;
      color: #234134;
    }
    .plan-feature__savings {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      align-self: flex-start;
      background: #f2cb49;
      color: #234134;
      font-size: 13px;
      font-weight: 700;
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid #234134;
      letter-spacing: 0.02em;
      margin-top: 2px;
    }
    .plan-feature__compare {
      text-decoration: line-through;
      font-weight: 500;
      opacity: 0.75;
    }
    .plan-right {
      display: flex;
      flex-direction: row-reverse;
      align-items: center;
      gap: 23px;
    }

    .subscription-wrapper .plan-right {
      flex-direction: row;
    }
    .plan-price {
      font-size: 20px;
      font-weight: 700;
      height: 42px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      line-height: 1.2;
      color: #234134;
    }
    .plan-price span {
      font-size: 16px;
      font-weight: 400;
      text-align: end;
    }
    .plan-badge {
      background: #234134;
      color: #ffffff;
      font-size: 14px;
      font-weight: 700;
      padding: 7px 8px 2px;
      border-radius: 20px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      min-width: 84px;
    }

    /* VARIANT CARDS */

    /* SUBSCRIPTIONS */
    .subscription-group {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    
    .subscription-group[hidden] {
      display: none !important;
    }

    .subscription-card {
      margin-top: 10px;
      border: 1px solid #234134;
      border-radius: 10px;
      padding: 20px;
      cursor: pointer;
      position: relative;
      transition: all 0.2s ease;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .subscription-card.active {
      box-shadow: 0px 0px 4.9px 3px #23413475 inset;
    }

    .subscription-top {
      display: flex;
      gap: 8px;
      margin-bottom: 6px;
    }

    .subscription-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 25px;
    }

    .subscription-best {
      font-family: var(--copyBodyFont);
      background: #f2cb49;
      color: #234134;
      font-size: 14px;
      font-weight: 700;
      padding: 4px 8px;
      border-radius: 35px;
      position: absolute;
      top: -13px;
      left: 50%;
      transform: translateX(-50%);
      border: 1px solid #234134;
      white-space: nowrap;
      z-index: 1;
      line-height: 1.2;
    }

    .subscription-off {
      background: #ffc107;
      color: #000;
      font-size: 11px;
      font-weight: 700;
      padding: 4px 8px;
      position: absolute;
      top: -1px;
      right: -2px;
      border-bottom-left-radius: 11px;
      border-top-right-radius: 11px;
      height: 24px;
    }

    .subscrition-name {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 0px;
      line-height: 1.2;
      color: #234134;
    }

    .subscription-frequency {
      color: #234134;
    }

    .subscription-note {
      display: flex;
      flex-direction: column;
      gap: 5px;
      font-size: 16px;
      font-weight: 400;
      margin-bottom: 0px;
      color: #234134;
    }

    .subscription-note span {
      line-height: 1.2;
    }

    @media screen and (max-width: 1019px) {
      .plan-wrapper,
      .subscription-wrapper {
        max-width: 100%;
      }

      .plan-name {
        font-size: 14px;
      }
