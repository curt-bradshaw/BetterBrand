      white-space: nowrap;
      z-index: 1;
      line-height: 1.2;
      animation: subscription-badge-pulse 2.5s ease-in-out infinite;
    }

    .subscription-card .plan-badge {
      background: linear-gradient(135deg, #234134 0%, #2d5a44 100%);
      font-size: 13px;
      min-width: 90px;
      height: 26px;
      box-shadow: 0 2px 6px rgba(35, 65, 52, 0.3);
    }

    .subscription-card .plan-badge--b2g1f {
      background: linear-gradient(135deg, #234134 0%, #1a3328 100%);
      font-size: 11px;
      letter-spacing: 0.02em;
    }

    .subscription-card .plan-price {
      font-size: 24px;
      color: #234134;
    }

    .subscription-off {
      background: #ffc107;
      color: #000;
      font-size: 11px;
      font-weight: 700;
      padding: 4px 8px;
      position: absolute;
      top: -1px;
      right: -2px;
      border-bottom-left-radius: 11px;
      border-top-right-radius: 11px;
      height: 24px;
    }

    .subscrition-name {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 0px;
      line-height: 1.2;
      color: #234134;
    }

    .subscription-frequency {
      color: #234134;
    }

    .subscription-card .subscription-title {
      font-size: 20px;
      display: inline;
      text-decoration: underline;
      text-decoration-color: #f2cb49;
      text-decoration-thickness: 3px;
      text-underline-offset: 2px;
    }

    .subscription-card .subscription-title strong {
      text-decoration: inherit;
      text-decoration-color: inherit;
      text-decoration-thickness: inherit;
      text-underline-offset: inherit;
    }

    .subscription-card .subscription-frequency {
      display: inline-block;
      margin-top: 8px;
    }

    @media (prefers-reduced-motion: reduce) {
      .subscription-card.active,
      .subscription-best {
        animation: none;
      }

      .subscription-card:hover {
        transform: none;
      }
    }

