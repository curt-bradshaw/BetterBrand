      margin-bottom: 23px;
      margin-top: 10px;
      position: relative;
    }

    .subscription-eyebrow {
      font-family: var(--copyBodyFont);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #234134;
      text-align: center;
      margin: 0 0 18px;
      padding: 6px 14px;
      background: linear-gradient(90deg, transparent, rgba(35, 65, 52, 0.12), transparent);
      border-radius: 4px;
    }

    .plan-title--otp {
      font-size: 15px;
      font-weight: 600;
      color: rgba(35, 65, 52, 0.65);
      margin-top: 0;
      margin-bottom: 12px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .subscription-wrapper + .plan-wrapper .plan-card {
      border-color: rgba(35, 65, 52, 0.35);
      background: #fafafa;
    }

    .subscription-wrapper + .plan-wrapper .plan-card.active {
      border-color: #234134;
      background: #fff;
      box-shadow: 0px 0px 4.9px 3px #23413440 inset;
    }

    .plan-wrapper {
      width: 100%;
      margin-bottom: 0;
    }

    .plan-wrapper *,
    .subscription-wrapper * {
      font-family: var(--bookmaniaFont);
    }

    .plan-title {
      font-size: 20px;
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 0px;
      font-family: var(--bookmaniaFont);
      color: #234134;
      margin-top: 25px;
    }
    .plan-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 23px;
    }

    .plan-badge.hidden {
      display: none;
    }

    .content {
      display: flex;
      justify-content: space-between;
    }

    .plan-card {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 20px;
      border: 1px solid #234134;
      border-radius: 14px;
      cursor: pointer;
      transition: all 0.2s ease;
      height: 92px;
      position: relative;
    }
    .plan-card:hover {
      border: 1px solid #234134;
    }
    .plan-card.active {
      box-shadow: 0px 0px 4.9px 3px #23413475 inset;
    }
    .plan-left {
      width: 75px;
      height: 75px;
      display: flex;
      align-items: center;
    }
    .plan-left img {
      width: 100%;
      height: auto;
    }
    .plan-center {
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .plan-name {
      font-size: 18px;
      font-weight: 700;
      line-height: 1.2;
      margin-bottom: 0px;
      color: #234134;
    }
    .plan-subtitle {
      font-size: 12px;
      color: #777;
    }
    .plan-right {
      display: flex;
      flex-direction: row-reverse;
      align-items: center;
      gap: 23px;
    }

    .subscription-wrapper .plan-right {
      flex-direction: row;
    }
    .plan-price {
      font-size: 20px;
      font-weight: 700;
      height: 42px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      line-height: 1.2;
      color: #234134;
    }
    .plan-price span {
      font-size: 16px;
      font-weight: 400;
      text-align: end;
    }
    .plan-badge {
      background: #234134;
      color: #ffffff;
      font-size: 14px;
      font-weight: 700;
      padding: 7px 8px 2px;
      border-radius: 20px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      min-width: 84px;
    }

    .plan-badge--b2g1f {
      min-width: 0;
      padding-left: 10px;
      padding-right: 10px;
      font-size: 12px;
    }

    .subscription-best--promo {
      font-size: 12px;
      padding-left: 10px;
      padding-right: 10px;
    }

    /* VARIANT CARDS */

    /* SUBSCRIPTIONS */
    .subscription-group {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    
    .subscription-group[hidden] {
      display: none !important;
    }

    .subscription-card {
      margin-top: 10px;
      border: 2px solid #234134;
      border-radius: 14px;
      padding: 22px 20px 18px;
      cursor: pointer;
      position: relative;
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: linear-gradient(145deg, #f4faf1 0%, #dcefd4 45%, #e8f3e4 100%);
      box-shadow: 0 4px 18px rgba(35, 65, 52, 0.14);
    }

    .subscription-card:hover {
      border-color: #234134;
      box-shadow: 0 6px 22px rgba(35, 65, 52, 0.2);
      transform: translateY(-1px);
    }

    .subscription-card.active {
      border-color: #234134;
      background: linear-gradient(145deg, #e0f0d8 0%, #c2deb4 45%, #e8f3e4 100%);
