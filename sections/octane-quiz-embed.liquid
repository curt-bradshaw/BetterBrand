<style>
  *, *::before, *::after { box-sizing: border-box; }

  .octane-ai-quiz-rendered,
  .octane-ai-quiz-rendered * {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif !important;
    color: #234134;
  }

  .octane-ai-quiz-rendered .oct-quiz-wrapper { padding: 12px !important; }
  .octane-ai-quiz-rendered h1 {
    font-size: 22px !important; line-height: 1.25 !important;
    margin: 8px 0 12px 0 !important; font-weight: 600 !important;
    text-align: center !important;
  }
  .octane-ai-quiz-rendered h2 {
    font-size: 14px !important; line-height: 1.4 !important;
    margin: 0 0 14px 0 !important; font-weight: 400 !important;
    color: #555 !important; text-align: center !important;
  }

  .octane-ai-quiz-rendered [class*="picture-choice"][class*="image"],
  .octane-ai-quiz-rendered [class*="picture-choice"] img {
    max-height: 180px !important; object-fit: contain !important;
  }
  .octane-ai-quiz-rendered [class*="picture-choice-options__option"] { padding: 6px !important; }
  .octane-ai-quiz-rendered [class*="picture-choice-options__option"] [class*="label"],
  .octane-ai-quiz-rendered [class*="picture-choice-options__option"] [class*="title"] {
    font-size: 13px !important; line-height: 1.3 !important;
    padding: 6px 4px !important; min-height: 0 !important;
  }

  .bb-q1-strike { text-decoration: line-through; color: #888; font-weight: 500; margin-right: 6px; }
  .bb-q1-free { color: #3f745d; font-weight: 800; letter-spacing: 0.4px; }

  .octane-ai-quiz-rendered [class*="multiple-choice-options__option"] {
    padding: 12px 14px !important; min-height: 48px !important;
    margin-bottom: 8px !important; font-size: 14px !important;
  }

  .octane-ai-quiz-rendered .oct-quiz-btn--primary,
  .octane-ai-quiz-rendered button[class*="oct-quiz-btn"]:not([class*="back"]):not([class*="secondary"]) {
    background: #3f745d !important; color: #fff !important; border-color: #3f745d !important;
  }
  .octane-ai-quiz-rendered .oct-quiz-btn--primary:hover {
    background: #234134 !important; border-color: #234134 !important;
  }

  .octane-ai-quiz-rendered [class*="smart-copy"],
  .octane-ai-quiz-rendered [class*="smart-copy"] *,
  .bb-smart-copy, .bb-smart-copy * { text-align: left !important; }
  .bb-smart-copy {
    background: #fff; border: 1px solid #e5e5e1; border-radius: 10px;
    padding: 16px 18px; margin: 12px 0;
  }
  .bb-smart-copy .bb-bullet {
    display: block; padding-left: 18px; text-indent: -14px;
    margin-bottom: 10px; line-height: 1.5; font-size: 14px; color: #234134;
  }

  .octane-ai-quiz-rendered select,
  .octane-ai-quiz-rendered [role="combobox"] {
    border: 2px solid #3f745d !important; border-radius: 6px !important;
    padding: 10px 32px 10px 12px !important; background: #fff !important;
    font-weight: 600 !important; color: #234134 !important; cursor: pointer !important;
    appearance: none !important; -webkit-appearance: none !important;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='8' viewBox='0 0 14 8'><path d='M1 1l6 6 6-6' stroke='%233f745d' stroke-width='2' fill='none'/></svg>") !important;
    background-repeat: no-repeat !important; background-position: right 10px center !important;
  }

  .octane-ai-quiz-rendered [class*="oct-quiz-back"],
  .octane-ai-quiz-rendered button[class*="back"],
  .bb-hidden-back, .bb-hero-atc-hidden { display: none !important; }

  .bb-banner {
    background: #234134; color: #fff; padding: 8px 12px;
    text-align: center; font-size: 12px; letter-spacing: 0.2px; line-height: 1.3;
    margin: 0 0 12px 0;
  }
  .bb-banner b { color: #F2CB49; font-weight: 700; }

  .bb-bundled-badge {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    background: #EAF1ED; color: #234134; border: 2px solid #3f745d; border-radius: 8px;
    padding: 12px 16px; font-weight: 600; font-size: 14px; letter-spacing: 0.3px;
    text-align: center; margin: 12px 0;
  }
  .bb-bundled-badge::before { content: "✓"; color: #3f745d; font-weight: 700; }

  .bb-checkout-bar {
    position: fixed; left: 0; right: 0; bottom: 0; padding: 12px; background: #fff;
    border-top: 1px solid #e5e5e1; z-index: 999; box-shadow: 0 -4px 20px rgba(0,0,0,0.06);
  }
  .bb-checkout-bar a {
    display: block; width: 100%; max-width: 600px; margin: 0 auto;
    background: #234134; color: #fff; padding: 14px 16px; border: none; border-radius: 8px;
    font-size: 15px; font-weight: 700; letter-spacing: 0.4px; text-decoration: none;
    text-align: center; cursor: pointer; text-transform: uppercase;
  }
  .bb-checkout-bar a:hover { background: #3f745d; }
</style>

<script>
(function () {
  'use strict';

  function injectBanner() {
    if (document.querySelector('.bb-banner')) return;
    var embed = document.querySelector('.octane-ai-quiz, .octane-ai-quiz-rendered');
    if (!embed) return;
    var banner = document.createElement('div');
    banner.className = 'bb-banner';
    banner.innerHTML = 'Your personalized bundle expires in <b id="bb-timer">10:00</b> — finish to save 20% + free shipping';
    embed.parentNode.insertBefore(banner, embed);
  }

  var startMs = parseInt(localStorage.getItem('bb-quiz-start') || '0', 10);
  if (!startMs) { startMs = Date.now(); try { localStorage.setItem('bb-quiz-start', String(startMs)); } catch (e) {} }
  function tickTimer() {
    var elapsed = Math.floor((Date.now() - startMs) / 1000);
    var remain = Math.max(0, 600 - elapsed);
    var m = Math.floor(remain / 60), s = remain % 60;
    var el = document.getElementById('bb-timer');
    if (el) el.textContent = m + ':' + (s < 10 ? '0' + s : s);
  }
  setInterval(tickTimer, 1000); tickTimer();

  function rewriteHeroLinks() {
    document.querySelectorAll('a[href*="/products/betterlungs-old"]').forEach(function (a) {
      a.setAttribute('href', a.getAttribute('href').replace(
        /\/products\/betterlungs-old\?variant=\d+/,
        '/products/betterlungs?variant=50318075461931'
      ));
    });
  }

  function decorateQ1Labels() {
    document.querySelectorAll('[class*="picture-choice-options__option"]').forEach(function (li) {
      if (li.dataset.bbQ1Done === '1') return;
      var walker = document.createTreeWalker(li, NodeFilter.SHOW_TEXT, null, false);
      var n;
      while ((n = walker.nextNode())) {
        var m = (n.textContent || '').match(/^\s*(.+?)\s*\(\$19\.95\s*value\)\s*$/i);
        if (!m) continue;
        var span = document.createElement('span');
        span.innerHTML = m[1].trim() + '<br><span class="bb-q1-strike">$19.95</span><span class="bb-q1-free">FREE</span>';
        n.parentNode.replaceChild(span, n);
        li.dataset.bbQ1Done = '1';
        break;
      }
    });
  }

  function reformatSmartCopy() {
    document.querySelectorAll('div, p, span').forEach(function (el) {
      if (el.dataset.bbSmartCopyDone === '1') return;
      if (el.children && el.children.length > 0) return;
      if (el.classList && el.classList.contains('bb-bullet')) return;
      var raw = (el.textContent || '').trim();
      if (!raw || raw.length < 30) return;
      if ((raw.match(/•/g) || []).length < 2) return;
      if (!/(Because|Since)\b/i.test(raw)) return;
      var parts = raw.split(/\s*•\s*/).map(function (s) { return s.trim(); }).filter(Boolean);
      if (parts.length < 2) return;
      var wrap = document.createElement('div');
      wrap.className = 'bb-smart-copy';
      parts.forEach(function (p) {
        var b = document.createElement('span');
        b.className = 'bb-bullet';
        b.textContent = '• ' + p;
        wrap.appendChild(b);
      });
      el.innerHTML = '';
      el.appendChild(wrap);
      el.dataset.bbSmartCopyDone = '1';
    });
  }

  function hideGiftIframe() {
    document.querySelectorAll('iframe').forEach(function (ifr) {
      var doc;
      try { doc = ifr.contentDocument || (ifr.contentWindow && ifr.contentWindow.document); } catch (e) { return; }
      if (!doc || !doc.body) return;
      var t = (doc.body.textContent || '');
      if (t.indexOf('Free Gift') === -1 && t.indexOf('Money-Back Guarantee') === -1) return;
      ifr.style.display = 'none';
      var wrap = ifr.parentElement;
      for (var j = 0; j < 3 && wrap; j++) {
        if (wrap.children && wrap.children.length === 1) wrap.style.display = 'none';
        wrap = wrap.parentElement;
      }
    });
  }

  function hideBackButtons() {
    document.querySelectorAll('button, a, div, span').forEach(function (b) {
      if (b.children && b.children.length > 0) return;
      var t = (b.textContent || '').trim().toUpperCase().replace(/[\s←]+/g, '');
      if (t === 'BACK' && !b.classList.contains('bb-hidden-back')) {
        b.classList.add('bb-hidden-back');
        var w = b.closest('button, a');
        if (w && !w.classList.contains('bb-hidden-back')) w.classList.add('bb-hidden-back');
      }
    });
  }

  var GIFT_HANDLES = ['beepropolis-throat-spray', 'nasal-strips'];
  var cartAddState = { added: false, attempts: 0 };
  function getVar(href) { var m = (href || '').match(/[?&]variant=(\d+)/); return m ? m[1] : null; }
  function findCard(a) {
    var el = a;
    for (var i = 0; i < 10 && el; i++) {
      var cls = (el.className || '').toString();
      if (cls.indexOf('oct-quiz-products__item') !== -1) return el;
      el = el.parentElement;
    }
    return a.parentElement;
  }
  function decorateCard(card, txt) {
    if (!card || card.dataset.bbDec === '1') return;
    card.querySelectorAll('button[class*="oct-quiz-btn"]').forEach(function (b) { b.classList.add('bb-hero-atc-hidden'); });
    if (!card.querySelector('.bb-bundled-badge')) {
      var b = document.createElement('div'); b.className = 'bb-bundled-badge'; b.textContent = txt;
      card.appendChild(b);
    }
    card.dataset.bbDec = '1';
  }
  function autoAddToCart() {
    if (cartAddState.attempts > 30) return;
    var resultPage = document.querySelector('[class*="result-page"], [class*="result-item"]');
    if (!resultPage) return;
    var anchors = document.querySelectorAll('a[href*="/products/"]');
    var gA = null, hA = null;
    for (var i = 0; i < anchors.length; i++) {
      var href = anchors[i].getAttribute('href') || '';
      var isGift = GIFT_HANDLES.some(function (h) { return href.indexOf('/products/' + h) !== -1; });
      if (isGift && !gA) gA = anchors[i];
      else if (!isGift && href.indexOf('/products/') !== -1 && !hA) hA = anchors[i];
    }
    if (!gA || !hA) return;
    var gV = getVar(gA.getAttribute('href')), hV = getVar(hA.getAttribute('href'));
    if (!gV || !hV) return;
    cartAddState.attempts++;
    decorateCard(findCard(gA), 'Added to your bundle (FREE)');
    decorateCard(findCard(hA), 'Added to your bundle');
    if (!document.querySelector('.bb-checkout-bar')) {
      var bar = document.createElement('div'); bar.className = 'bb-checkout-bar';
      var a = document.createElement('a');
      a.textContent = 'Continue to Checkout →';
      a.href = '/cart/' + hV + ':1,' + gV + ':1?discount=Free-Kit-20';
      bar.appendChild(a);
      document.body.appendChild(bar);
    }
    if (!cartAddState.added) {
      try {
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: parseInt(hV, 10), quantity: 1 }, { id: parseInt(gV, 10), quantity: 1 }] })
        }).then(function (r) { if (r && r.ok) cartAddState.added = true; }).catch(function () {});
      } catch (e) {}
    }
  }

  function tick() {
    injectBanner();
    hideBackButtons();
    decorateQ1Labels();
    reformatSmartCopy();
    hideGiftIframe();
    rewriteHeroLinks();
    autoAddToCart();
  }
  new MutationObserver(tick).observe(document.body, { childList: true, subtree: true });
  document.addEventListener('DOMContentLoaded', tick);
  setInterval(tick, 1000);
})();
</script>