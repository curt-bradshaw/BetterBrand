<!-- START trustpilot.liquid -->

{%- liquid
  assign hide_handle = section.settings.hide_for_product_handle | strip | downcase
  assign hide_widget = false
  if hide_handle != blank and product.handle == hide_handle
    assign hide_widget = true
  endif
-%}

{%- unless hide_widget -%}
  <!-- TrustBox widget - Product Reviews MultiSource -->
  <div class="trustpilot-widget" data-locale="en-US" data-template-id="57177697fdb1180308e3815f" data-businessunit-id="6403507cda3f50147669ca41" data-style-height="700px" data-style-width="100%" data-token="ffd7be81-3b8e-46e4-bffe-dff5c78a9839" data-sku="{{ product.selected_or_first_available_variant.sku }}" data-review-languages="en" data-no-reviews="hide" data-fullwidth="true">
    <a href="https://www.trustpilot.com/review/trybetterbrand.com" target="_blank" rel="noopener">Trustpilot</a>
  </div>
  <!-- End TrustBox widget -->

  <style>
    .trustpilot-widget {
      max-width: 1280px;
      margin: 0 auto;
      padding: 80px 20px;
    }

    @media (max-width: 1019px) {
      .trustpilot-widget {
        padding: 60px 20px;
      }
    }

    @media (max-width: 767px) {
      .trustpilot-widget {
        padding: 40px 20px;
      }
    }
  </style>
{%- endunless -%}

{% schema %}
{
  "name": "Trustpilot Reviews",
  "tag": "section",
  "class": "section-trustpilot",
  "settings": [
    {
      "type": "text",
      "id": "hide_for_product_handle",
      "label": "Hide widget on product handle",
      "default": "allergy-protocol",
      "info": "Enter the product URL handle only (from the PDP URL). Trustpilot is hidden on that product only; leave blank to show on every product page."
    }
  ],
  "presets": [
    {
      "name": "Trustpilot Reviews"
    }
  ]
}
{% endschema %}
