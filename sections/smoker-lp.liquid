<script>
/* Real PDP buy box behaviour. Variant and selling-plan IDs are read off the
   real elements' own data attributes, so the cart wiring is exactly the PDP's. */
(function(){
  var box = SEC_ID('bbReal');
  if(!box) return;
  var cards = [].slice.call(box.querySelectorAll('.plan-card, .subscription-card'));
  var atc   = SEC_ID('bbRealAtc');
  var money = box.querySelector('.btn-money strong') || box.querySelector('.btn-money');
  var items = box.querySelector('.btn-items strong') || box.querySelector('.btn-items');
  if(!cards.length || !atc) return;

  var gal = SEC_ID('bbGal');
  var slides = gal ? [].slice.call(gal.querySelectorAll('img[data-slide]')) : [];
  var dots = gal ? [].slice.call(SEC_ID('bbGalDots').children) : [];
  var cur = 0;
  function show(i){
    if(!slides.length) return;
    cur = (i + slides.length) % slides.length;
    slides.forEach(function(im,n){ im.classList.toggle('off', n !== cur); });
    dots.forEach(function(d,n){ d.classList.toggle('on', n === cur); });
  }
  if(gal){
    SEC_ID('bbGalPrev').addEventListener('click', function(e){ e.preventDefault(); show(cur-1); });
    SEC_ID('bbGalNext').addEventListener('click', function(e){ e.preventDefault(); show(cur+1); });
  }

  function select(card){
    cards.forEach(function(c){ c.classList.toggle('active', c === card); });
    var cents = parseInt(card.getAttribute('data-price'), 10) || 0;
    var vid = card.getAttribute('data-variant-id');
    var plan = card.getAttribute('data-selling-plan-id');
    if(money) money.textContent = '$' + (cents/100).toFixed(2);
    var mm = (card.innerText || '').match(/(\d+)\s*Bags?/i);
    var n = mm ? parseInt(mm[1], 10) : 1;
    if(items) items.textContent = '(' + n + ' Item' + (n > 1 ? 's' : '') + ')';
    var vEl = SEC.querySelector('#bbVariantId');
    var pEl = SEC.querySelector('#bbSellingPlan');
    if(vEl) vEl.value = vid;
    if(pEl) pEl.value = plan || '';
    show(n > 1 ? 1 : 0);
  }
  cards.forEach(function(c){ c.addEventListener('click', function(){ select(c); }); });
  select(box.querySelector('.plan-card.active') || cards[0]);
})();
</script>

