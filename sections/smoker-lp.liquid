    var priceEl = document.getElementById('bbPrice');
    var qtyEl = document.getElementById('bbQty');

    /* gallery: arrows, dots, and it follows the selected pack size like the PDP */
    var gal = document.getElementById('bbGal');
    var slides = [].slice.call(gal.querySelectorAll('img[data-slide]'));
    var dots = [].slice.call(document.getElementById('bbGalDots').children);
    var cur = 0;
    function show(i){
      cur = (i + slides.length) % slides.length;
      slides.forEach(function(im, n){ im.classList.toggle('off', n !== cur); });
      dots.forEach(function(d, n){ d.classList.toggle('on', n === cur); });
    }
    document.getElementById('bbGalPrev').addEventListener('click', function(e){ e.preventDefault(); show(cur - 1); });
    document.getElementById('bbGalNext').addEventListener('click', function(e){ e.preventDefault(); show(cur + 1); });

    function select(opt){
      if(opt.dataset.slide) show(+opt.dataset.slide);
      opts.forEach(function(o){
        var on = o === opt;
        o.classList.toggle('sel', on);
        var r = o.querySelector('input'); if(r) r.checked = on;
      });
      priceEl.textContent = '$' + opt.dataset.price;
      var q = +opt.dataset.qty;
      qtyEl.textContent = '(' + q + ' Item' + (q > 1 ? 's' : '') + ')';
      atc.setAttribute('href', opt.dataset.url);
      if(window.__bbDecorate) window.__bbDecorate(atc);
    }
    opts.forEach(function(o){
      o.addEventListener('click', function(){ select(o); });
    });

    /* daily shipping cutoff, 3pm US Central = 20:00 UTC (21:00 during CDT) */
    var SHIP_CUTOFF_UTC_HOUR = 20;
    var el = document.getElementById('bbShip');
    function tick(){
      var now = new Date();
      var cut = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), SHIP_CUTOFF_UTC_HOUR, 0, 0));
      if(cut - now <= 0){ cut.setUTCDate(cut.getUTCDate() + 1); }
      var ms = cut - now;
      var h = Math.floor(ms/3600000), m = Math.floor(ms%3600000/60000), sec = Math.floor(ms%60000/1000);
      el.textContent = h + 'hr ' + m + 'mins ' + sec + ' sec';
      setTimeout(tick, 1000);
    }
    tick();
  })();

