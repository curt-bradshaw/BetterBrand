  /* ==== REAL PDP BUY BOX ====================================================
     Markup and CSS lifted from the live product page. Scoped under #bbHost, and
     the PDP's own ancestor chain (.product-page > .wrapper.product-mobile-wrapper
     > .products-info > .product-half) is reproduced INSIDE the host, because 48 of
     the real rules are descendant selectors anchored on those ancestors and will
     not resolve without them. Host is 375px wide to match the PDP's container.
     ========================================================================= */
  @font-face{font-family:SuisseIntlMono;font-weight:400;font-display:swap;
    src:url("https://www.trybetterbrand.com/cdn/shop/files/suisse-intl-mono-webfont.woff2") format("woff2")}
  @font-face{font-family:SuisseIntlMono;font-weight:500;font-display:swap;
    src:url("https://www.trybetterbrand.com/cdn/shop/files/suisse-intl-medium-webfont.woff2") format("woff2")}
  @font-face{font-family:SuisseIntlMono;font-weight:700;font-display:swap;
    src:url("https://www.trybetterbrand.com/cdn/shop/files/suisseintlmono-bold-webfont.woff2") format("woff2")}

  /* Custom properties the lifted rules depend on, resolved off the live PDP.
     Without these, rules like background:var(--AddToCartBackground) fall back
     to nothing and the gold button renders transparent. */
  #bbHost{
    --AddToCartBackground:#F2CB49;
    --AddToCartBorderRadius:10px;
    --AddToCartFontSize:16px;
    --AddToCartFontWeight:bold;
    --AddToCartTextColor:#fff;
    --AddToCartTextTransform:uppercase;
    --CouponTextColor:#3f745d;
    --ProductComparePriceFontSize:20px;
    --ProductPriceFontSize:30px;
    --ProductPriceFontSizeMobile:26px;
    --ProductTitleFontSizeMobile:26px;
    --active-tab-color:#313131;
    --active-tab-text-color:#ffffff;
    --bookmaniaFont:'bookmania', serif;
    --breadcrumbLinkColor:#969696;
    --breadcrumbtextcolor:#252525;
    --color-link:#555555;
    --color-price:#234134;
    --color-sale:#969696;
    --colorTitleSearchSuggestion:#234134;
    --color_out_of_stock_label:#767676;
    --copyBodyFont:'SuisseIntlMono', sans-serif;
    --copy_body:16px;
    --copy_body_mobile:14px;
    --h1Color:#000;
    --h1SizeMobile:28px;
    --h2Color:#000;
    --h2SizeMobile:20px;
    --h3Color:#000;
    --h3SizeMobile:16px;
    --h4Color:#000;
    --h4SizeMobile:13px;
    --h5Color:#000;
    --h5SizeMobile:14px;
    --h6Color:#000;
    --h6SizeMobile:14px;
    --headerFont:'SuisseIntlMono', sans-serif;
    --iconCheckmarkChecked:#fff;
    --inactive-tab-color:#e2e2e2;
    --out_of_stock_background_color:#3f745d;
    --out_of_stock_text_color:#fff;
    --product-info-alignment:center;
    --productTitleTransform:capitalize;
    --product_info_mobile_direction:center;
    --progressATCBackgroundColor:#f00;
    --shipping-bar-height:50px;
    --shipping-bar-price-text-color:#ffffff;
    --size-chart-color:#969696;
    --spacing:.25rem;
    --stock_warning_background_color:#EDEDED;
    --tooltip-size:70px;
    --truemed-link-color:#3c3c3c;
    --truemed-link-hover-color:#179895;
    --truemed-text-color:#000000bf;
    --tw-border-style:solid;
    --tw-outline-style:solid;
    --wrapperWidth:1220px;
    --yousave-color:#000000;
  }

  /* The real SuisseIntlMono, straight off Betterbrand's own Shopify CDN. Both
     weights answer with access-control-allow-origin:*, verified, so this is a
     cross-origin fetch of BB's own asset rather than a copy hosted here. This is
     the fix that matters: every proportion hack in this file existed only
     because the button was rendering in a wider fallback face. bookmania is an
     Adobe Typekit kit and is domain-licensed, so the card serif still falls back
     off-domain; on Shopify both load natively. */
  @font-face{font-family:SuisseIntlMono;font-style:normal;font-weight:400;font-display:swap;
    src:url("https://www.trybetterbrand.com/cdn/shop/files/suisse-intl-mono-webfont.woff2?v=590474723420591623") format("woff2")}
  @font-face{font-family:SuisseIntlMono;font-style:normal;font-weight:700;font-display:swap;
    src:url("https://www.trybetterbrand.com/cdn/shop/files/suisseintlmono-bold-webfont.woff2?v=13901557664829825750") format("woff2")}

  #bbHost{margin:30px auto 0;
    font-family:SuisseIntlMono,ui-monospace,SFMono-Regular,Menlo,monospace;
    color:#252525;text-align:left}
  #bbHost *{box-sizing:border-box}
  #bbHost img{max-width:100%}
  #bbHost .bbr-stars{color:#F2CB49;font-size:15px;letter-spacing:1px;margin:0}
  #bbHost .bbr-rev{font-size:11px;color:#4B4A49;margin:2px 0 8px}
  #bbHost .bbr-title{font-family:bookmania,"Bookman Old Style","URW Bookman L",Georgia,serif;
    font-weight:700;font-size:26px;line-height:1.14;color:#234134;margin:0 0 10px}
  #bbHost .bbr-dek{font-size:13px;line-height:1.62;color:#3c3c3c;margin:0 0 16px}
  /* On the live PDP nearly everything inside the buy box computes to bookmania,
     not the mono body face. Measured: .plan-list/.plan-card/.plan-name/.plan-price/
     .plan-badge/.subscription-title/.subscription-frequency/.subscription-note/
     .btn-money/.btn-label all = bookmania. Only the form, #AddToCart and
     .subscription-best are SuisseIntlMono. Reproducing that split is what makes it
     read like the live box rather than a mono mock-up. */
  #bbHost .plan-list, #bbHost .plan-card, #bbHost .plan-name, #bbHost .plan-price, #bbHost .plan-price span, #bbHost .plan-badge, #bbHost .plan-badge span, #bbHost .subscription-card, #bbHost .subscription-title, #bbHost .subscription-frequency, #bbHost .subscrition-name, #bbHost .subscription-note, #bbHost .subscription-note span, #bbHost .btn-money, #bbHost .btn-money strong, #bbHost .btn-label, #bbHost .btn-label strong, #bbHost .btn-items, #bbHost .bbr-title{
    font-family:bookmania,"Bookman Old Style","URW Bookman L","Palatino Linotype",Palatino,Georgia,serif;
  }
  #bbHost .form-add-to-cart, #bbHost #bbRealAtc, #bbHost .subscription-best{
    font-family:SuisseIntlMono,ui-monospace,SFMono-Regular,Menlo,monospace;
  }
  /* measured targets from the live box */
  #bbHost .plan-name{font-size:14px;font-weight:700;line-height:16.8px;color:#234134}
  #bbHost .plan-price{font-size:14px;font-weight:700;line-height:16.8px;color:#234134}
  #bbHost .plan-price span{font-size:12px;font-weight:400;line-height:14.4px}
  #bbHost .btn-money, #bbHost .btn-label{font-size:16px;font-weight:700;line-height:16px;color:#234134}
  #bbHost .subscription-title, #bbHost .subscription-frequency{font-size:14px;font-weight:700;line-height:14px;color:#234134}
  #bbHost .subscription-note{font-size:14px;font-weight:400;line-height:22.4px;color:#234134}

  /* Final diff against the live box, measured not guessed:
       - the article body's 19px was inheriting into the form; live form is 14px/22.4px
       - cards/ATC came out 339px because the wrapper padding was 18px, live is 20px,
         giving 375 - 40 = 335
       - badge and Best Value pill were each 1-2px out on padding/line-height */
  .bb-smoker-labor-day #bbReal{font-size:14px;line-height:22.4px}
  /* The live buy box sits in a 375px container with 20px padding, giving 335px of
     content. The article column's own padding was squeezing it, so the host goes
     full-bleed to the viewport and re-centres an exact 375px column inside. */
  /* No 100vw full-bleed. 100vw counts the scrollbar, which pushed the whole box
     ~7px left of the page centre on desktop. Plain auto margins centre exactly.
     Column width tracks the live PDP: 335px of content on mobile (375 - 2x20),
     and 563px on desktop, which is what the live buy-box column measures at
     1440px, where the ATC is 563x84 rather than a 335px mobile pill. */
  #bbHost{width:auto;max-width:100%;margin:30px auto 0;transform:none}
  /* On mobile the box escapes the article column's 18px side padding, because
     the live PDP's wrapper is full width and only carries its own 20px. That
     36px was the whole problem: my button came out 323px against live's 359px
     at a 414px viewport, so the same run filled 85% of it against live's 79%,
     and a cramped run reads as off centre. -18px is the article's exact padding,
     not a 100vw trick, so it cannot pick up the scrollbar offset again. */
  /* max-width:100% would cap the growth and turn these negative margins into a
     pure 18px leftward shift, which is exactly the off-centre bug again. The
     width has to be widened by the same 36px it is being pulled out by. */
  #bbHost{margin-left:-18px;margin-right:-18px;
    width:calc(100% + 36px);max-width:calc(100% + 36px)}
  #bbHost > section{width:100%;max-width:none;margin:0 auto}
  /* The 420px cap that used to live here was the bug. It switched the escape
     off at 420, so from 420 to 619 the box went back inside the article's 18px
     padding and the button lost 36px. iPhone 14 Pro Max is 430, right in that
     band: the button came out 339px where live is 375px, ratio 0.81 against
     live's 0.74. Testing at 414 and 500 missed it because 414 is below the
     breakpoint and 500 is far enough above that the width recovers.
     Checked against live instead of capped: live is 460px wide at a 500px
     viewport and still on 16px type, ratio 0.576. Uncapped, mine is 445px and
     0.573. They track. Live is sparse through the tablet band too, so the cap
     was correcting toward something live never did. */
  @media (min-width:620px){
    #bbHost{margin-left:auto;margin-right:auto;width:auto;max-width:100%}
    #bbHost > section{max-width:603px}
  }
  #bbHost .product-mobile-wrapper{padding:0 20px 20px;max-width:none}
  #bbHost .plan-badge{height:24px;line-height:12px}
  #bbHost .subscription-best{padding:3px 10px;font-size:12px;line-height:16px;
    display:inline-block;height:24px;box-sizing:border-box}

  /* ATC internal layout, measured off the live button (335px wide):
     .text-btn is flex/center/gap 4px at 285px, children landing at x offsets
     25 / 86 / 100 / 224 / 254. Pinning that so the group sits where it does live. */
  #bbHost #bbRealAtc{justify-content:center;gap:0}
  /* No fixed width and no extra margins. The old rule pinned .text-btn to the
     285px it measures with the real SuisseIntlMono, then added 11px+11px of
     margins inside it, so the content needed 307px in a 285px box and wrapped
     onto a second line. Live is auto width, gap 4px, .btn-svg margin 0 .45em.
     nowrap is belt-and-braces: off-domain the brand fonts do not load and the
     fallback is wider, and the label must still hold one line. */
  #bbHost #bbRealAtc .text-btn{display:flex;justify-content:center;align-items:center;
    flex-wrap:nowrap;gap:4px;width:auto;max-width:100%;margin:0 auto;white-space:nowrap}
  /* Back to the live PDP's own run, all five parts, in the flow, centred:
     price, divisor, label, cart icon, item count. The live button reads as
     centred, so the content was never the problem. What was wrong here is
     PROPORTION. Off-domain neither brand webfont loads, the fallback is wider,
     and the run filled 85% of the button against live's 79%, leaving 24px of
     breathing room where live has 37px. A cramped run reads as off centre even
     when its gaps are equal, which is why every attempt at rebalancing the
     inside failed. Fix the proportion instead, and keep live's markup intact.
     Sizes below are set to hit live's ink-to-button ratio. */
  #bbHost #bbRealAtc .text-btn{position:static;padding:0}
  #bbHost #bbRealAtc .btn-money{position:static;transform:none;margin:0;white-space:nowrap}
  #bbHost #bbRealAtc .divisor{display:block;position:static;transform:none;margin:0 5px}
  #bbHost #bbRealAtc .btn-svg{position:static;transform:none;display:flex;
    align-items:center;margin:0 .45em}
  #bbHost #bbRealAtc .btn-items{display:block;position:static;transform:none;margin:0}
  #bbHost #bbRealAtc .btn-label{margin:0}
  /* Label size follows the column width, the way the live PDP does it. Live is
     16px in the 335px mobile button (.text-btn 285x18) and 22px in the 563px
     desktop button (.text-btn 401x25). The lifted media queries get this wrong
     here because they were written against the PDP's own breakpoints, not this
     column, so they leave 22-24px in a 335px button through the tablet band.
     Two ids outrank them, so source order does not matter. */
  /* Live's own sizes restored: 16px mobile, 23px desktop. The button label has
     to outrank the plan names (14px) — shrinking it to hit a ratio target put
     the smallest type in the box on the one element that has to dominate. With
     the box now at live's width the ratio comes right at live's size anyway. */
  #bbHost #bbRealAtc .text-btn, #bbHost #bbRealAtc .btn-money, #bbHost #bbRealAtc .btn-money strong, #bbHost #bbRealAtc .divisor, #bbHost #bbRealAtc .divisor strong, #bbHost #bbRealAtc .btn-label, #bbHost #bbRealAtc .btn-label strong, #bbHost #bbRealAtc .btn-items{font-size:16px;line-height:1}
  /* Below 356px the 16px run does not fit: at 320 the button is 265 and the run
     needs 275, so it overflows by 5px each side. Found by sweeping every 2px
     from 320 to 640 rather than sampling a few widths, which is how the 430px
     case slipped through in the first place. Live overflows here too, but that
     is not a reason to ship it. */
  @media (max-width:355px){
    #bbHost #bbRealAtc .text-btn, #bbHost #bbRealAtc .btn-money, #bbHost #bbRealAtc .btn-money strong, #bbHost #bbRealAtc .divisor, #bbHost #bbRealAtc .divisor strong, #bbHost #bbRealAtc .btn-label, #bbHost #bbRealAtc .btn-label strong, #bbHost #bbRealAtc .btn-items{font-size:14px;line-height:1}
    #bbHost .plan-card .plan-name, #bbHost .plan-card .plan-price{font-size:13px}
  }
  /* Text size inside the pill, taken straight off the live PDP:
       live @414px  -> every child 16px, button 359 wide
       live @1440px -> every child 22px, button 563 wide
     My column is 359 wide on mobile and 563 from 620px up, the same two widths,
     so the two sizes transfer directly. Mobile 16px comes from the lifted CSS
     already; the 563px column needs the 22px step because live reaches 563 at a
     viewport where its own media queries have already moved on. */
  @media (min-width:620px){
    #bbHost #bbRealAtc .text-btn, #bbHost #bbRealAtc .btn-money, #bbHost #bbRealAtc .btn-money strong, #bbHost #bbRealAtc .divisor, #bbHost #bbRealAtc .divisor strong, #bbHost #bbRealAtc .btn-label, #bbHost #bbRealAtc .btn-label strong, #bbHost #bbRealAtc .btn-items{font-size:22px;line-height:1}
  }

  /* SAVE pills in gold rather than the live green, per David 2026-08-27.
     Deliberate deviation: the live gummies PDP renders these #234134 on white text. */
/* display:flex, NOT block. This one line was the whole "not centered" bug.
   The live ATC is a <button> that the theme styles display:flex with
   align-items:center, which is what vertically centres the label. Converting it
   to an <a> for the cart link, I wrote display:block here, which silently
   disabled align-items and dropped the text to the top of the pill: measured
   1.0px above / 29.6px below, so 14.3px too high, against live's 15.3/15.3.
   Every horizontal measurement I took was correct, which is why nine rounds of
   checking gaps and ratios never found it. */
#bbHost a#bbRealAtc{text-decoration:none;cursor:pointer;
  display:flex;align-items:center;justify-content:center}
  /* the gallery rides above the form inside the same 375px context */
  #bbHost .bb-gal{position:relative;overflow:hidden;background:#dfe9cf;aspect-ratio:1/1;margin:0 0 14px}
  #bbHost .bb-gal img{width:100%;height:100%;object-fit:cover;display:block}
  #bbHost .bb-gal img.off{display:none}
  #bbHost .bb-gal .g-nav{position:absolute;top:50%;transform:translateY(-50%);width:36px;height:36px;
    border-radius:50%;background:rgba(35,65,52,.62);color:#fff;border:0;cursor:pointer;
    font-size:18px;line-height:1;display:flex;align-items:center;justify-content:center;padding:0}
  #bbHost .bb-gal .g-prev{left:9px}
  #bbHost .bb-gal .g-next{right:9px}
  #bbHost .bb-gal .g-dots{position:absolute;bottom:9px;left:0;right:0;display:flex;justify-content:center;gap:5px}
  #bbHost .bb-gal .g-dots i{width:6px;height:6px;border-radius:50%;background:rgba(35,65,52,.32)}
  #bbHost .bb-gal .g-dots i.on{background:#234134}

