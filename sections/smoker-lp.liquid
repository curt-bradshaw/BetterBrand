<script>
  /* Sticky CTA reveals once the hero image has scrolled out of view.
     IntersectionObserver drives it; a passive scroll listener
     is a fallback for engines where IO does not fire. Both call the same
     idempotent update(), so whichever runs first wins and the other is a no-op. */
  (function(){
    var el=document.getElementById('sticky'), hero=document.getElementById('hero');
    if(!el||!hero) return;
    var box=document.getElementById('bbHost');
    document.body.classList.add('has-sticky');
    var shown=null, hid=null;
    function update(){
      var on = hero.getBoundingClientRect().bottom <= 0;
      /* Suppress while the real buy box is on screen so the bar never covers
         the control the visitor is meant to use. */
      var hide = false;
      if(box){
        var b=box.getBoundingClientRect();
        hide = b.bottom > 0 && b.top < window.innerHeight;
      }
      if(on!==shown){
        shown=on;
        el.classList.toggle('on',on);
      }
      if(hide!==hid){
        hid=hide;
        el.classList.toggle('hidden-for-box',hide);
      }
      var live = on && !hide;
      el.setAttribute('aria-hidden', live?'false':'true');
      el.setAttribute('tabindex', live?'0':'-1');
    }
    var io=null;
    if('IntersectionObserver' in window){
      io=new IntersectionObserver(update,{threshold:0});
      io.observe(hero);
      if(box) io.observe(box);
    }
    /* Direct passive handler: one rect read plus an early return when the state
       has not changed. Deliberately no rAF throttle, because if rAF never runs
       the throttle flag latches and the bar can never appear. */
    window.addEventListener('scroll', update, {passive:true});
    window.addEventListener('resize', update, {passive:true});
    update();
  })();

  /* Buy box: option select drives the price, the qty label and the cart URL.
     Cart wiring uses the PDP's own variant + selling_plan IDs via the
     /cart/add?id=..&selling_plan=..&return_to=/checkout form. The bare
     /cart/{variant}:{qty}?selling_plan= permalink silently DROPS the plan and
     charges full price, so it is deliberately not used here.
     Shipping cutoff below is a real daily cutoff, not a per-visitor timer.
     TODO confirm the true cutoff hour with fulfilment; set SHIP_CUTOFF_CT. */
  (function(){
    var box = document.getElementById('buybox');
    if(!box) return;
    var opts = [].slice.call(box.querySelectorAll('.bb-opt'));
