  .bb-smoker-labor-day .product p:last-child{margin:0}

  /* top sale strip */
  /* offer block: real price ladder. Restored after being cut with the old sale bar. */
  .bb-smoker-labor-day .offer{border:2px solid var(--green);border-radius:6px;overflow:hidden;margin:28px 0 0}
  .bb-smoker-labor-day .offer .o-head{background:var(--green);color:#fff;text-align:center;padding:13px 16px;
    font-family:'Public Sans',sans-serif;font-weight:800;font-size:16px;letter-spacing:.03em}
  .bb-smoker-labor-day .offer .o-body{padding:6px 18px 18px;background:#fff}
  .bb-smoker-labor-day .offer .row{display:flex;justify-content:space-between;align-items:baseline;gap:12px;
    padding:14px 0;border-bottom:1px solid var(--hair);font-size:17px;line-height:1.5}
  .bb-smoker-labor-day .offer .row:last-of-type{border-bottom:0}
  .bb-smoker-labor-day .offer .row .lbl{font-weight:600;color:var(--ink)}
  .bb-smoker-labor-day .offer .row .val{font-family:'Public Sans',sans-serif;font-weight:800;white-space:nowrap;color:var(--ink)}
  .bb-smoker-labor-day .offer .row.best{background:#f2f7ee;margin:0 -18px;padding:14px 18px}
  .bb-smoker-labor-day .offer .row.best .val{color:var(--green)}
  .bb-smoker-labor-day .offer .tag{display:inline-block;background:var(--green);color:#fff;font-size:10.5px;
    font-weight:800;letter-spacing:.07em;padding:3px 7px;border-radius:3px;margin-left:8px;
    vertical-align:1px;font-family:'Public Sans',sans-serif;white-space:nowrap}
  .bb-smoker-labor-day .offer .o-foot{font-size:15px;color:var(--muted);padding:14px 0 0;line-height:1.8;margin:0}

  /* ============================================================
     BUY BOX - mirrored from the live PDP (Figma node 97:806).
     Real tokens off the capture: green #234134, gold #F2CB49,
     cream #f6edda, mid-green #3f745d. Copy, option labels, badges
     and displayed prices are exactly as the PDP shows them.
     Cart wiring uses the PDP's own variant + selling_plan IDs, so
     checkout behaves identically to the PDP.
     ============================================================ */
  .bb-smoker-labor-day .bb-pdp{--pg:#234134;--pgold:#F2CB49;--pcream:#f6edda;--pmid:#3f745d;
    background:#fff;border:1px solid #e3e0d8;border-radius:10px;
    padding:20px 18px 22px;margin:30px 0 0}
  .bb-smoker-labor-day .bb-pdp .bb-gal{position:relative;margin:-20px -18px 16px;border-radius:10px 10px 0 0;
    overflow:hidden;background:#dfe9cf;aspect-ratio:1/1}
  .bb-smoker-labor-day .bb-pdp .bb-gal img{width:100%;height:100%;object-fit:cover;display:block}
  .bb-smoker-labor-day .bb-pdp .bb-gal img.off{display:none}
  .bb-smoker-labor-day .bb-pdp .bb-gal .g-nav{position:absolute;top:50%;transform:translateY(-50%);
    width:38px;height:38px;border-radius:50%;background:rgba(35,65,52,.62);color:#fff;
    border:0;cursor:pointer;font-size:19px;line-height:1;display:flex;align-items:center;
    justify-content:center;padding:0}
  .bb-smoker-labor-day .bb-pdp .bb-gal .g-nav:hover{background:rgba(35,65,52,.82)}
  .bb-smoker-labor-day .bb-pdp .bb-gal .g-prev{left:10px}
  .bb-smoker-labor-day .bb-pdp .bb-gal .g-next{right:10px}
  .bb-smoker-labor-day .bb-pdp .bb-gal .g-dots{position:absolute;bottom:10px;left:0;right:0;display:flex;
    justify-content:center;gap:6px}
  .bb-smoker-labor-day .bb-pdp .bb-gal .g-dots i{width:7px;height:7px;border-radius:50%;background:rgba(35,65,52,.3)}
  .bb-smoker-labor-day .bb-pdp .bb-gal .g-dots i.on{background:#234134}
  @media (max-width:400px){ .bb-smoker-labor-day .bb-pdp .bb-gal{margin:-18px -14px 14px} }

  .bb-smoker-labor-day .bb-pdp .bb-stars{color:var(--pgold);font-size:16px;letter-spacing:2px;margin:0}
  .bb-smoker-labor-day .bb-pdp .bb-rev{font-family:'Public Sans',sans-serif;font-size:11px;color:#4B4A49;margin:3px 0 10px}
  .bb-smoker-labor-day .bb-pdp h3{font-family:'Public Sans',sans-serif;font-weight:800;font-size:26px;line-height:1.12;
    color:var(--pg);margin:0 0 10px;letter-spacing:-.01em}
  .bb-smoker-labor-day .bb-pdp .bb-dek{font-size:15px;line-height:1.6;color:#3c3c3c;margin:0 0 18px}

  .bb-smoker-labor-day .bb-opt{display:block;position:relative;border:1px solid #d8d5cc;border-radius:9px;
    padding:13px 14px;margin:0 0 11px;cursor:pointer;background:#fff;
    display:flex;align-items:center;gap:12px}
  .bb-smoker-labor-day .bb-opt.sel{border:2px solid var(--pg);box-shadow:0 2px 7px rgba(35,65,52,.16);padding:12px 13px}
  .bb-smoker-labor-day .bb-opt input{position:absolute;opacity:0;pointer-events:none}
  .bb-smoker-labor-day .bb-opt img{width:44px;height:44px;object-fit:contain;border-radius:6px;background:#eaf0e2;flex:0 0 44px}
  .bb-smoker-labor-day .bb-opt .o-name{flex:1;min-width:0;font-family:'Public Sans',sans-serif;font-weight:700;
    font-size:15px;line-height:1.3;color:var(--pg)}
  .bb-smoker-labor-day .bb-opt .o-name small{display:block;font-weight:600;font-size:12.5px;color:var(--pmid);margin-top:2px}
  .bb-smoker-labor-day .bb-opt .o-save{flex:0 0 auto;background:var(--pg);color:#fff;border-radius:999px;
    font-family:'Public Sans',sans-serif;font-weight:800;font-size:11px;letter-spacing:.03em;
    padding:5px 9px;white-space:nowrap}
  .bb-smoker-labor-day .bb-opt .o-price{flex:0 0 auto;font-family:'Public Sans',sans-serif;font-weight:800;
    font-size:16px;color:var(--pg);text-align:right;line-height:1.15;white-space:nowrap}
  .bb-smoker-labor-day .bb-opt .o-price small{display:block;font-weight:600;font-size:10.5px;color:#969696}
  .bb-smoker-labor-day .bb-opt .o-best{position:absolute;top:-11px;left:50%;transform:translateX(-50%);
    background:var(--pgold);color:#252525;border-radius:999px;
    font-family:'Public Sans',sans-serif;font-weight:800;font-size:11px;letter-spacing:.02em;
    padding:4px 12px;white-space:nowrap}
  .bb-smoker-labor-day .bb-opt.sub{flex-wrap:wrap;padding-top:18px}
  .bb-smoker-labor-day .bb-opt.sub .o-terms{flex:1 1 100%;font-size:13px;line-height:1.55;color:#3c3c3c;margin-top:8px}
  .bb-smoker-labor-day .bb-opt.sub .o-terms b{color:var(--pg)}

  .bb-smoker-labor-day .bb-atc{display:flex;align-items:center;justify-content:center;gap:0;
    background:var(--pgold);color:#252525;text-decoration:none;border-radius:999px;
    padding:16px 18px;margin:16px 0 12px;
    font-family:'Public Sans',sans-serif;font-weight:800;letter-spacing:.02em}
  .bb-smoker-labor-day .bb-atc:hover{background:#e6bf42}
  .bb-smoker-labor-day .bb-atc .a-price{font-size:19px;padding-right:14px;border-right:1.5px solid rgba(37,37,37,.35)}
  .bb-smoker-labor-day .bb-atc .a-label{font-size:17px;padding-left:14px;text-transform:uppercase}
  .bb-smoker-labor-day .bb-atc .a-qty{font-size:14px;font-weight:600;padding-left:8px;color:#3c3c3c}

  .bb-smoker-labor-day .bb-hsa{display:flex;justify-content:center;gap:18px;flex-wrap:wrap;
    font-family:'Public Sans',sans-serif;font-size:12px;font-weight:700;color:#252525;margin:0 0 4px}
  .bb-smoker-labor-day .bb-hsa span{font-weight:600;color:#4B4A49}
  .bb-smoker-labor-day .bb-learn{text-align:center;font-size:12px;margin:0 0 18px}
  .bb-smoker-labor-day .bb-learn a{color:#4B4A49;text-decoration:underline}

  .bb-smoker-labor-day .bb-seals{display:flex;justify-content:center;gap:14px;margin:0 0 16px}
  .bb-smoker-labor-day .bb-seals img{width:88px;height:auto;display:block}

  .bb-smoker-labor-day .bb-guar{display:flex;align-items:center;justify-content:center;gap:7px;
    font-family:'Public Sans',sans-serif;font-weight:700;font-size:15px;color:var(--pg);margin:0 0 16px}
  .bb-smoker-labor-day .bb-guar img{width:17px;height:auto}

  .bb-smoker-labor-day .bb-ship{background:var(--pcream);border-radius:6px;text-align:center;padding:11px 14px;margin:0}
  .bb-smoker-labor-day .bb-ship .s-l{font-size:12.5px;color:#3c3c3c;display:block}
  .bb-smoker-labor-day .bb-ship .s-t{font-family:'Public Sans',sans-serif;font-weight:800;font-size:15px;
    color:var(--pg);display:block;margin-top:2px;font-variant-numeric:tabular-nums}

  @media (max-width:400px){
    .bb-smoker-labor-day .bb-pdp{padding:18px 14px 20px}
    .bb-smoker-labor-day .bb-pdp h3{font-size:23px}
    .bb-smoker-labor-day .bb-opt{gap:9px;padding:12px 11px}
    .bb-smoker-labor-day .bb-opt .o-name{font-size:14px}
    .bb-smoker-labor-day .bb-atc .a-price{font-size:17px}
    .bb-smoker-labor-day .bb-atc .a-label{font-size:15px}
    .bb-smoker-labor-day .bb-seals img{width:76px}
  }

  .bb-smoker-labor-day .ps{background:var(--tint);padding:22px 20px;border-radius:4px;margin:30px 0 0;font-size:18px;line-height:1.9}

  /* sticky buy bar. Reads as a Shopify add-to-cart bar: product thumb, a real
     strikethrough price anchor ($34.95 to $27.96), then the button. Urgency comes
     from the saving being concrete, NOT from a countdown, because the 20% is the
     evergreen Subscribe & Save and does not expire. KB rule 29: scarcity must be
     real or it destroys trust. Drop in a countdown only when a real promo exists. */
  .bb-smoker-labor-day .sticky{
    position:fixed;left:0;right:0;bottom:0;z-index:40;
    background:#14291F;border-top:3px solid var(--gold);
    color:#fff;text-decoration:none;
    display:flex;align-items:center;gap:12px;
    padding:10px 14px calc(10px + env(safe-area-inset-bottom));
    box-shadow:0 -6px 22px rgba(0,0,0,.34);
    transform:translateY(105%);opacity:0;pointer-events:none;
    transition:transform .22s ease,opacity .22s ease;
  }
  .bb-smoker-labor-day .sticky.on{transform:translateY(0);opacity:1;pointer-events:auto}
  /* Never sit on top of the real buy box. */
  .bb-smoker-labor-day .sticky.on.hidden-for-box{transform:translateY(105%);opacity:0;pointer-events:none}
  .bb-smoker-labor-day .sticky .s-thumb{flex:0 0 auto;width:50px;height:50px;border-radius:6px;
    object-fit:cover;background:#0d1c15;display:block}
  .bb-smoker-labor-day .sticky .s-left{flex:1;min-width:0}
  .bb-smoker-labor-day .sticky .s-save{display:inline-block;background:var(--gold);color:#20241f;
    font-family:'Public Sans',sans-serif;font-weight:800;font-size:12px;
    letter-spacing:.05em;text-transform:uppercase;padding:2px 6px;border-radius:3px;
    margin-bottom:3px}
  .bb-smoker-labor-day .sticky .s-price{display:block;font-family:'Public Sans',sans-serif;font-weight:800;
    font-size:19px;line-height:1.1;letter-spacing:-.01em;white-space:nowrap;
    overflow:hidden;text-overflow:ellipsis}
  .bb-smoker-labor-day .sticky .s-price s{font-weight:600;font-size:15px;color:rgba(255,255,255,.55);
    margin-right:6px;text-decoration-thickness:1.5px}
  .bb-smoker-labor-day .sticky .s-sub{display:block;font-family:'Poppins',sans-serif;font-size:12.5px;
    line-height:1.2;margin-top:1px;color:rgba(255,255,255,.72);white-space:nowrap;
    overflow:hidden;text-overflow:ellipsis}
  .bb-smoker-labor-day .sticky .s-btn{flex:0 0 auto;background:var(--gold);color:#20241f;border-radius:6px;
    font-family:'Public Sans',sans-serif;font-weight:800;font-size:16px;letter-spacing:.03em;
    padding:14px 16px;white-space:nowrap;text-transform:uppercase;
    box-shadow:0 2px 0 #a8801c, 0 3px 10px rgba(0,0,0,.3);
    animation:sbeat 2.4s ease-in-out infinite}
  .bb-smoker-labor-day .sticky:hover .s-btn{background:#e6bc3c}
  .bb-smoker-labor-day .sticky:active .s-btn{transform:translateY(2px);box-shadow:0 0 0 #a8801c}
  @keyframes sbeat{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}
  @media (prefers-reduced-motion:reduce){ .bb-smoker-labor-day .sticky .s-btn{animation:none} }
  @media (max-width:520px){
    .bb-smoker-labor-day .sticky{gap:9px;padding-left:11px;padding-right:11px}
    .bb-smoker-labor-day .sticky .s-thumb{width:44px;height:44px}
    .bb-smoker-labor-day .sticky .s-price{font-size:17.5px}
    .bb-smoker-labor-day .sticky .s-sub{display:none}
    .bb-smoker-labor-day .sticky .s-btn{font-size:15px;padding:13px 13px}
  }
  .bb-smoker-labor-day{padding-bottom:0}
  body.has-sticky .bb-smoker-labor-day{padding-bottom:92px}

  :where(.bb-smoker-labor-day) footer{background:var(--tint);margin-top:34px;padding:26px 0 44px}
  .bb-smoker-labor-day footer .fw{max-width:var(--maxw);margin:0 auto;padding:0 18px}
  :where(.bb-smoker-labor-day) footer p{font-family:'Open Sans',sans-serif;font-size:14px;line-height:1.85;color:var(--muted);margin:0 0 14px}
  .bb-smoker-labor-day footer .hard{font-weight:700;color:var(--body);text-transform:uppercase;font-size:13px;letter-spacing:.02em}
  :where(.bb-smoker-labor-day) footer a{color:var(--muted)}

  @media (min-width:700px){
    .bb-smoker-labor-day{font-size:20px;line-height:1.95}
    :where(.bb-smoker-labor-day) h1{font-size:42px}
    :where(.bb-smoker-labor-day) h2{font-size:33px}
    .bb-smoker-labor-day .pullquote{font-size:23px}
  }

  /* The PDP buy box CSS is deliberately NOT shipped here. On-domain the theme
   already defines .plan-card / .plan-badge / .subscription-card /
   .btn-add-tocart, so the box inherits the real styling and the real
   bookmania + SuisseIntlMono webfonts for free. */
{% endstylesheet %}

