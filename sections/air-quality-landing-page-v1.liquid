  <script>
    (function () {
      var root = document.currentScript.previousElementSibling;
      // walk back to find .aqv3
      while (root && !root.classList.contains('aqv3')) root = root.previousElementSibling;
      if (!root) root = document;
  
      root.querySelectorAll('.product-thumb').forEach(function (btn) {
        btn.addEventListener('click', function () {
          root.querySelectorAll('.product-thumb').forEach(function (b) { b.classList.remove('is-selected'); });
          btn.classList.add('is-selected');
          var src = btn.dataset.src;
          var img = root.querySelector('#aqv3-product-main-img');
          if (src && img) img.src = src;
          // Hide promo badge when viewing non-hero slides
          var badge = root.querySelector('[data-aqv3-promo-badge]');
          if (badge) badge.style.display = /product-hero\.webp/.test(src || '') ? '' : 'none';
        });
      });
  
      var cd = root.querySelector('#aqv3-countdown');
      if (cd) {
        var seconds = 2 * 60 * 60;
        function tick() {
          var h = Math.floor(seconds / 3600);
          var m = Math.floor((seconds % 3600) / 60);
          var s = seconds % 60;
          cd.textContent = h + ':' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
          if (seconds > 0) seconds--;
        }
        tick(); setInterval(tick, 1000);
      }
  
      // Buy box — form-based, same mechanism as PDP swatch-plans.liquid
      var variantInput  = root.querySelector('#aqv3-variant-id');
      var planInput     = root.querySelector('#aqv3-selling-plan');
      var bbCta         = root.querySelector('#aqv3-bb-cta');
      var planCards     = root.querySelectorAll('.plan-card');
      var subGroups     = root.querySelectorAll('.subscription-group');
      var allSubCards   = root.querySelectorAll('.subscription-card');
      var priceEl       = bbCta ? bbCta.querySelector('.bb-cta-price') : null;
      var countEl       = bbCta ? bbCta.querySelector('.bb-cta-count') : null;

      function updateCTA(total, qty) {
        if (priceEl && !isNaN(total)) priceEl.textContent = '$' + total.toFixed(2);
        if (countEl) countEl.textContent = '(' + qty + ' Item' + (qty === 1 ? '' : 's') + ')';
      }

      if (variantInput && planInput && planCards.length) {
        // Variant card click — switch variant, clear subscription
        planCards.forEach(function (card) {
          card.addEventListener('click', function () {
            variantInput.value = card.dataset.variantId;
            planInput.value = '';

            planCards.forEach(function (c) { c.classList.remove('active'); c.setAttribute('aria-checked', 'false'); });
            card.classList.add('active');
            card.setAttribute('aria-checked', 'true');

            allSubCards.forEach(function (c) { c.classList.remove('active'); c.setAttribute('aria-checked', 'false'); });

            subGroups.forEach(function (g) {
              g.hidden = g.dataset.variantId !== card.dataset.variantId;
            });

            updateCTA(parseFloat(card.dataset.total || '0'), parseInt(card.dataset.qty || '1', 10));
          });
        });

        // Subscription card click — set selling plan input (same as swatch-plans.liquid)
        allSubCards.forEach(function (card) {
          card.addEventListener('click', function () {
            var radio = card.querySelector('input[type="radio"]');
            if (radio) planInput.value = radio.value;

            planCards.forEach(function (c) { c.classList.remove('active'); c.setAttribute('aria-checked', 'false'); });
            allSubCards.forEach(function (c) { c.classList.remove('active'); c.setAttribute('aria-checked', 'false'); });
            card.classList.add('active');
            card.setAttribute('aria-checked', 'true');

            // Price: cents → dollars; qty from the subscription-group's data-qty
            var group = card.closest('.subscription-group');
            var qty = group ? parseInt(group.dataset.qty || '1', 10) : 1;
            var priceCents = parseInt(card.dataset.price || '0', 10);
            updateCTA(priceCents / 100, qty);
          });
        });

        // Init CTA price from the initially active plan card
        var initCard = root.querySelector('.plan-card.active') || planCards[0];
        if (initCard) updateCTA(parseFloat(initCard.dataset.total || '0'), parseInt(initCard.dataset.qty || '1', 10));
      }

      // Intercept form submit → add to cart via AJAX then redirect straight to checkout
      var productForm = root.querySelector('#aqv3-product-form');
      if (productForm) {
        productForm.addEventListener('submit', function (e) {
          e.preventDefault();
          fetch('/cart/add.js', { method: 'POST', body: new FormData(productForm) })
            .then(function (r) { return r.json(); })
            .then(function () { window.location.href = '/checkout'; })
            .catch(function () { productForm.submit(); });
        });
      }
  
      var sfModal = root.querySelector('[data-aqv3-suppfacts-modal]');
      var sfOpen = root.querySelector('[data-aqv3-suppfacts-open]');
      var sfClose = root.querySelector('[data-aqv3-suppfacts-close]');
      if (sfModal && sfOpen) {
        var openSf = function () { sfModal.classList.add('is-open'); sfModal.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; };
        var closeSf = function () { sfModal.classList.remove('is-open'); sfModal.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; };
        sfOpen.addEventListener('click', function (e) { e.preventDefault(); openSf(); });
        sfClose && sfClose.addEventListener('click', closeSf);
        sfModal.addEventListener('click', function (e) { if (e.target === sfModal) closeSf(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeSf(); });
      }
  
      var toggle = root.querySelector('.nav-toggle');
      if (toggle) {
        toggle.addEventListener('click', function () {
          var links = root.querySelector('.nav-links');
          if (!links) return;
          var isOpen = links.dataset.open === '1';
          if (isOpen) {
            links.removeAttribute('style');
            links.dataset.open = '0';
          } else {
            Object.assign(links.style, {
              display: 'flex', position: 'absolute', top: '64px', left: '0', right: '0',
              background: '#fff', flexDirection: 'column', padding: '20px',
              borderBottom: '1px solid #e5e5e5', zIndex: '40', gap: '12px',
            });
            links.dataset.open = '1';
          }
        });
      }
    })();
  
    /* Testimonial videos — inline play, lazy-load src on first click, pause others */
    (function() {
      const cards = document.querySelectorAll('.aqv3 .testi-video-card');
      if (!cards.length) return;
      cards.forEach(card => {
        const video = card.querySelector('video');
        const playOverlay = card.querySelector('.testi-play');
        const handlePlay = () => {
          cards.forEach(other => {
            if (other !== card) {
              const v = other.querySelector('video');
              if (v && !v.paused) v.pause();
              other.classList.remove('is-playing');
            }
          });
          if (!video.src) { video.src = card.dataset.src; video.controls = true; }
          video.play().catch(() => {});
          card.classList.add('is-playing');
        };
        playOverlay.addEventListener('click', handlePlay);
        card.addEventListener('click', () => { if (!video.src) handlePlay(); });
        video.addEventListener('play', () => card.classList.add('is-playing'));
        video.addEventListener('pause', () => card.classList.remove('is-playing'));
        video.addEventListener('ended', () => card.classList.remove('is-playing'));
      });
    })();
  </script>
  
