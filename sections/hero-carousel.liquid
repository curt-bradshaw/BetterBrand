<!-- start banner-style3.liquid (SECTION) -->

{%- assign image_desktop = section.settings.homepage_banner_style_3 -%}
{%- assign padding_top_desktop = image_desktop.height | plus: 0.0 | divided_by: image_desktop.width | times: 100.0 -%}
{%- assign image_mobile = section.settings.mobile_banner_style_3 -%}
{%- assign padding_top_mobile = image_mobile.height | plus: 0.0 | divided_by: image_mobile.width | times: 100.0 -%}

{%- if section.settings.homepage_banner_style_3 == blank -%}
  {%- assign padding_top_desktop = 40 -%}
{%- endif -%}

{%- if section.settings.mobile_banner_style_3 == blank -%}
  {%- assign padding_top_mobile = 55 -%}
{%- endif -%}

{%- assign image_desktop_width = 1440 -%}
{%- assign image_desktop_height = image_desktop_width | divided_by: image_desktop.aspect_ratio -%}
{%- assign desktop_widths = '2500,2000,1800,1500,1400,1300,1200,1100,1000,900,800' | split: ',' -%}
{%- assign mobile_widths = '900,800,700,600,500,400' | split: ',' -%}
{%- assign enable_lazy = section.settings.enable_lazy_load -%}
{% capture banner_content %}
    {%- if section.settings.enable_carousel and section.blocks.size > 0 -%}
      <hero-carousel class="hero-carousel" data-autoplay="{{ section.settings.carousel_autoplay }}" data-interval="{{ section.settings.carousel_interval | times: 1000 }}">
        <div class="hero-carousel__track">
          <div class="hero-carousel__slide is-active" data-hero-carousel-slide>
            <section class="homepage-style-3 banner-style-3-{{ section.id }} {{ section.settings.custom_class }} ">
              <div class="title-banner-3-{{ section.id }} banner-style-3-titles">
                <a href="{{ section.settings.homepage_banner_link | default: '#' }}" class="banner-style-3-titles-link"></a>
                {%- if section.settings.enable_h1 -%}
                  {% if section.settings.homepage_banner_text != blank %}
                      <h1 class="banner-title">{{ section.settings.homepage_banner_text }}</h1>
                  {% else %}
                      <h1 class="banner-title hide">Banner-Desktop-{{ section.id }}</h1>
                  {% endif %}
                {%- else -%}
                  {% if section.settings.homepage_banner_text != blank %}
                      <h2 class="banner-title">{{ section.settings.homepage_banner_text }}</h2>
                  {% else %}
                      <h2 class="banner-title hide">{{ section.settings.homepage_banner_text }}</h2>
                  {% endif %}
                {%- endif -%}
                  <div class="banner-sub-title" >{{ section.settings.main_banner_sub_title }}</div>
              </div>

              <a class="banner-img background-banner-style-3-{{ section.id }} {% if section.settings.enable_custom_banner_height == false %} banner-padding-top-desktop{% endif %}{% if section.settings.enable_custom_banner_height == false %} banner-padding-top-mobile{% endif %}" href="{{ section.settings.homepage_banner_link | default: '#' }}">
                {% if section.settings.homepage_banner_style_3 != blank %}
                  <picture>
                    {%- assign default_image = section.settings.homepage_banner_style_3 -%}
                    <source data-class="LazyLoad" media="(min-width: 768px)" {% if enable_lazy %}data-{% endif %}srcset="
                      {%- for desktop_width in desktop_widths -%}
                        https:{{- default_image | image_url: width: desktop_width }} {{ desktop_width }}w,
                      {%- endfor -%}
                    "/>

                    {%- if section.settings.mobile_banner_style_3 != blank -%}
                      {%- assign default_image = section.settings.mobile_banner_style_3 -%}
                    {%- endif -%}

                    <source data-class="LazyLoad" media="(max-width: 767px)" {% if enable_lazy %}data-{% endif %}srcset="
                      {%- for mobile_width in mobile_widths -%}
                        https:{{- default_image | image_url: width: mobile_width }} {{ mobile_width }}w,
                      {%- endfor -%}
                    "/>
                    <img  class="banner-link__image" width="{{ image_desktop_width }}" height="{{ image_desktop_height }}" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" alt="Banner"/>
                  </picture>
                {% else %}
                  {%-
                    render 'responsive-image' with
                    placeholder: 'lifestyle-2',
                    class: 'banner-link__image'
                  -%}
                {% endif %}
              </a>
            </section>
          </div>

          {%- for block in section.blocks -%}
            <div class="hero-carousel__slide" data-hero-carousel-slide {{ block.shopify_attributes }}>
              <section class="homepage-style-3 banner-style-3-{{ section.id }} {{ section.settings.custom_class }} ">
                <div class="title-banner-3-{{ section.id }} banner-style-3-titles">
                  <a href="{{ block.settings.slide_link | default: '#' }}" class="banner-style-3-titles-link"></a>
                  {% if block.settings.slide_heading != blank %}
                      <h2 class="banner-title">{{ block.settings.slide_heading }}</h2>
                  {% else %}
                      <h2 class="banner-title hide">{{ block.settings.slide_heading }}</h2>
                  {% endif %}
                    <div class="banner-sub-title" >{{ block.settings.slide_subheading }}</div>
                </div>

                <a class="banner-img background-banner-style-3-{{ section.id }} {% if section.settings.enable_custom_banner_height == false %} banner-padding-top-desktop{% endif %}{% if section.settings.enable_custom_banner_height == false %} banner-padding-top-mobile{% endif %}" href="{{ block.settings.slide_link | default: '#' }}">
                  {% if block.settings.slide_image != blank %}
                    <picture>
                      {%- assign default_image = block.settings.slide_image -%}
                      <source data-class="LazyLoad" media="(min-width: 768px)" {% if enable_lazy %}data-{% endif %}srcset="
                        {%- for desktop_width in desktop_widths -%}
                          https:{{- default_image | image_url: width: desktop_width }} {{ desktop_width }}w,
                        {%- endfor -%}
                      "/>

                      {%- if block.settings.slide_mobile_image != blank -%}
                        {%- assign default_image = block.settings.slide_mobile_image -%}
                      {%- endif -%}

                      <source data-class="LazyLoad" media="(max-width: 767px)" {% if enable_lazy %}data-{% endif %}srcset="
                        {%- for mobile_width in mobile_widths -%}
                          https:{{- default_image | image_url: width: mobile_width }} {{ mobile_width }}w,
                        {%- endfor -%}
                      "/>
                      <img class="banner-link__image" width="{{ image_desktop_width }}" height="{{ image_desktop_height }}" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" alt="{{ block.settings.slide_heading | default: 'Banner' | escape }}"/>
                    </picture>
                  {% else %}
                    {%-
                      render 'responsive-image' with
                      placeholder: 'lifestyle-2',
                      class: 'banner-link__image'
                    -%}
                  {% endif %}
                </a>
              </section>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.carousel_show_arrows or section.settings.carousel_show_dots -%}
          <div class="hero-carousel__controls">
            {%- if section.settings.carousel_show_arrows -%}
              <button type="button" class="hero-carousel__arrow hero-carousel__arrow--prev" aria-label="Previous slide" data-hero-carousel-prev>&lsaquo;</button>
            {%- endif -%}

            {%- if section.settings.carousel_show_dots -%}
              <div class="hero-carousel__dots" role="tablist" aria-label="Hero carousel slides">
                <button type="button" class="hero-carousel__dot is-active" aria-label="Go to slide 1" data-hero-carousel-dot></button>
                {%- for block in section.blocks -%}
                  <button type="button" class="hero-carousel__dot" aria-label="Go to slide {{ forloop.index | plus: 1 }}" data-hero-carousel-dot></button>
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- if section.settings.carousel_show_arrows -%}
              <button type="button" class="hero-carousel__arrow hero-carousel__arrow--next" aria-label="Next slide" data-hero-carousel-next>&rsaquo;</button>
            {%- endif -%}
          </div>
        {%- endif -%}
      </hero-carousel>
    {%- else -%}
      <section class="homepage-style-3 banner-style-3-{{ section.id }} {{ section.settings.custom_class }} ">
        <div class="title-banner-3-{{ section.id }} banner-style-3-titles">
          <a href="{{ section.settings.homepage_banner_link | default: '#' }}" class="banner-style-3-titles-link"></a>
          {%- if section.settings.enable_h1 -%}
            {% if section.settings.homepage_banner_text != blank %}
                <h1 class="banner-title">{{ section.settings.homepage_banner_text }}</h1>
            {% else %}
                <h1 class="banner-title hide">Banner-Desktop-{{ section.id }}</h1>
            {% endif %}
          {%- else -%}
            {% if section.settings.homepage_banner_text != blank %}
                <h2 class="banner-title">{{ section.settings.homepage_banner_text }}</h2>
            {% else %}
                <h2 class="banner-title hide">{{ section.settings.homepage_banner_text }}</h2>
            {% endif %}
          {%- endif -%}
            <div class="banner-sub-title" >{{ section.settings.main_banner_sub_title }}</div>
        </div>

        <a class="banner-img background-banner-style-3-{{ section.id }} {% if section.settings.enable_custom_banner_height == false %} banner-padding-top-desktop{% endif %}{% if section.settings.enable_custom_banner_height == false %} banner-padding-top-mobile{% endif %}" href="{{ section.settings.homepage_banner_link | default: '#' }}">
          {% if section.settings.homepage_banner_style_3 != blank %}
            <picture>
              {%- assign default_image = section.settings.homepage_banner_style_3 -%}
              <source data-class="LazyLoad" media="(min-width: 768px)" {% if enable_lazy %}data-{% endif %}srcset="
                {%- for desktop_width in desktop_widths -%}
                  https:{{- default_image | image_url: width: desktop_width }} {{ desktop_width }}w,
                {%- endfor -%}
              "/>

              {%- if section.settings.mobile_banner_style_3 != blank -%}
                {%- assign default_image = section.settings.mobile_banner_style_3 -%}
              {%- endif -%}

              <source data-class="LazyLoad" media="(max-width: 767px)" {% if enable_lazy %}data-{% endif %}srcset="
                {%- for mobile_width in mobile_widths -%}
                  https:{{- default_image | image_url: width: mobile_width }} {{ mobile_width }}w,
                {%- endfor -%}
              "/>
              <img  class="banner-link__image" width="{{ image_desktop_width }}" height="{{ image_desktop_height }}" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" alt="Banner"/>
            </picture>
          {% else %}
            {%-
              render 'responsive-image' with
              placeholder: 'lifestyle-2',
              class: 'banner-link__image'
            -%}
          {% endif %}
        </a>
      </section>
    {%- endif -%}
{% endcapture %}

{% if section.settings.vasta_banner_width == 'full_width' %}
  {{ banner_content }}
{% else %}
  {% if section.settings.vasta_banner_width == 'keep_image_size' %}
    {{ banner_content }}
  {% else %}
    <div class="wrapper">
      {{ banner_content }}
    </div>
  {% endif %}
{% endif %}

