{%- comment -%}
  US vs Them — head-to-head comparison matrix
  ------------------------------------------------------------------
  Rebuilt as a TWO-column comparison (US vs THEM) so it reads clearly
  on mobile with zero horizontal scroll, sliders or pagination JS.

  Copywriting is informed by docs/copywriter_knowledge_base.md:
    - Polarization / "us vs them" takeaway framing (Kennedy)
    - Loss-vs-gain contrast framing (Kahneman)
    - Specificity over superlatives (Hopkins / Ogilvy / Bencivenga)
    - Unity + default bias via a "Recommended" badge (Cialdini)
    - One big idea, skimmable System-1 layout (Schwartz / Kahneman)

  Data model (unchanged from the original so existing content maps over):
    - "feature" blocks  -> one row label each, in order
    - "brand" blocks    -> one column each; "values" textarea holds one
                           value per line, aligned to the feature order.
                           Supported tokens: check | x | stars:5 | text
  Built for exactly two brand columns (Us + Them).
{%- endcomment -%}

{%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
{%- assign brand_blocks = section.blocks | where: 'type', 'brand' -%}
{%- assign brand_count = brand_blocks.size -%}

<section
  class="usvt"
  style="
    --usvt-bg: {{ section.settings.bg_color }};
    --usvt-panel: {{ section.settings.panel_color }};
    --usvt-highlight: {{ section.settings.highlight_color }};
    --usvt-accent: {{ section.settings.accent_color }};
    --usvt-text: {{ section.settings.text_color }};
    --usvt-radius: {{ section.settings.corner_radius }}px;
    {% if section.settings.background %}background-image: url({{ section.settings.background | image_url: width: 2400 }});{% endif %}
  "
>
  {%- if section.settings.background -%}
    <div class="usvt__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  {%- endif -%}

  <div class="usvt__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="usvt__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="usvt__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="usvt__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div
      class="usvt__grid"
      style="--usvt-cols: {{ brand_count }};"
      role="table"
      aria-label="{{ section.settings.heading | escape }}"
    >
      {%- comment -%} ---------- Header row ---------- {%- endcomment -%}
      <div class="usvt__headcell usvt__col--label" role="columnheader"></div>
      {%- for brand in brand_blocks -%}
        <div
          class="usvt__headcell usvt__col--brand{% if brand.settings.highlight %} is-highlight{% endif %}"
          role="columnheader"
        >
          {%- if brand.settings.badge != blank -%}
            <span class="usvt__badge">{{ brand.settings.badge }}</span>
          {%- endif -%}
          {%- if brand.settings.logo -%}
            <img
              class="usvt__logo"
              src="{{ brand.settings.logo | image_url: width: 360 }}"
              alt="{{ brand.settings.logo.alt | default: brand.settings.title | escape }}"
              loading="lazy"
              width="180"
            >
          {%- elsif brand.settings.logo_url != blank -%}
            <img
              class="usvt__logo"
              src="{{ brand.settings.logo_url }}"
              alt="{{ brand.settings.title | escape }}"
              loading="lazy"
            >
          {%- elsif brand.settings.highlight -%}
            <img
              class="usvt__logo"
              src="{{ 'betterbrand-wordmark.svg' | asset_url }}"
              alt="{{ brand.settings.title | escape }}"
              loading="lazy"
            >
          {%- else -%}
            <span class="usvt__brandname">{{ brand.settings.title }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- comment -%} ---------- Feature rows ---------- {%- endcomment -%}
      {%- for feature in feature_blocks -%}
        {%- assign ridx = forloop.index0 -%}
        {%- assign last_row = forloop.last -%}
        <div class="usvt__cell usvt__col--label{% if last_row %} is-last{% endif %}" role="rowheader">
          <span class="usvt__label">{{ feature.settings.label }}</span>
        </div>

        {%- for brand in brand_blocks -%}
          {%- assign vals = brand.settings.values | strip | newline_to_br | split: '<br />' -%}
          {%- assign raw = vals[ridx] | default: '' | strip -%}
          {%- assign token = raw | downcase -%}
          <div
            class="usvt__cell usvt__col--brand{% if brand.settings.highlight %} is-highlight{% endif %}{% if last_row %} is-last{% endif %}"
            role="cell"
          >
            {%- if token == 'check' or token == 'true' or token == 'yes' or token == '✓' -%}
              <span class="usvt__icon usvt__icon--yes" aria-label="Yes" role="img">
                <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
                  <path d="M5 13l4 4L19 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            {%- elsif token == 'x' or token == 'false' or token == 'no' or token == '✕' -%}
              <span class="usvt__icon usvt__icon--no" aria-label="No" role="img">
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
                  <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
              </span>
            {%- elsif token contains 'stars' -%}
              {%- assign star_count = raw | split: ':' | last | plus: 0 -%}
              <span class="usvt__stars" aria-label="{{ star_count }} out of 5 stars" role="img">
                {%- for i in (1..5) -%}
                  <span class="usvt__star{% if i > star_count %} is-empty{% endif %}">★</span>
                {%- endfor -%}
              </span>
            {%- else -%}
              <span class="usvt__value">{{ raw }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_text != blank and section.settings.cta_url != blank -%}
      <div class="usvt__cta-wrap">
        <a class="usvt__cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .usvt {
    position: relative;
    padding: 56px 18px;
    background-color: var(--usvt-bg, #1e3b2d);
    background-size: cover;
    background-position: center;
    color: var(--usvt-text, #ffffff);
    -webkit-font-smoothing: antialiased;
  }
  .usvt__overlay {
    position: absolute;
    inset: 0;
    background: #0b1812;
    z-index: 0;
  }
  .usvt__inner {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
  }

  /* ---------- Header copy ---------- */
  .usvt__head {
    text-align: center;
    margin-bottom: 36px;
  }
  .usvt__title {
    margin: 0 0 12px;
    font-family: var(--bookmaniaFont, 'Bookmania', Georgia, 'Times New Roman', serif);
    font-size: clamp(28px, 6vw, 42px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0.4px;
  }
  .usvt__sub {
    margin: 0 auto;
    max-width: 520px;
    font-size: clamp(14px, 3.3vw, 17px);
    line-height: 1.5;
    opacity: 0.85;
  }

  /* ---------- Grid ---------- */
  .usvt__grid {
    display: grid;
    grid-template-columns: minmax(74px, 0.72fr) repeat(var(--usvt-cols, 2), minmax(0, 1fr));
    column-gap: 10px;
    row-gap: 0;
  }

  .usvt__headcell,
  .usvt__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px 12px;
    min-height: 72px;
    overflow-wrap: break-word;
  }

  /* ---------- Label column: transparent, left-aligned ---------- */
  .usvt__col--label {
    justify-content: flex-start;
    text-align: left;
    background: transparent;
    padding-left: 2px;
    padding-right: 10px;
  }
  .usvt__col--label:not(.is-last) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .usvt__label {
    font-family: var(--bookmaniaFont, 'Bookmania', Georgia, serif);
    font-weight: 600;
    font-size: clamp(12px, 3.1vw, 16px);
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.9);
  }

  /* ---------- Brand columns: floating cards ---------- */
  .usvt__col--brand {
    background: var(--usvt-panel, #0d2018);
  }
  .usvt__col--brand.is-highlight {
    background: var(--usvt-highlight, #3f745d);
  }
  .usvt__col--brand:not(.is-last) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Header cells */
  .usvt__headcell {
    position: relative;
    min-height: 96px;
    padding-top: 22px;
    padding-bottom: 16px;
    padding-left: 8px;
    padding-right: 8px;
  }
  .usvt__brandname {
    font-family: var(--bookmaniaFont, 'Bookmania', Georgia, serif);
    font-size: clamp(12.5px, 3.2vw, 18px);
    font-weight: 700;
    letter-spacing: 0.3px;
    line-height: 1.2;
    text-transform: uppercase;
    word-break: keep-all;
    overflow-wrap: normal;
    hyphens: none;
  }
  .usvt__col--brand.is-highlight .usvt__brandname {
    color: #ffffff;
  }
  .usvt__logo {
    max-height: 38px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
  }
  /* Brand wordmark renders in white on the highlighted card */
  .usvt__col--brand.is-highlight .usvt__logo {
    filter: brightness(0) invert(1);
  }
  .usvt__badge {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    background: var(--usvt-accent, #f2c94c);
    color: #16271d;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 999px;
  }

  /* Value cells */
  .usvt__cell {
    font-size: clamp(12.5px, 3.3vw, 15px);
    font-weight: 600;
    line-height: 1.3;
  }
  .usvt__value {
    display: block;
  }
  .usvt__col--brand.is-highlight .usvt__value {
    color: var(--usvt-accent, #f2c94c);
    font-weight: 700;
  }
  .usvt__col--brand:not(.is-highlight) .usvt__value {
    color: rgba(255, 255, 255, 0.72);
  }

  /* Check / cross icons */
  .usvt__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .usvt__icon--yes {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--usvt-accent, #f2c94c);
    color: #16271d;
  }
  .usvt__icon--no {
    width: 26px;
    height: 26px;
    color: rgba(255, 255, 255, 0.38);
  }

  /* Stars */
  .usvt__stars {
    display: inline-flex;
    gap: 2px;
    font-size: clamp(12px, 3.4vw, 16px);
    white-space: nowrap;
  }
  .usvt__star {
    color: rgba(255, 255, 255, 0.4);
  }
  .usvt__col--brand.is-highlight .usvt__star {
    color: var(--usvt-accent, #f2c94c);
  }
  .usvt__star.is-empty {
    opacity: 0.3;
  }

  /* ---------- Card rounding (each brand column is its own card) ---------- */
  .usvt__headcell.usvt__col--brand {
    border-top-left-radius: var(--usvt-radius, 18px);
    border-top-right-radius: var(--usvt-radius, 18px);
  }
  .usvt__cell.usvt__col--brand.is-last {
    border-bottom-left-radius: var(--usvt-radius, 18px);
    border-bottom-right-radius: var(--usvt-radius, 18px);
  }
  /* Elevate the highlighted card */
  .usvt__col--brand.is-highlight {
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.30);
  }

  /* ---------- CTA ---------- */
  .usvt__cta-wrap {
    text-align: center;
    margin-top: 34px;
  }
  .usvt__cta {
    display: inline-block;
    background: var(--usvt-accent, #f2c94c);
    color: #16271d;
    font-weight: 800;
    letter-spacing: 0.4px;
    text-decoration: none;
    padding: 15px 38px;
    border-radius: 999px;
    transition: transform 0.15s ease, filter 0.15s ease;
  }
  .usvt__cta:hover {
    filter: brightness(1.05);
    transform: translateY(-1px);
  }

  @media (min-width: 750px) {
    .usvt { padding: 84px 24px; }
    .usvt__head { margin-bottom: 48px; }
    .usvt__grid { column-gap: 14px; }
    .usvt__headcell, .usvt__cell { padding-left: 18px; padding-right: 18px; }
    .usvt__col--label { padding-left: 6px; }
  }
</style>

{% schema %}
{
  "name": "US vs Them",
  "tag": "section",
  "class": "section-us-vs-them",
  "settings": [
    { "type": "text", "id": "heading", "label": "Title", "default": "US Vs. THEM" },
    { "type": "textarea", "id": "subheading", "label": "Subtitle", "default": "Best-Rated. Doctor-Formulated. Works or Your Money Back." },
    { "type": "image_picker", "id": "background", "label": "Background image (optional)" },
    { "type": "range", "id": "overlay_opacity", "label": "Background overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 70 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1e3b2d" },
    { "type": "color", "id": "panel_color", "label": "Cell panels (Them)", "default": "#0d2018" },
    { "type": "color", "id": "highlight_color", "label": "Highlight column (Us)", "default": "#3f745d" },
    { "type": "color", "id": "accent_color", "label": "Accent (checks, stars, values)", "default": "#f2c94c" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 28, "step": 2, "unit": "px", "default": 18 },
    { "type": "header", "content": "Call to action (optional)" },
    { "type": "text", "id": "cta_text", "label": "Button label" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "label", "label": "Row label" }
      ]
    },
    {
      "type": "brand",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Brand logo (optional)" },
        { "type": "text", "id": "logo_url", "label": "Logo image URL (optional)", "info": "Used if no Brand logo image is selected" },
        { "type": "text", "id": "title", "label": "Column name" },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "info": "Small pill shown above the name, e.g. RECOMMENDED" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight this column", "default": false },
        { "type": "textarea", "id": "values", "label": "Values (one per line)", "info": "Aligned to the comparison rows, top to bottom. Use: check | x | stars:5 | or any text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "US vs Them",
      "blocks": [
        { "type": "feature", "settings": { "label": "Approach" } },
        { "type": "feature", "settings": { "label": "Customer Feedback" } },
        { "type": "feature", "settings": { "label": "Research-Backed" } },
        { "type": "feature", "settings": { "label": "Clean Ingredients" } },
        { "type": "feature", "settings": { "label": "Money-Back Guarantee" } },
        { "type": "brand", "settings": { "title": "BETTERBRAND", "highlight": true, "values": "Doctor-Formulated\nstars:5\ncheck\ncheck\ncheck" } },
        { "type": "brand", "settings": { "title": "Other Brands", "highlight": false, "values": "Trendy Ingredients\nstars:2\n?\nx\nx" } }
      ]
    }
  ]
}
{% endschema %}