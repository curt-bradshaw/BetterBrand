<script>
  // ===== Product thumb swap =====
  (function () {
    const mainImg = document.getElementById('product-main-img');
    if (!mainImg) return;
    document.querySelectorAll('.product-thumb').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        document.querySelectorAll('.product-thumb').forEach(b => b.classList.remove('is-selected'));
        btn.classList.add('is-selected');
        const src = btn.dataset.src;
        if (src) mainImg.src = src;
        // hide promo badge on non-hero slides
        const badge = document.querySelector('[data-aqv3-promo-badge]');
        if (badge) badge.style.display = /product-hero\.webp$/.test(src || '') ? '' : 'none';
      });
    });
  })();

  // ===== Buy box — form-based ATC, mirrors air-quality-landing-page-v1.liquid =====
  // Posts to /cart/add with hidden id + selling_plan inputs, then redirects to /checkout.
  (function () {
    const form         = document.getElementById('aqv3-product-form');
    if (!form) return;
    const variantInput = form.querySelector('#aqv3-variant-id');
    const planInput    = form.querySelector('#aqv3-selling-plan');
    const cta          = form.querySelector('#aqv3-bb-cta');
    const planCards    = form.querySelectorAll('.plan-card');
    const subGroups    = form.querySelectorAll('.subscription-group');
    const allSubCards  = form.querySelectorAll('.subscription-card');
    const priceEl      = cta ? cta.querySelector('.bb-cta-price') : null;
    const countEl      = cta ? cta.querySelector('.bb-cta-count') : null;

    function updateCTA(total, qty) {
      if (priceEl && Number.isFinite(total)) priceEl.textContent = '$' + total.toFixed(2);
      if (countEl) countEl.textContent = '(' + qty + ' Item' + (qty === 1 ? '' : 's') + ')';
    }

    // OTP plan card click — switch variant, clear subscription, show matching sub group.
    planCards.forEach(card => {
      card.addEventListener('click', (e) => {
        e.preventDefault();
        if (variantInput) variantInput.value = card.dataset.variantId || '';
        if (planInput) planInput.value = '';

        planCards.forEach(c => { c.classList.remove('active'); c.setAttribute('aria-checked', 'false'); });
        card.classList.add('active');
        card.setAttribute('aria-checked', 'true');

        allSubCards.forEach(c => { c.classList.remove('active'); c.setAttribute('aria-checked', 'false'); });

        subGroups.forEach(g => {
          g.hidden = g.dataset.variantId !== card.dataset.variantId;
        });

        updateCTA(parseFloat(card.dataset.total || '0'), parseInt(card.dataset.qty || '1', 10));
      });
    });

    // Subscription card click — set selling_plan input from the hidden radio.
    allSubCards.forEach(card => {
      card.addEventListener('click', (e) => {
        e.preventDefault();
        const radio = card.querySelector('input[type="radio"]');
        if (radio && planInput) planInput.value = radio.value;

        planCards.forEach(c => { c.classList.remove('active'); c.setAttribute('aria-checked', 'false'); });
        allSubCards.forEach(c => { c.classList.remove('active'); c.setAttribute('aria-checked', 'false'); });
        card.classList.add('active');
        card.setAttribute('aria-checked', 'true');

        // Sub price is stored in cents on data-price; qty comes from the group wrapper.
        const group = card.closest('.subscription-group');
        const qty = group ? parseInt(group.dataset.qty || '1', 10) : 1;
        const priceCents = parseInt(card.dataset.price || '0', 10);
        updateCTA(priceCents / 100, qty);
      });
    });

    // Init CTA price from the initially active plan card.
    const initCard = form.querySelector('.plan-card.active') || planCards[0];
    if (initCard) updateCTA(parseFloat(initCard.dataset.total || '0'), parseInt(initCard.dataset.qty || '1', 10));

    // Intercept submit → AJAX cart-add → redirect to /checkout (fall back to native submit on error).
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      fetch('/cart/add.js', { method: 'POST', body: new FormData(form) })
        .then(r => r.json())
        .then(() => { window.location.href = '/checkout'; })
        .catch(() => { form.submit(); });
    });
  })();

  // Testimonial videos — inline play, lazy-load src on first click, pause others.
  // Once playing, native <video controls> takes over for pause/scrub/etc.
  (function() {
    const cards = document.querySelectorAll('.testi-video-card');
    if (!cards.length) return;

    cards.forEach(card => {
      const video = card.querySelector('video');
      const src = card.dataset.src || '';

      if (!src) {
        card.classList.add('is-missing-src');
        console.warn('[testi-video] Missing data-src on card', card);
        return;
      }

      const handlePlay = (e) => {
        if (e) { e.preventDefault(); e.stopPropagation(); }

        cards.forEach(other => {
          if (other === card) return;
          const v = other.querySelector('video');
          if (v && !v.paused) v.pause();
          other.classList.remove('is-playing');
        });

        if (!video.src) video.src = src;
        if (!video.hasAttribute('controls')) video.controls = true;
        video.play().catch(err => {
          console.warn('[testi-video] play() rejected:', err, 'src=', video.src);
        });
        card.classList.add('is-playing');
      };

      card.addEventListener('click', (e) => {
        if (!card.classList.contains('is-playing')) handlePlay(e);
      });

      video.addEventListener('play', () => card.classList.add('is-playing'));
      video.addEventListener('pause', () => card.classList.remove('is-playing'));
      video.addEventListener('ended', () => card.classList.remove('is-playing'));
      video.addEventListener('error', () => {
        card.classList.add('is-error');
        console.warn('[testi-video] <video> error for src=', video.src);
      });
    });
  })();

</script>


