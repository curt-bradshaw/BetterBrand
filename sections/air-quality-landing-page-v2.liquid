{%- comment -%}
  ============================================================================
  AG1-style BetterLungs Lander — Variant B for A/B test
  ----------------------------------------------------------------------------
  Built 2026-06-09 mirroring AG1's Huberman lander structure with BetterBrand
  brand styling. Designed to test product-first conversion against the
  original Air Quality Report opt-in lander (Variant A = aq-quality-optin.liquid).

  Drop this file into /sections/ and the assets folder into /assets/.
  ============================================================================
{%- endcomment -%}

<!-- Fonts + Klaviyo Onsite (lander wrapper) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script async type="text/javascript" src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=NYkPJ4"></script>


<style>

  /* ══════════════════════════════════════════════════════════════
     HIDE THEME CHROME — main site header, footer, announcement /
     shipping bar.

     NOTE: v2 isn't wrapped in a scoping container like v1's .aqv3,
     so we can't use the broad ".announcement-bar" / "[class*=
     announcement-bar]" selectors v1 uses — they'd nuke this page's
     own <div class="announcement-bar"> at line ~621. We rely on
     the Shopify section ID and shipping-bar selectors instead, which
     are unique to theme chrome.
     ══════════════════════════════════════════════════════════════ */

  .essential_annoucement_bar_wrapper,
  [class*="essential_annoucement_bar"],
  [class*="essential_announcement_bar"],
  #shopify-section-announcement-bar,
  .shopify-section.shipping-bar,
  [class*="shipping-bar"],
  [id*="shipping_bar"],
  [id*="shipping-bar"] { display: none !important; }

  header.header-content,
  .header-content,
  .site-header,
  #shopify-section-header,
  [class*="site-header"],
  sticky-header,
  .header-wrapper,
  .shopify-section.section-header,
  .shopify-section-header-sticky,
  [class*="section-header"],
  [id*="section-header"] { display: none !important; }

  /* Nuke the entire <header> element from theme.old-layout.liquid (line 549).
     The header-group also includes a 'custom_liquid_mqQzGk' section without
     the section-header class, so per-class selectors above miss it and leave
     residual whitespace. Safe because v2's own nav is a separate <nav class="nav">
     sibling, not a child of <header>. */
  .ntg-wrapper > header,
  body > header { display: none !important; }

  footer.footer-content,
  .footer-content,
  .site-footer,
  #shopify-section-footer,
  [class*="site-footer"],
  .shopify-section .ntg-footer,
  .ntg-footer,
  [id*="section-footer"] { display: none !important; }

  .patrol-skip-link { display: none !important; }

  /* Reset every layout wrapper between <body> and the section so theme-injected
     padding/margin doesn't push the page down. */
  .ntg-wrapper,
  .ntg-main,
  #MainContent,
  main#MainContent,
  .main-content,
  [id="MainContent"] {
    padding-top: 0 !important;
    margin-top: 0 !important;
  }

  :root {
    --mallard: #1A3A1A;
    --mallard-deep: #102910;
    --mallard-92: rgba(26,58,26,0.92);
    --green-kelp: #1A2E1A;
    --killarney: #2D5A2D;
    --tom-thumb: #3D5C3D;
    --hippie: #4A7C4A;
    --laurel: #6B8C6B;
    --tasman: #D0DDD0;
    --surf-crest: #D4E8D4;
    --gray-nurse: #E8F0E8;
    --spring-wood: #F4F8F2;
    --gray-98: #F9FAF9;
    --mine-shaft: #2A2A2A;
    --silver-chalice: #AAAAAA;
    --mercury: #E5E5E5;
    --ronchi: #E8C84A;
    --ronchi-deep: #C5A82A;
    --tall-poppy: #C0392B;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; overflow-x: hidden; }
  body { font-family: 'MierA', -apple-system, system-ui, sans-serif; color: var(--mallard); background: #fff; -webkit-font-smoothing: antialiased; overflow-x: hidden; max-width: 100vw; line-height: 1.5; }

  /* Inter for every element on the page. v1 scopes this under .aqv3, but v2
     has no scoping wrapper — body is fine because all theme chrome is hidden.
     Covers inline DOM rendered by third-party widgets (Klaviyo, etc.) that
     would otherwise inherit their own font stacks. Iframed widgets like
     Trustpilot are out of reach and styled by their own scripts. */
  body, body *, body *::before, body *::after {
    font-family: 'MierA', -apple-system, system-ui, sans-serif !important;
  }

  h1, h2, h3, h4 { font-family: 'MierA', -apple-system, system-ui, sans-serif; font-weight: 400; }

  /* Responsive heading scale — mirrored from air-quality-landing-page-v1.liquid.
     clamp() lets every h1/h2/h3 scale smoothly between min and max so no
     per-breakpoint font-size overrides are needed. Unitless line-heights so
     leading scales with the font-size. !important on font-weight beats inline/
     embedded styles injected by third-party widgets like the Klaviyo form. */
  h1 {
    font-size: clamp(35px, 5vw, 52px);
    line-height: 1.05;
    font-weight: 700 !important;
  }
  h2 {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.1;
    font-weight: 700 !important;
  }
  h3 {
    font-size: clamp(20px, 2.5vw, 28px);
    line-height: 1.2;
  }

  /* Klaviyo form headline — keep the hero .hero-headline at its native size
     but match the h2 sizing for the title Klaviyo renders above the opt-in. */
  .air-report h1,
  [class*="klaviyo-form-"] h1 {
    font-size: clamp(28px, 4vw, 40px) !important;
    line-height: 1.1 !important;
  }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }
  button { font-family: inherit; cursor: pointer; border: 0; background: 0; }

  /* ===== announcement bar ===== */
  .announcement-bar { background: var(--mallard); height: 36px; display: flex; align-items: center; justify-content: center; gap: 14px; padding: 8px 12px; overflow: hidden; }
  .announcement-bar .ab-text { color: #fff; font-weight: 600; font-size: 12.5px; letter-spacing: 0.78px; text-transform: uppercase; white-space: nowrap; }
  .announcement-bar .ab-text::after { content: "·"; color: var(--ronchi); opacity: 0.6; margin-left: 14px; }
  .announcement-bar .ab-link { color: var(--ronchi); font-weight: 700; font-size: 12.5px; letter-spacing: 0.78px; text-transform: uppercase; text-decoration: underline; white-space: nowrap; }

  /* ===== nav ===== */
  .nav { background: #fff; height: 64px; display: flex; align-items: center; justify-content: space-between; padding: 0 40px; border-bottom: 1px solid var(--mercury); position: sticky; top: 0; z-index: 50; }
  .nav-logo img { height: 28px; width: auto; }
  .nav-links { list-style: none; display: flex; align-items: center; gap: 28px; }
  .nav-links a { color: var(--green-kelp); font-weight: 700; font-size: 13px; letter-spacing: 0.78px; text-transform: uppercase; }
  .nav-cta { background: var(--ronchi); color: var(--mallard); font-weight: 800; font-size: 13px; letter-spacing: 1.04px; text-transform: uppercase; padding: 10px 22px; border-radius: 50px; white-space: nowrap; }
  /* ===== universal ===== */
  .section { padding: 96px 24px; }
  .section-inner { max-width: 1200px; margin: 0 auto; }
  .eyebrow { color: var(--killarney); font-weight: 800; font-size: 11px; letter-spacing: 1.54px; text-transform: uppercase; }
  .h2 { color: var(--mallard); font-size: clamp(28px, 4vw, 40px); line-height: 1.1; letter-spacing: 1.04px; }
  .h2 .accent { color: var(--ronchi); }
  .h3 { color: var(--mallard); font-family: 'MierA', -apple-system, system-ui, sans-serif; font-size: clamp(20px, 2.5vw, 28px); line-height: 1.2; }
  .body-copy { color: var(--tom-thumb); font-size: 17px; line-height: 1.55; }
  .btn-primary { display: inline-flex; align-items: center; justify-content: center; background: var(--ronchi); color: var(--mallard); font-weight: 800; font-size: 14px; letter-spacing: 1.12px; text-transform: uppercase; padding: 16px 36px; border-radius: 50px; text-align: center; transition: filter .15s ease; }
  .btn-primary:hover { filter: brightness(0.96); }
  .btn-primary .arrow { margin-left: 10px; }
  .btn-outline { display: inline-flex; align-items: center; justify-content: center; background: transparent; color: var(--mallard); font-weight: 700; font-size: 14px; letter-spacing: 0.85px; text-transform: uppercase; padding: 14px 26px; border-radius: 50px; border: 2px solid var(--mallard); }
  .btn-on-dark { background: var(--ronchi); color: var(--mallard); }

  /* ===== HERO (AG1 split: text left, image right) ===== */
  /* Columns capped at their natural max-widths (matches .hero-content max-width 580 +
     .hero-image img max-width 640) and centered within the full-width section so the
     two halves don't drift to opposite edges on large monitors. minmax(0, X) lets
     columns shrink below X on narrower viewports before the mobile breakpoint takes over. */
  .hero { background: var(--spring-wood); display: grid; grid-template-columns: minmax(0, 580px) minmax(0, 640px); justify-content: center; align-items: center; min-height: 620px; padding: 56px 64px; gap: 60px; }
  .hero-content { display: flex; flex-direction: column; gap: 20px; max-width: 580px; }
  .hero-rating-row { display: flex; align-items: center; gap: 12px; }
  .hero-stars { color: var(--ronchi-deep); font-size: 17px; letter-spacing: 1.8px; }
  .hero-stars-label { color: var(--tom-thumb); font-size: 13px; font-weight: 600; letter-spacing: 0.4px; }
  .hero-headline { color: var(--mallard); font-family: 'MierA', -apple-system, system-ui, sans-serif; font-size: clamp(35px, 5vw, 52px); line-height: 1.05; letter-spacing: 1.4px; }
  .hero-headline span.accent { color: var(--ronchi-deep); display: inline; }
  .hero-subtitle { color: var(--tom-thumb); font-weight: 400; font-size: 18px; line-height: 1.5; max-width: 500px; }
  .hero-cta-row { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; padding-top: 6px; }
  .hero .btn-primary { font-size: 15px; padding: 18px 40px; }
  .hero-image { display: flex; align-items: center; justify-content: center; }
  .hero-image img { width: 100%; max-width: 640px; height: auto; object-fit: contain; border-radius: 14px; box-shadow: 0 20px 50px rgba(0,0,0,0.12); }

  /* ===== TRUST STRIP ===== */
  .trust-strip { background: var(--mallard); padding: 28px 24px; }
  .trust-strip-inner { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-around; align-items: center; flex-wrap: wrap; gap: 20px; }
  .trust-strip span { color: #fff; font-weight: 600; font-size: 13px; letter-spacing: 0.9px; text-transform: uppercase; opacity: 0.9; }
  .trust-strip span strong { color: var(--ronchi); font-weight: 800; }
  .trust-strip .sep { color: var(--ronchi); opacity: 0.5; }

  /* ===== TESTIMONIAL VIDEO STRIP ===== */
  .testi-videos { background: var(--spring-wood); padding: 56px 24px; }
  .testi-videos-inner { max-width: 1200px; margin: 0 auto; }
  .testi-videos-header { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  /* .testi-videos-header .h2 font-size override removed — base clamp(28px, 4vw, 40px) owns it */
  .testi-video-strip {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 4px 4px 14px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }
  .testi-video-strip::-webkit-scrollbar { height: 6px; }
  .testi-video-strip::-webkit-scrollbar-thumb { background: var(--tasman); border-radius: 6px; }
  .testi-video-card {
    flex: 0 0 230px;
    aspect-ratio: 9 / 16;
    border-radius: 14px;
    overflow: hidden;
    background: var(--mallard-deep);
    position: relative;
    scroll-snap-align: start;
    cursor: pointer;
  }
  .testi-video-card video {
    width: 100%; height: 100%; object-fit: cover; display: block; background: #000;
  }
  /* Before play: video doesn't catch clicks — they go to the card for the play handler */
  .testi-video-card:not(.is-playing) video { pointer-events: none; }
  .testi-play {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    pointer-events: none; color: #fff; font-size: 36px;
    text-shadow: 0 4px 14px rgba(0,0,0,0.5);
    background: rgba(0,0,0,0.18);
    transition: background 0.15s;
  }
  .testi-video-card:hover .testi-play { background: rgba(0,0,0,0.30); }
  .testi-video-card.is-playing .testi-play { display: none; }

  /* ===== AIR QUALITY REPORT OPT-IN (compact bar, no inner card) ===== */
  .air-report {
    background: var(--gray-nurse);
    border-top: 3px solid var(--ronchi);
    border-bottom: 3px solid var(--ronchi);
    padding: 0 24px;
  }
  .air-report-inner {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  /* Match v1's Klaviyo form width — 600px max, centered. */
  .air-report [class*="klaviyo-form-"],
  .air-report .klaviyo-form-W2ZwsL { width: 100%; max-width: 600px; margin: 0 auto; }
  /* Strip Klaviyo's injected gold border + inner card background + outer padding so form sits flat & tight */
  .air-report .klaviyo-form-W2ZwsL form.klaviyo-form,
  .air-report form.klaviyo-form {
    border: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    padding-top: 28px !important;
    padding-bottom: 28px !important;
  }

  /* ===== CLINICAL STUDY (split) ===== */
  .clinical { background: var(--spring-wood); }
  .clinical-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; max-width: 1200px; margin: 0 auto; }
  .clinical-text { display: flex; flex-direction: column; gap: 16px; }
  /* .clinical-text .h2 font-size override removed — base clamp(28px, 4vw, 40px) owns it */
  .clinical-image img { width: 100%; height: auto; border-radius: 14px; }
  .clinical-footnote { display: flex; gap: 14px; align-items: flex-start; padding: 18px 20px; background: var(--gray-nurse); border-radius: 12px; margin-top: 12px; }
  .clinical-footnote .marker { color: var(--killarney); font-weight: 800; flex-shrink: 0; }
  .clinical-footnote p { font-size: 12.5px; color: var(--tom-thumb); line-height: 1.5; }

  /* ===== INGREDIENTS DARK GREEN BLOCK ===== */
  .ingredients-block { background: var(--mallard); color: #fff; padding: 96px 24px; }
  .ingredients-block .section-inner { max-width: 1200px; }
  .ingredients-block .h2 { color: #fff; }
  .ingredients-block .eyebrow { color: var(--ronchi); }
  .ingredients-block .ig-header { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: 36px; }
  .ingredients-block .ig-header-left { max-width: 720px; }
  .ingredients-block .ig-cta-row { display: flex; gap: 12px; }
  .ig-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .ig-card { position: relative; border-radius: 14px; overflow: hidden; aspect-ratio: 4 / 5; background: var(--mallard-deep); }
  .ig-card img { width: 100%; height: 100%; object-fit: cover; }
  .ig-card .ig-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.92) 100%); padding: 20px; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px; }
  .ig-card .ig-cat { color: var(--ronchi); font-size: 10px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; }
  .ig-card .ig-name { color: #fff; font-family: 'MierA', -apple-system, system-ui, sans-serif; font-size: 24px; letter-spacing: 0.6px; line-height: 1; }
  .ig-card .ig-desc { color: rgba(255,255,255,0.85); font-size: 12.5px; line-height: 1.4; }
  .ig-supp-row { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
  .ig-supp-link { color: #fff; border: 1.5px solid rgba(255,255,255,0.3); border-radius: 999px; padding: 12px 22px; font-size: 12.5px; letter-spacing: 1.2px; text-transform: uppercase; font-weight: 700; }
  .ig-supp-link:hover { border-color: var(--ronchi); color: var(--ronchi); }

  /* ===== HOW IT WORKS ===== */
  .how-it-works { background: #fff; }
  .how-it-works .hiw-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 48px; }
  .hiw-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; }
  .hiw-step { display: flex; flex-direction: column; gap: 10px; padding-top: 16px; border-top: 2px solid var(--surf-crest); }
  .hiw-step-eyebrow { color: var(--killarney); font-weight: 800; font-size: 12px; letter-spacing: 1.5px; text-transform: uppercase; }
  .hiw-step-name { font-family: 'MierA', -apple-system, system-ui, sans-serif; color: var(--mallard); font-size: 28px; letter-spacing: 0.6px; line-height: 1; }
  .hiw-step-desc { color: var(--tom-thumb); font-size: 15px; line-height: 1.55; }
  .hiw-img-row { display: grid; grid-template-columns: 1fr; gap: 14px; margin-bottom: 48px; }
  .hiw-img-row img { width: 100%; height: auto; max-height: 420px; object-fit: cover; border-radius: 14px; }

  /* ===== TRUSTED BY ===== */
  .trusted-by { background: var(--mallard); color: #fff; padding: 96px 24px; }
  .trusted-by .h2 { color: #fff; }
  .trusted-by .eyebrow { color: var(--ronchi); }
  .trusted-by .tb-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 48px; }
  .tb-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .tb-card { background: var(--mallard-deep); border-radius: 14px; padding: 28px; display: flex; flex-direction: column; gap: 18px; }
  .tb-card .role { color: var(--ronchi); font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 800; }
  .tb-card .name { color: #fff; font-family: 'MierA', -apple-system, system-ui, sans-serif; font-size: 24px; letter-spacing: 0.6px; line-height: 1.05; }
  .tb-card .quote { color: rgba(255,255,255,0.85); font-size: 15px; line-height: 1.55; flex: 1; }
  .tb-card .stars { color: var(--ronchi); letter-spacing: 1.5px; font-size: 14px; }
  .tb-card .source { color: rgba(255,255,255,0.55); font-size: 11px; letter-spacing: 0.9px; text-transform: uppercase; font-weight: 700; }

  /* ===== SMARTER WAY (cost comparison) ===== */
  .smarter { background: #fff; }
  .smarter-inner { max-width: 760px; margin: 0 auto; }
  .smarter-inner .h2 { margin-bottom: 14px; }
  .smarter-table { margin-top: 36px; border-top: 1px solid var(--mercury); }
  .smarter-table-head, .smarter-row { display: grid; grid-template-columns: 1fr auto; padding: 18px 4px; align-items: center; border-bottom: 1px solid var(--mercury); }
  .smarter-table-head { color: var(--laurel); font-size: 11px; letter-spacing: 1.2px; text-transform: uppercase; font-weight: 800; }
  .smarter-row .label { color: var(--mallard); font-size: 16px; }
  .smarter-row .cost { color: var(--mallard); font-size: 16px; font-weight: 600; text-align: right; }
  .smarter-row.total { font-weight: 800; }
  .smarter-row.total .label, .smarter-row.total .cost { font-size: 17px; }
  .smarter-row.compare { background: var(--spring-wood); margin: 0 -8px; padding: 18px 12px; border-radius: 12px; border: 2px solid var(--ronchi); margin-top: 12px; border-bottom: 2px solid var(--ronchi); }
  .smarter-row.compare .label { color: var(--mallard); font-weight: 800; font-family: 'MierA', -apple-system, system-ui, sans-serif; font-size: 22px; letter-spacing: 0.5px; }
  .smarter-row.compare .cost { color: var(--mallard); font-weight: 800; font-family: 'MierA', -apple-system, system-ui, sans-serif; font-size: 26px; letter-spacing: 0.5px; }
  .smarter-footnote { color: var(--laurel); font-size: 11px; padding-top: 12px; font-style: italic; }

  /* ===== WHAT PEOPLE ARE SAYING (review grid) ===== */
  .people-saying { background: var(--spring-wood); }
  .ps-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 32px; }
  .ps-rating-summary { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
  .ps-rating-stars { color: var(--ronchi-deep); letter-spacing: 2px; font-size: 22px; }
  .ps-rating-text { color: var(--mallard); font-size: 14px; font-weight: 500; }
  .ps-rating-text strong { font-size: 22px; font-weight: 800; padding-right: 4px; }
  .ps-grid {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 4px 4px 14px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    max-width: 100%;
    margin: 0 -24px;
    padding-left: 24px;
    padding-right: 24px;
  }
  .ps-grid::-webkit-scrollbar { height: 6px; }
  .ps-grid::-webkit-scrollbar-thumb { background: var(--tasman); border-radius: 6px; }
  .ps-card {
    flex: 0 0 320px;
    background: #fff;
    border-radius: 12px;
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 1px solid var(--gray-nurse);
    scroll-snap-align: start;
  }
  .ps-card .stars { color: var(--ronchi-deep); letter-spacing: 1.5px; font-size: 14px; }
  .ps-card .title { color: var(--mallard); font-weight: 800; font-size: 16px; line-height: 1.3; margin: 0; }
  .ps-card .body { color: var(--tom-thumb); font-size: 14.5px; line-height: 1.55; flex: 1; }
  .ps-card .attr { color: var(--laurel); font-size: 11px; letter-spacing: 0.9px; text-transform: uppercase; font-weight: 700; }
  @media (max-width: 900px) {
    .ps-head { flex-direction: column; align-items: flex-start; gap: 12px; }
    .ps-rating-summary { flex-direction: row; align-items: center; gap: 10px; }
    .ps-rating-stars { font-size: 16px; }
    .ps-rating-text strong { font-size: 16px; }
    .ps-card { flex: 0 0 280px; padding: 18px 18px; }
