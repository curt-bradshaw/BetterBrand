{% layout none %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
  {{ content_for_header }}
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>BetterLungs® · The Air Report: What's Really In Your Air?</title>
<meta name="description" content="Get a free, personalized air quality report for where you live, then learn how to support the one air filter you can't replace: your lungs.">
<!-- Brand fonts (rebrand 2026) self-hosted via @font-face below: Söhne / Mier A / Tiempos -->
<!-- Klaviyo Onsite (AQ inline form W2ZwsL) -->
<script async type="text/javascript" src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=NYkPJ4"></script>
<style>
  /* ---- Brand fonts (rebrand 2026) ---- */
  @font-face { font-family: 'Sohne'; src: url('https://bb-aq-v3-lander.pages.dev/assets/fonts/soehne-dreiviertelfett.woff2?v=1') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }
  @font-face { font-family: 'MierA'; src: url('https://bb-aq-v3-lander.pages.dev/assets/fonts/MierA-Regular.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'MierA'; src: url('https://bb-aq-v3-lander.pages.dev/assets/fonts/MierA-Bold.woff2') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }
  @font-face { font-family: 'MierA'; src: url('https://bb-aq-v3-lander.pages.dev/assets/fonts/MierA-ExtraBold.woff2') format('woff2'); font-weight: 800; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Tiempos'; src: url('https://bb-aq-v3-lander.pages.dev/assets/fonts/tiempos-text-regular.woff2') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }

  :root {
    --bone: #FAF9F8;
    --bone-2: #F1EDE7;
    --ink: #212121;
    --muted: #6E6A62;
    --line: #E4DFD7;
    --green: #1A3A1A;
    --green-deep: #0D1F0D;
    --green-soft: #2D5A2D;
    --gold: #F2CB49;
    --gold-deep: #234134;
    --red: #C62828;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  [hidden] { display: none !important; }
  html { scroll-behavior: smooth; overflow-x: hidden; }
  body,
  .air-quality-report-page {
    font-family: 'MierA', -apple-system, system-ui, sans-serif;
    color: var(--ink);
    background: var(--bone);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    max-width: 100vw;
  }
  .air-quality-report-page,
  .air-quality-report-page * {
    font-family: 'MierA', -apple-system, system-ui, sans-serif !important;
  }
  .air-quality-report-page .display,
  .air-quality-report-page .ar-worst-num,
  .air-quality-report-page .ar-worst-label,
  .air-quality-report-page .ar-chip-num,
  .air-quality-report-page .edu-card-name,
  .air-quality-report-page .edu-stat .num,
  .air-quality-report-page .product-main-badge,
  .air-quality-report-page .ingr-name,
  .air-quality-report-page .routine-when,
  .air-quality-report-page .compare-table thead th,
  .air-quality-report-page .suppfacts-modal-title {
    font-family: 'Sohne', -apple-system, system-ui, sans-serif !important;
  }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }
  button { font-family: inherit; cursor: pointer; border: 0; background: 0; }

  /* Hide theme chrome only on pages where this section is rendered.
     This keeps the custom .nav and .footer inside this file visible. */
  .ntg-wrapper > header,
  body > header,
  #shopify-section-header,
  [class*="site-header"],
  sticky-header,
  .header-wrapper,
  .shopify-section.section-header,
  .shopify-section-header-sticky,
  [class*="section-header"],
  [id*="section-header"],
  #shopify-section-footer,
  [class*="site-footer"],
  .shopify-section .ntg-footer,
  .ntg-footer,
  [id*="section-footer"] {
    display: none !important;
  }

  .ntg-wrapper,
  .ntg-main,
  #MainContent,
  main#MainContent,
  .main-content,
  [id="MainContent"] {
    padding-top: 0 !important;
    margin-top: 0 !important;
  }

  /* display type — Söhne Dreiviertelfett (brand headers), sentence case */
  .display { font-family: 'Sohne', -apple-system, sans-serif; font-weight: 700; line-height: 1.03; letter-spacing: -0.8px; }
  .eyebrow { font-family: 'MierA', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 2.4px; text-transform: uppercase; color: var(--green-soft); }
  .eyebrow.gold { color: #B8902A; }

  /* flat editorial buttons — BetterLungs GREEN, gold accent variant */
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: var(--green); color: #fff; font-family: 'MierA', sans-serif; font-weight: 800; font-size: 14px; letter-spacing: 0.4px; padding: 16px 30px; border-radius: 6px; transition: filter 0.15s ease, transform 0.05s ease; }
  .btn:hover { filter: brightness(1.12); }
  .btn:active { transform: translateY(1px); }
  .btn-gold { background: var(--gold); color: var(--gold-deep); }
  .air-quality-report-page .btn-gold {
    width: auto !important;
    max-width: max-content;
    align-self: flex-start;
    flex: 0 0 auto;
  }
  .btn-light { background: #fff; color: var(--ink); border: 1px solid var(--line); }

  /* ---------- announcement ---------- */
  .topbar { background: var(--bone); border-bottom: 1px solid var(--line); text-align: center; padding: 9px 16px; }
  .topbar span { font-size: 12px; letter-spacing: 0.4px; color: var(--ink); font-weight: 500; }
  .topbar b { font-weight: 700; }

  /* ---------- nav ---------- */
  .nav { background: var(--bone); height: 66px; display: flex; align-items: center; justify-content: space-between; padding: 0 40px; position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--line); }
  .nav-logo img { height: 26px; width: auto; }
  .nav-links { list-style: none; display: flex; align-items: center; gap: 34px; }
  .nav-links a { font-weight: 600; font-size: 12.5px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--ink); }
  .nav-links a:hover { color: var(--green-soft); }
  .nav-cta { font-weight: 600; font-size: 12.5px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--ink); border-bottom: 2px solid var(--gold); padding-bottom: 2px; }

  /* ---------- hero (asymmetric editorial split on bone) ---------- */
  .hero { background: var(--bone); padding: 54px 40px 66px; overflow: hidden; border-bottom: 1px solid var(--line); }
  .hero-grid { max-width: none; display: grid; grid-template-columns: 1.04fr 0.96fr; gap: 56px; align-items: center; }
  .hero-copy { display: flex; flex-direction: column; align-items: flex-start; text-align: left; gap: 22px; }
  .hero-eyebrow { color: var(--green-soft); font-family: 'MierA', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 2.4px; text-transform: uppercase; }
  .hero h1 { color: var(--ink); font-size: clamp(38px, 5vw, 72px); }
  .hero p { color: var(--muted); font-size: clamp(16px, 1.4vw, 19px); max-width: 500px; line-height: 1.6; }
  .hero-cta-row { display: flex; gap: 14px; flex-wrap: wrap; padding-top: 2px; }
  .hero .btn { font-size: 15px; padding: 18px 38px; box-shadow: 0 10px 26px rgba(242,203,73,0.5); }

  .hero-media { position: relative; aspect-ratio: 1/1; border-radius: 18px; overflow: hidden; box-shadow: 0 30px 70px rgba(13,31,13,0.26); }
  .hero-media::after { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(13,31,13,0) 48%, rgba(13,31,13,0.55) 100%); }

  /* floating product chip, now docked inside the hero media frame */
  .float-card { position: absolute; left: 16px; right: 16px; bottom: 16px; z-index: 2; display: flex; align-items: center; gap: 13px; background: rgba(250,249,248,0.97); border-radius: 12px; padding: 11px 16px 11px 11px; box-shadow: 0 10px 28px rgba(0,0,0,0.24); }
  .float-card img { width: 52px; height: 52px; object-fit: cover; border-radius: 8px; flex-shrink: 0; }
  .float-card .fc-name { font-weight: 700; font-size: 13px; color: var(--ink); line-height: 1.2; }
  .float-card .fc-sub { font-size: 12px; color: var(--muted); }
  .float-card .fc-price { font-weight: 700; font-size: 13px; color: var(--green); padding-top: 2px; }

  /* ---------- section base ---------- */
  .section { padding: 92px 24px; }
  .wrap { max-width: 1120px; margin: 0 auto; }
  .center { text-align: center; }
  .section-title { color: var(--ink); font-size: clamp(36px, 5vw, 60px); padding: 0; }
  .lede { color: var(--muted); font-size: 17px; line-height: 1.7; max-width: 640px; }

  /* ---------- the air report (form) ---------- */
  .report { background: var(--bone); padding: 88px 24px 80px; text-align: center; }
  .report-inner { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .report h2 { color: var(--ink); font-size: clamp(40px, 6vw, 76px); }
  .report .lede { margin: 0 auto; }
  .kl-embed { width: 100%; margin-top: 26px; }
  .klaviyo-form-W2ZwsL { width: 100%; max-width: 640px; margin: 0 auto; border-radius: 14px; overflow: hidden; box-shadow: 0 18px 44px rgba(26,58,26,0.16); }
  .free-strip-inner { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 26px; margin-top: 26px; }
  .free-chip { display: inline-flex; align-items: center; gap: 7px; font-weight: 700; font-size: 12px; letter-spacing: 0.5px; text-transform: uppercase; color: var(--green-soft); }
  .free-chip .x { color: var(--gold); font-size: 14px; }

  /* ---------- custom air-report form + live results ---------- */
  .air-card { width: 100%; max-width: 640px; margin: 26px auto 0; background: #fff; border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 18px 44px rgba(26,58,26,0.12); padding: 30px 28px; text-align: left; }
  .air-form { display: flex; flex-direction: column; gap: 12px; }
  .af-row { display: flex; gap: 12px; }
  .af-row > * { flex: 1; min-width: 0; }
  .air-input { width: 100%; font-family: 'MierA', sans-serif; font-size: 16px; color: var(--ink); background: var(--bone); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; transition: border-color .15s ease, box-shadow .15s ease; }
  .air-input::placeholder { color: #9a958c; }
  .air-input:focus { outline: none; border-color: var(--green-soft); box-shadow: 0 0 0 3px rgba(45,90,45,.12); background: #fff; }
  .air-submit { margin-top: 4px; width: 100%; background: var(--gold); color: var(--gold-deep); font-family: 'MierA', sans-serif; font-weight: 800; font-size: 16px; letter-spacing: .4px; padding: 16px; border-radius: 10px; transition: filter .15s ease, transform .05s ease; }
  .air-submit:hover { filter: brightness(.97); }
  .air-submit:active { transform: translateY(1px); }
  .air-submit[disabled] { opacity: .7; cursor: default; }
  .air-consent { font-size: 11px; line-height: 1.5; color: var(--muted); margin-top: 2px; }
  .air-consent a { color: var(--green-soft); text-decoration: underline; }
  .air-err { font-size: 13px; color: var(--red); font-weight: 600; margin: 0; }

  .air-results { display: flex; flex-direction: column; gap: 16px; animation: rqfade .4s ease; }
  .ar-loc { font-size: 12.5px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: var(--green-soft); }
  .ar-loc b { color: var(--ink); }
  .ar-worst { display: flex; align-items: center; gap: 18px; background: #FBEDED; border: 1px solid #F0C9C9; border-radius: 14px; padding: 20px 22px; }
  .ar-worst-num { font-family: 'Sohne', -apple-system, sans-serif; font-weight: 600; font-size: 70px; line-height: .82; color: var(--red); flex-shrink: 0; }
  .ar-worst-meta { display: flex; flex-direction: column; gap: 3px; }
  .ar-worst-label { font-family: 'Sohne', -apple-system, sans-serif; text-transform: uppercase; font-weight: 500; font-size: 21px; color: var(--ink); letter-spacing: .3px; }
  .ar-worst-cat { font-weight: 700; font-size: 12.5px; letter-spacing: .4px; text-transform: uppercase; color: var(--red); }
  .ar-worst-tag { font-size: 12px; color: var(--muted); }
  .ar-rest { display: flex; gap: 10px; }
  .ar-chip { flex: 1; background: var(--bone); border: 1px solid var(--line); border-radius: 12px; padding: 14px 10px; text-align: center; }
  .ar-chip-num { font-family: 'Sohne', -apple-system, sans-serif; font-weight: 600; font-size: 30px; line-height: 1; color: var(--ink); }
  .ar-chip-label { font-size: 11px; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; color: var(--muted); margin-top: 6px; }
  .ar-chip-cat { font-size: 11px; margin-top: 2px; }
  .ar-pollen { font-size: 13.5px; line-height: 1.5; color: var(--muted); }
  .ar-pollen b { color: var(--ink); }
  .ar-foot { font-size: 12.5px; color: var(--muted); line-height: 1.55; margin: 0; }
  .ar-foot b { color: var(--ink); }
  .ar-cta { display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: var(--green); color: #fff; font-family: 'MierA', sans-serif; font-weight: 700; font-size: 14px; letter-spacing: .5px; padding: 14px 22px; border-radius: 8px; align-self: flex-start; }
  .ar-cta:hover { filter: brightness(1.12); }

  /* ---------- rehook ---------- */
  .rehook { background: var(--green-deep); padding: 80px 24px 84px; text-align: center; }
  .rehook-inner { max-width: 780px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .rehook .eyebrow { color: var(--gold); }
  .rehook h2 { color: #fff; font-size: clamp(34px, 5vw, 60px); }
  .rehook p { color: rgba(255,255,255,0.82); font-size: 17px; line-height: 1.6; max-width: 580px; }
  .rehook-arrow { color: var(--gold); font-size: 30px; margin-top: 4px; animation: bob 1.6s ease-in-out infinite; }
  @keyframes bob { 0%,100%{transform:translateY(0)} 50%{transform:translateY(8px)} }

  /* ---------- education: four numbers ---------- */
  .edu { background: var(--bone); }
  .edu-head { display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; }
  .edu-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; margin-top: 48px; }
  .edu-card { background: var(--bone); padding: 34px 32px; display: flex; flex-direction: column; gap: 12px; }
  .edu-card-name { font-family: 'Sohne', -apple-system, sans-serif; text-transform: uppercase; font-weight: 500; font-size: 24px; letter-spacing: 0.2px; color: var(--ink); }
  .edu-card-plain { font-size: 15px; line-height: 1.6; color: var(--muted); }
  .edu-stat { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; padding-top: 4px; }
  .edu-stat .num { font-family: 'Sohne', -apple-system, sans-serif; font-weight: 600; font-size: 46px; line-height: 0.9; color: var(--red); }
  .edu-stat .lbl { font-size: 12px; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; color: var(--red); }
  .edu-why { font-size: 14px; line-height: 1.55; color: var(--muted); border-top: 1px solid var(--line); padding-top: 12px; }
  .edu-why b { color: var(--ink); }
  .edu-invisible { margin-top: 28px; background: var(--green); color: #fff; border-radius: 14px; padding: 28px 32px; font-size: 17px; line-height: 1.7; display: grid; grid-template-columns: 1.05fr 1fr; gap: 30px; align-items: center; overflow: hidden; }
  .edu-invisible b { color: var(--gold); }
  .edu-invisible-media { border-radius: 10px; overflow: hidden; aspect-ratio: 16/10; }
  .edu-invisible-media img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* ---------- reframe ---------- */
  .reframe { position: relative; isolation: isolate; overflow: hidden; padding: 104px 24px; background: var(--green-deep); }
  .reframe::before { content: ""; position: absolute; inset: 0; z-index: -2; background: url('https://bb-aq-v3-lander.pages.dev/assets/aqi-form-bg.png') center 35% / cover no-repeat; opacity: 0.45; }
  .reframe::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(13,31,13,0.82) 0%, rgba(13,31,13,0.92) 100%); }
  .reframe-inner { max-width: 880px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; color: #fff; }
  .reframe .eyebrow { color: var(--gold); }
  .reframe h2 { color: #fff; font-size: clamp(40px, 6vw, 78px); }
  .reframe p { font-size: 18px; line-height: 1.7; color: rgba(255,255,255,0.86); }
  .reframe p b { color: #fff; }
  .reframe-energy { background: rgba(242,203,73,0.12); border: 1px solid rgba(242,203,73,0.4); border-radius: 12px; padding: 22px 24px; font-size: 16px; line-height: 1.6; }
  .reframe-energy b { color: var(--gold); }
  .reframe-figure { margin: 6px 0; border-radius: 14px; overflow: hidden; box-shadow: 0 20px 48px rgba(0,0,0,0.38); }
  .reframe-figure img { width: 100%; display: block; }
  .reframe-figure figcaption { font-size: 13.5px; line-height: 1.5; color: rgba(255,255,255,0.92); background: rgba(13,31,13,0.78); padding: 13px 18px; text-align: center; }
  .reframe-figure figcaption b { color: var(--gold); }

  /* ---------- real results, by concern (Jolie pattern) ---------- */
  .results { background: var(--bone-2); }
  .results-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 60px; align-items: center; }
  .results-photo { aspect-ratio: 4/5; border-radius: 14px; overflow: hidden; background: var(--green); }
  .results-photo img { width: 100%; height: 100%; object-fit: cover; }
  .results-right { display: flex; flex-direction: column; gap: 22px; }
  .results-right .section-title { font-size: clamp(30px, 4vw, 46px); }
  .results-quote { font-size: clamp(20px, 2.4vw, 28px); line-height: 1.45; color: var(--ink); font-weight: 500; }
  .results-attr-row { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 12px; }
  .results-attr .nm { font-weight: 700; font-size: 14px; color: var(--ink); }
  .results-attr .loc { font-size: 13px; color: var(--muted); }
  .results-about { font-size: 13px; color: var(--muted); }
  .results-about a { color: var(--green-soft); text-decoration: underline; font-weight: 600; }
  .concern-chips { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 6px; }
  .chip { background: #fff; border: 1px solid var(--line); color: var(--ink); font-weight: 600; font-size: 12px; letter-spacing: 0.6px; text-transform: uppercase; padding: 10px 15px; border-radius: 6px; transition: all 0.15s ease; }
  .chip:hover { border-color: var(--green-soft); }
  .chip.active { background: var(--green); color: #fff; border-color: var(--green); }
  .results-pick { font-size: 13.5px; color: var(--muted); margin-top: -10px; }
  .rq-card { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 28px 30px; display: flex; flex-direction: column; gap: 16px; box-shadow: 0 8px 26px rgba(0,0,0,0.05); }
  .rq-stars { color: var(--gold); font-size: 18px; letter-spacing: 3px; line-height: 1; }
  .rq-card .results-quote { font-size: clamp(19px, 2.2vw, 26px); }
  .rq-person { display: flex; align-items: center; gap: 14px; }
  .rq-avatar { width: 50px; height: 50px; border-radius: 50%; background: var(--green); color: #fff; font-weight: 700; font-size: 16px; letter-spacing: 0.5px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .rq-meta { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .rq-name-row { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
  .rq-name-row .nm { font-weight: 700; font-size: 15px; color: var(--ink); }
  .rq-verified { font-size: 12px; font-weight: 700; color: var(--green-soft); }
  .rq-meta .loc { font-size: 13px; color: var(--muted); line-height: 1.4; }
  .rq-card.swap { animation: rqfade 0.38s ease; }
  @keyframes rqfade { from { opacity: 0.2; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  /* ---------- product / buy box (PDP swatch-plans port) ---------- */
  .product { background: var(--bone); padding: 92px 24px; }
  .product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; max-width: 1120px; margin: 0 auto; align-items: start; }
  .product-gallery { display: flex; flex-direction: column; gap: 16px; }
  .product-main { aspect-ratio: 1/1; border-radius: 14px; overflow: hidden; background: #fff; box-shadow: 0 16px 44px rgba(0,0,0,0.08); position: relative; }
  .product-main img { width: 100%; height: 100%; object-fit: cover; }
  .product-main-badge { position: absolute; top: 16px; left: 16px; background: var(--gold); color: var(--gold-deep); font-family: 'Sohne', -apple-system, sans-serif; font-size: 16px; letter-spacing: 0.8px; text-transform: uppercase; padding: 8px 16px; border-radius: 6px; z-index: 2; }
  .product-thumbs { display: flex; gap: 10px; }
  .product-thumb { width: 70px; height: 70px; border-radius: 7px; border: 2px solid var(--line); overflow: hidden; background: #fff; cursor: pointer; padding: 0; }
  .product-thumb.is-selected { border-color: var(--green); }
  .product-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .product-info { display: flex; flex-direction: column; gap: 6px; }
  .product-stars-row { display: flex; align-items: center; gap: 8px; }
  .product-stars { color: var(--gold); font-size: 18px; letter-spacing: 2px; }
  .product-rating { font-size: 13px; color: var(--muted); text-decoration: underline; }
  .product-title { font-family: 'MierA', -apple-system, sans-serif; font-weight: 700; font-size: 32px; line-height: 1.12; letter-spacing: -0.3px; color: var(--ink); padding-top: 6px; }

  /* PDP swatch-plans port — EXACT match to live BetterBrand PDP buy box (#234134 green / #f2cb49 gold) */
  .plan-wrapper { width: 100%; padding-top: 8px; font-family: 'MierA', -apple-system, sans-serif; }
