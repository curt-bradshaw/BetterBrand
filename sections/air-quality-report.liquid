<!-- Sticky mobile CTA (shows after the form scrolls out of view) -->
<a href="#air-report" class="sticky-cta" id="sticky-cta">
  <span class="sc-icon" aria-hidden="true">✦</span>
  <span>Check My Air — <b>Free</b></span>
</a>

<script>
  // Concern-chip testimonial switcher (Jolie "Real Results, By Concern")
  (function () {
    const chips = document.querySelectorAll('#concern-chips .chip');
    const q = document.getElementById('rq-quote');
    const nm = document.getElementById('rq-name');
    const loc = document.getElementById('rq-loc');
    const av = document.getElementById('rq-avatar');
    const card = document.getElementById('rq-card');
    if (!chips.length || !q) return;
    chips.forEach(chip => chip.addEventListener('click', () => {
      chips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      q.textContent = '“' + chip.dataset.quote + '”';
      nm.textContent = chip.dataset.name;
      loc.textContent = chip.dataset.loc + ' · about BetterLungs® Mullein + Chlorophyll';
      if (av) av.textContent = chip.dataset.initials;
      if (card) { card.classList.remove('swap'); void card.offsetWidth; card.classList.add('swap'); }
    }));
  })();

  // thumb swap (hide promo badge off the hero slide)
  document.querySelectorAll('.product-thumb').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.product-thumb').forEach(b => b.classList.remove('is-selected'));
      btn.classList.add('is-selected');
      const src = btn.dataset.src;
      if (src) document.getElementById('product-main-img').src = src;
      const badge = document.querySelector('[data-promo-badge]');
      if (badge) badge.style.display = /product-hero\.jpg$/.test(src || '') ? '' : 'none';
    });
  });

  // PDP swatch-plans: form-based variant + selling plan selection.
  (function () {
    const productForm = document.getElementById('aqr-product-form');
    if (!productForm) return;
    const cta = productForm.querySelector('#bb-cta');
    const variantInput = document.getElementById('aqr-variant-id');
    const planInput = document.getElementById('aqr-selling-plan');
    const planCards = productForm.querySelectorAll('.plan-card');
    const subGroups = productForm.querySelectorAll('.subscription-group');
    const allSubCards = productForm.querySelectorAll('.subscription-card');
    if (!cta || !variantInput || !planInput || !planCards.length) return;
    const priceEl = cta.querySelector('.bb-cta-price');
    const countEl = cta.querySelector('.bb-cta-count');

    function updateCTA(total, qty) {
      if (priceEl && Number.isFinite(total)) priceEl.textContent = '$' + total.toFixed(2);
      if (countEl) countEl.textContent = '(' + qty + ' Item' + (qty === 1 ? '' : 's') + ')';
    }

    planCards.forEach(card => card.addEventListener('click', () => {
      variantInput.value = card.dataset.variantId || '';
      planInput.value = '';

      planCards.forEach(c => { c.classList.remove('active'); c.setAttribute('aria-checked', 'false'); });
      card.classList.add('active');
      card.setAttribute('aria-checked', 'true');

      allSubCards.forEach(c => { c.classList.remove('active'); c.setAttribute('aria-checked', 'false'); });
      subGroups.forEach(group => {
        group.hidden = group.dataset.variantId !== card.dataset.variantId;
      });

      updateCTA(parseFloat(card.dataset.total || '0'), parseInt(card.dataset.qty || '1', 10));
    }));

    allSubCards.forEach(card => card.addEventListener('click', () => {
      const radio = card.querySelector('input[type="radio"]');
      const group = card.closest('.subscription-group');
      if (radio) planInput.value = radio.value;
      if (group && group.dataset.variantId) variantInput.value = group.dataset.variantId;

      planCards.forEach(c => { c.classList.remove('active'); c.setAttribute('aria-checked', 'false'); });
      allSubCards.forEach(c => { c.classList.remove('active'); c.setAttribute('aria-checked', 'false'); });
      card.classList.add('active');
      card.setAttribute('aria-checked', 'true');

      const qty = group ? parseInt(group.dataset.qty || '1', 10) : 1;
      const priceCents = parseInt(card.dataset.price || '0', 10);
      updateCTA(priceCents / 100, qty);
    }));

    const initiallyActive = productForm.querySelector('.plan-card.active') || planCards[0];
    if (initiallyActive) updateCTA(parseFloat(initiallyActive.dataset.total || '0'), parseInt(initiallyActive.dataset.qty || '1', 10));

    productForm.addEventListener('submit', (e) => {
      e.preventDefault();
      fetch('/cart/add.js', { method: 'POST', body: new FormData(productForm) })
        .then(r => r.json())
        .then(() => { window.location.href = '/checkout'; })
        .catch(() => { productForm.submit(); });
    });
  })();

  // supplement facts modal
  (function () {
    const modal = document.getElementById('suppfacts-modal');
    const trigger = document.getElementById('suppfacts-btn');
    const closeBtn = document.getElementById('suppfacts-modal-close');
    if (!modal || !trigger) return;
    const open = () => { modal.classList.add('is-open'); modal.setAttribute('aria-hidden','false'); document.body.style.overflow = 'hidden'; };
    const close = () => { modal.classList.remove('is-open'); modal.setAttribute('aria-hidden','true'); document.body.style.overflow = ''; };
    trigger.addEventListener('click', (e) => { e.preventDefault(); open(); });
    closeBtn?.addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  })();

  // sticky mobile CTA: reveal once the air-report form has scrolled out of view
  (function () {
    const bar = document.getElementById('sticky-cta');
    const form = document.getElementById('air-report');
    if (!bar || !form || !('IntersectionObserver' in window)) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        bar.classList.toggle('is-visible', !e.isIntersecting && e.boundingClientRect.top < 0);
      });
    }, { threshold: 0 });
    io.observe(form);
  })();

  // count-up on the scary stats when they scroll into view
  (function () {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const nums = document.querySelectorAll('.edu-stat .num');
    if (!nums.length || !('IntersectionObserver' in window)) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        const el = e.target; io.unobserve(el);
        const full = el.textContent;             // e.g. "Up to 50×"
        const m = full.match(/(\d+)/);
        if (!m || reduce) return;
        const target = parseInt(m[1], 10);
        const pre = full.slice(0, m.index);
        const post = full.slice(m.index + m[1].length);
        const dur = 1100, t0 = performance.now();
        el.textContent = pre + '0' + post;
        (function tick(now) {
          const p = Math.min(1, (now - t0) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = pre + Math.round(eased * target) + post;
          if (p < 1) requestAnimationFrame(tick); else el.textContent = full;
        })(t0);
      });
    }, { threshold: 0.6 });
    nums.forEach(n => io.observe(n));
  })();

  // custom air-report form -> live AirNow numbers (cherry-picked worst rendered big + red)
  (function () {
    const form = document.getElementById('air-form');
    const resultsEl = document.getElementById('air-results');
    if (!form || !resultsEl) return;
    const WORKER = 'https://betterbrand-air-quality.royal-dew-fe05.workers.dev';
    const SERVE = 'https://yswqqjakuifsgslwskgq.supabase.co/functions/v1/serve-form/aq-report/submit';
    const btn = form.querySelector('.air-submit');
    const errEl = form.querySelector('.air-err');
    const escapeHtml = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    function countUp(el, target) {
      const dur = 1100, t0 = performance.now();
      (function tick(now) {
        const p = Math.min(1, (now - t0) / dur);
        el.textContent = Math.round((1 - Math.pow(1 - p, 3)) * target);
        if (p < 1) requestAnimationFrame(tick); else el.textContent = target;
      })(t0);
    }
    function showErr(m) { if (errEl) { errEl.textContent = m; errEl.hidden = false; } }

    // Lead capture (independent of the live display). Phone present -> serve-form aq-report
    // (Klaviyo DH + Postscript + report email). Email-only -> worker direct (subscribe + report email).
    function captureLead(d) {
      const digits = (d.phone || '').replace(/\D/g, '');
      if (digits.length >= 10) {
        fetch(SERVE, { method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ firstName: d.first_name, name: d.first_name, email: d.email, phone: d.phone, properties: { 'Zip Code': d.zip } }) }).catch(() => {});
      } else {
        fetch(WORKER, { method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: d.email, first_name: d.first_name, zip_code: d.zip }) }).catch(() => {});
      }
    }

    function render(d, email) {
      const worst = d.worst;
      const rest = d.metrics.filter((m) => m.key !== worst.key);
      const pollen = d.pollen
        ? `<div class="ar-pollen"><b>${escapeHtml(d.pollen.name)} pollen</b> is running <b>${escapeHtml(d.pollen.level)}</b> in your area today.</div>` : '';
      const loc = d.city ? `${escapeHtml(d.city)}${d.state ? ', ' + escapeHtml(d.state) : ''}` : ('ZIP ' + escapeHtml(d.zip));
      resultsEl.innerHTML =
        `<div class="ar-loc">Live air near <b>${loc}</b></div>
         <div class="ar-worst">
           <div class="ar-worst-num" id="ar-worst-num">0</div>
           <div class="ar-worst-meta">
             <div class="ar-worst-label">${escapeHtml(worst.label)} &middot; AQI</div>
             <div class="ar-worst-cat">${escapeHtml(worst.category)}</div>
             <div class="ar-worst-tag">Your highest reading right now</div>
           </div>
         </div>
         ${rest.length ? `<div class="ar-rest">${rest.map((m) =>
           `<div class="ar-chip"><div class="ar-chip-num" data-n="${m.aqi}">0</div><div class="ar-chip-label">${escapeHtml(m.label)}</div><div class="ar-chip-cat" style="color:${escapeHtml(m.color)}">${escapeHtml(m.category)}</div></div>`).join('')}</div>` : ''}
         ${pollen}
         <p class="ar-foot">Live readings from the U.S. EPA AirNow network${email ? `. Your full personalized report is on its way to <b>${escapeHtml(email)}</b>` : ''}.</p>
         <a href="#learn" class="ar-cta">See what these numbers mean &darr;</a>`;
      form.hidden = true; resultsEl.hidden = false;
      countUp(document.getElementById('ar-worst-num'), worst.aqi);
      resultsEl.querySelectorAll('.ar-chip-num').forEach((el) => countUp(el, parseInt(el.dataset.n, 10)));
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errEl) errEl.hidden = true;
      const fd = new FormData(form);
      const d = {
        first_name: (fd.get('first_name') || '').toString().trim(),
        zip: (fd.get('zip') || '').toString().replace(/\D/g, '').slice(0, 5),
        email: (fd.get('email') || '').toString().trim(),
        phone: (fd.get('phone') || '').toString().trim(),
      };
      if (d.zip.length !== 5) { showErr('Please enter a valid 5-digit ZIP code.'); return; }
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(d.email)) { showErr('Please enter a valid email address.'); return; }
      btn.disabled = true; const orig = btn.innerHTML; btn.textContent = 'Pulling your live readings…';
      captureLead(d);
      try {
        const res = await fetch(WORKER + '/aqi?zip=' + d.zip);
        const data = await res.json();
        if (data && data.ok && data.metrics && data.metrics.length) {
          render(data, d.email);
        } else {
          resultsEl.innerHTML =
            `<div class="ar-loc">You're in &check;</div>
             <p class="ar-foot">We couldn't reach a live monitor near <b>ZIP ${escapeHtml(d.zip)}</b> this minute, but your full personalized report is on its way to <b>${escapeHtml(d.email)}</b>. Keep scrolling to see what the numbers mean.</p>
             <a href="#learn" class="ar-cta">What these numbers mean &darr;</a>`;
          form.hidden = true; resultsEl.hidden = false;
        }
      } catch (_e) {
        btn.disabled = false; btn.innerHTML = orig;
        showErr("Couldn't pull your readings just now — your report is still on its way. Try again or keep scrolling.");
      }
    });
  })();
</script>

</div>
</body>
</html>

