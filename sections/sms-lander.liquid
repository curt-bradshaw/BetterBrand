{%- comment -%}
  ============================================================
  Betterbrand · SMS VIP Lander — v3 (rebrand 2026)
  ============================================================
  1:1 port of live page: https://bb-sms-lander-v3.pages.dev/sms-lander-v3
  - Fonts (Sohne / Mier A / Tiempos) self-hosted in theme assets/.
  - Form posts to the Supabase serve-form edge fn (dual-writes Klaviyo +
    Postscript). Cross-origin, no extra theme setup.
  - Splide + product/logo images load from CDN.
  - Review avatars use asset_url (upload avatar PNGs when ready).
  - Render via templates/page.sms-lander-v3.json, or add as a section.
  ============================================================
{%- endcomment -%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.0.7/dist/css/splide.min.css">
<script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.0.7/dist/js/splide.min.js"></script>

<style>

  /* ---- Brand fonts (rebrand 2026) — self-hosted ---- */
  @font-face { font-family: 'Sohne'; src: url('{{ "soehne-dreiviertelfett.woff2" | asset_url }}') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }
  @font-face { font-family: 'MierA'; src: url('{{ "MierA-Regular.woff2" | asset_url }}') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: 'MierA'; src: url('{{ "MierA-Bold.woff2" | asset_url }}') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }
  @font-face { font-family: 'MierA'; src: url('{{ "MierA-ExtraBold.woff2" | asset_url }}') format('woff2'); font-weight: 800; font-style: normal; font-display: swap; }
  @font-face { font-family: 'Tiempos'; src: url('{{ "tiempos-text-regular.woff2" | asset_url }}') format('woff2'); font-weight: 400; font-style: normal; font-display: swap; }

  /* smooth in-page nav (Curt: keep visitors on the page, no off-site links) */
  html { scroll-behavior: smooth; }
  #signup, #reviews, #faq { scroll-margin-top: 76px; }
  @media (min-width: 768px) { #signup, #reviews, #faq { scroll-margin-top: 88px; } }

  :root {
    --bb-green-dark: #1a3a1a;
    --bb-green-mid: #2d5a2d;
    --bb-green-bottle: #1e4620;
    --bb-green-sage: #e8f0e8;
    --bb-green-light: #f0f5f0;
    --bb-off-white: #f9faf9;
    --bb-white: #ffffff;
    --bb-yellow: #e8c84a;
    --bb-yellow-hover: #d4b435;
    --bb-yellow-light: #fdf8e1;
    --bb-text-dark: #1a2e1a;
    --bb-text-mid: #3d5c3d;
    --bb-text-light: #6b8c6b;
    --bb-border: #d0ddd0;
    --bb-footer-black: #0d1f0d;

    --bb-display: 'Sohne', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
    --bb-body:    'MierA', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    --bb-serif:   'Tiempos', Georgia, 'Times New Roman', serif;

    --bb-pad-desktop: 40px;
    --bb-pad-mobile: 20px;
    --bb-radius-pill: 50px;
    --bb-radius-card: 16px;
    --bb-radius-testimonial: 12px;
    --bb-radius-input: 8px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .bb-sms-vip-v3 {
    color: var(--bb-text-dark);
    background: var(--bb-white);
    font-family: var(--bb-body);
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; cursor: pointer; background: none; border: 0; color: inherit; }
  input { font: inherit; color: inherit; background: transparent; border: 0; outline: 0; width: 100%; }

  /* Faux header */
  .bb-header {
    background: var(--bb-white);
    border-bottom: 1px solid var(--bb-border);
    position: sticky; top: 0; z-index: 100;
  }
  .bb-shipping-bar {
    background: var(--bb-green-dark);
    color: var(--bb-white);
    text-align: center;
    padding: 11px 16px;
    font-family: var(--bb-body);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  /* Header inner: flex with absolutely-centered nav (mobile: logo centered, desktop: nav centered).
     Using absolute centering for the centered element guarantees true page-center alignment regardless
     of how wide the logo or icons grow. */
  .bb-header-inner {
    display: flex; align-items: center;
    padding: 16px 20px;
    max-width: 1440px; margin: 0 auto;
    height: 64px;
    position: relative;
  }
  /* Mobile: logo absolutely centered; hamburger left; icons right */
  .bb-logo {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    display: flex; align-items: center;
  }
  .bb-logo img { height: 32px; width: auto; }
  .bb-header-right { margin-left: auto; }

  /* Desktop: logo left, nav absolutely centered, icons right */
  @media (min-width: 1024px) {
    .bb-header-inner { padding: 16px 40px; height: 72px; }
    .bb-logo {
      position: static; transform: none;
    }
    .bb-logo img { height: 42px; }
    .bb-header-right { margin-left: auto; }
  }

  .bb-nav {
    display: none;
    gap: 36px;
    align-items: center;
    font-family: var(--bb-body);
    font-size: 13px; font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bb-text-dark);
  }
  @media (min-width: 1024px) {
    .bb-nav {
      display: flex;
      position: absolute;
      left: 50%; top: 50%;
      transform: translate(-50%, -50%);
    }
  }
  .bb-nav a:hover { color: var(--bb-green-mid); }
  .bb-header-right { display: flex; align-items: center; gap: 14px; }
  .bb-header-icons { display: flex; gap: 14px; color: var(--bb-text-dark); }
  .bb-header-icons svg { width: 22px; height: 22px; stroke: currentColor; fill: none; stroke-width: 1.5; cursor: pointer; }
  .bb-mobile-menu { display: flex; flex-direction: column; gap: 4px; cursor: pointer; padding: 4px; }
  .bb-mobile-menu span { display: block; width: 20px; height: 1.5px; background: var(--bb-text-dark); }
  .bb-mobile-menu span:last-child { width: 16px; }
  @media (min-width: 1024px) { .bb-mobile-menu { display: none; } }

  /* Promo bar — yellow per brand */
  .promo {
    background: var(--bb-yellow);
    color: var(--bb-green-dark);
    text-align: center;
    padding: 12px 16px;
    font-family: var(--bb-body);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Hero — DARK FOREST background */
  .hero {
    background: var(--bb-green-dark);
    color: var(--bb-white);
    overflow: hidden;
    position: relative;
    min-height: 560px;
  }
  .hero-inner {
    display: grid; grid-template-columns: 1fr;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }
  @media (min-width: 1024px) { .hero-inner { grid-template-columns: 1.05fr 1fr; min-height: 560px; } }

  /* v3 (Tate round 8 — 2026-05-26): cut bottom padding under trust badges
     on mobile (was 64px → 24px) so the porch hero photo flows tight under
     the trust row instead of sitting in a void of dead space. */
  .hero-form { padding: 32px 20px 24px; display: flex; flex-direction: column; justify-content: center; }
  @media (min-width: 1024px) { .hero-form { padding: 56px var(--bb-pad-desktop); } }

  .pill {
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--bb-yellow);
    color: var(--bb-green-dark);
    border-radius: var(--bb-radius-pill);
    padding: 10px 22px;
    font-family: var(--bb-body);
    font-size: 11px; font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    align-self: flex-start;
    margin-bottom: 28px;
  }

  .h1 {
    font-family: var(--bb-display);
    font-weight: 700;
    color: var(--bb-white);
    font-size: clamp(46px, 5.4vw, 76px);
    line-height: 1.0;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
  }
  .h1-line { display: block; }
  .h1-line--accent { color: var(--bb-yellow); }
  .h1-mark { color: var(--bb-yellow); }

  .lede {
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--bb-body);
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.7;
    max-width: 540px;
    margin-bottom: 32px;
  }

  /* VIP bullets — replaces .lede in V2 hero */
  .vip-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    max-width: 540px;
    display: flex; flex-direction: column;
    gap: 12px;
  }
  .vip-bullets li {
    color: rgba(255, 255, 255, 0.92);
    font-family: var(--bb-body);
    font-size: clamp(15px, 1.3vw, 17px);
    font-weight: 500;
    line-height: 1.5;
    display: flex; align-items: flex-start; gap: 12px;
  }
  .vip-check {
    flex: 0 0 24px;
    width: 24px; height: 24px;
    border-radius: 50%;
    background: var(--bb-yellow);
    color: var(--bb-green-dark);
    font-weight: 800;
    font-size: 13px;
    display: inline-flex; align-items: center; justify-content: center;
    line-height: 1;
  }

  /* Prominent trust strip per Tate's "more prominent" note */
  .trust--prominent {
    color: var(--bb-white) !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    gap: 16px 32px !important;
    border-top: 1px solid rgba(255,255,255,0.18);
    padding-top: 24px;
    margin-top: 32px !important;
  }

  .form-row { display: grid; grid-template-columns: 1fr; gap: 12px; max-width: 560px; }
  @media (min-width: 600px) { .form-row { grid-template-columns: minmax(220px, 1fr) auto; } }

  .phone {
    display: flex; align-items: center;
    background: var(--bb-white);
    border: 1px solid var(--bb-border);
    border-radius: var(--bb-radius-input);
    height: 56px;
    padding: 0 18px;
    gap: 12px;
    transition: border 0.15s;
  }
  .phone:focus-within { border-color: var(--bb-green-mid); border-width: 1.5px; padding: 0 17.5px; }
  .phone .flag { font-family: var(--bb-body); font-size: 14px; font-weight: 600; color: var(--bb-text-dark); white-space: nowrap; }
  .phone .divider { width: 1px; height: 24px; background: var(--bb-border); }
  .phone input { font-family: var(--bb-body); font-size: 15px; color: var(--bb-text-dark); }
  .phone input::placeholder { color: var(--bb-text-light); }

  /* Pill CTA */
  .cta {
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--bb-yellow);
    color: var(--bb-green-dark);
    border: 0;
    border-radius: var(--bb-radius-pill);
    height: 56px;
    padding: 18px 28px;
    font-family: var(--bb-body);
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background 0.15s, transform 0.05s;
    white-space: nowrap;
  }
  .cta:hover { background: var(--bb-yellow-hover); }
  .cta:active { transform: translateY(1px); }
  .cta:focus-visible { outline: 2px solid var(--bb-yellow); outline-offset: 2px; }

  .tcpa {
    color: rgba(255, 255, 255, 0.55);
    font-family: var(--bb-body);
    font-size: 11px;
    line-height: 1.6;
    margin-top: 18px;
    max-width: 560px;
  }
  .tcpa a { text-decoration: underline; }

  /* v3 (Curt round 4 — 2026-05-26): trust row.
     - Yellow inline SVG icons (people / check / star)
     - "1,000,000+" → "1M+" for compactness
     - nowrap on DESKTOP so all 3 badges live on a single row
     - Allow wrap on mobile (≤480px) where 3 badges don't fit on 375 viewport */
  .trust {
    display: flex; flex-wrap: wrap; gap: 12px 16px;
    margin-top: 20px;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--bb-body);
    font-weight: 600;
    font-size: 12px;
    align-items: center;
  }
  @media (min-width: 600px) { .trust { flex-wrap: nowrap; } }
  .trust span { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .trust svg { width: 14px; height: 14px; flex-shrink: 0; color: var(--bb-yellow); }

  /* v3 (Tate round 13 — 2026-05-26): rebuilt as an actual iMessage-style
     text thread inside a phone-screen card, so 45+ readers instantly
     recognize "this is what the VIP text experience looks like." */
  .hero-image {
    position: relative;
    background: var(--bb-green-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 20px;
    overflow: visible;
  }
  @media (min-width: 1024px) {
    .hero-image { padding: 40px 32px; }
  }
  .hero-phone {
    position: relative;
    width: 100%;
    max-width: 320px;
    background: #ffffff;
    border-radius: 28px;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }
  /* iOS-style status bar */
  .hero-phone-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 22px 6px;
    font-size: 13px;
    font-weight: 600;
    color: #1a1a1a;
    background: #f6f6f6;
  }
  .hero-phone-status-icons {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .hero-phone-status-icons svg { display: block; }
  /* Chat header — back arrow absolute-positioned so the contact stack
     centers in the full header width (matches real iOS Messages). */
  .hero-phone-header {
    position: relative;
    padding: 8px 14px 12px;
    background: #f6f6f6;
    border-bottom: 0.5px solid rgba(0, 0, 0, 0.08);
  }
  .hero-phone-back {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #007aff;
    font-size: 22px;
    line-height: 1;
    font-weight: 400;
  }
  .hero-phone-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .hero-phone-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bb-green-dark);
    color: var(--bb-yellow);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--bb-display);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .hero-phone-name {
    font-size: 11px;
    font-weight: 500;
    color: #1a1a1a;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .hero-phone-name svg { width: 9px; height: 9px; color: #8e8e93; }
  /* Message thread */
  .hero-phone-thread {
    padding: 14px 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: #ffffff;
  }
  .hero-phone-daystamp {
    text-align: center;
    font-size: 10px;
    font-weight: 600;
    color: #8e8e93;
    margin: 2px 0 10px;
    letter-spacing: 0.01em;
  }
  .hero-phone-daystamp strong { color: #1a1a1a; font-weight: 600; }
  .hero-bubble {
    max-width: 78%;
    padding: 8px 13px;
    border-radius: 18px;
    font-size: 14px;
    line-height: 1.32;
    word-wrap: break-word;
    position: relative;
  }
  .hero-bubble--in {
    background: #e9e9eb;
    color: #1a1a1a;
    align-self: flex-start;
    border-bottom-left-radius: 5px;
  }
  .hero-bubble--out {
    background: #34c759;
    color: #ffffff;
    align-self: flex-end;
    border-bottom-right-radius: 5px;
  }
  .hero-bubble + .hero-bubble--in { margin-top: 2px; }
  .hero-bubble--in + .hero-bubble--out,
  .hero-bubble--out + .hero-bubble--in { margin-top: 8px; }
  .hero-bubble strong { font-weight: 600; }
  .hero-phone-read {
    align-self: flex-end;
    font-size: 10px;
    color: #8e8e93;
    margin-top: 4px;
    margin-right: 4px;
    font-weight: 500;
  }
  .hero-tag {
    position: absolute;
    bottom: 36px; left: 50%; transform: translateX(-50%);
    background: var(--bb-yellow);
    color: var(--bb-green-dark);
    border-radius: var(--bb-radius-pill);
    padding: 10px 22px;
    font-family: var(--bb-body);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Sections — v3 (Tate+Curt 2026-05-26): tightened vertical rhythm.
     Previous 60/80px top+bottom padding + 40px heading margin felt airy
     ("too much dead space"). New values cut ~25% throughout. */
  /* v3 (Curt round 6 — 2026-05-26): final pass on section-level paddings.
     Section paddings (44px desktop top+bottom) flagged in scan as still
     above target; cut all to 32px desktop / 24px mobile across the board. */
  .section { padding: 24px var(--bb-pad-mobile); max-width: 1200px; margin: 0 auto; }
  @media (min-width: 1024px) { .section { padding: 32px var(--bb-pad-desktop); } }
  .section-heading { text-align: center; margin: 0 auto 16px; max-width: 720px; }
  @media (min-width: 1024px) { .section-heading { margin-bottom: 20px; } }
  .eyebrow {
    font-family: var(--bb-body);
    font-size: 11px; font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bb-green-mid);
    margin-bottom: 8px;
  }
  .h2 {
    font-family: var(--bb-display);
    font-weight: 700;
    color: var(--bb-green-dark);
    font-size: clamp(30px, 3.4vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.015em;
  }
  .h2 .h1-mark { color: var(--bb-yellow); }

  /* Benefits 4-up */
  .benefits { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 600px) { .benefits { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .benefits { grid-template-columns: repeat(4, 1fr); } }

  .bcard {
    background: var(--bb-off-white);
    border: 1px solid var(--bb-border);
    border-radius: var(--bb-radius-input);
    padding: 24px 22px;
    display: flex; flex-direction: column;
  }
  /* v3 (mobile fix 2026-05-26): trim benefit-card padding + margins on mobile
     so the 4 cards stack into a more scannable column instead of feeling
     spread out and empty. */
  @media (min-width: 1024px) {
    .bcard { padding: 32px 28px; }
  }
  .bicon {
    width: 48px; height: 48px;
    border-radius: 50%;
    background: var(--bb-green-sage);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 14px;
    color: var(--bb-green-dark);
  }
  @media (min-width: 1024px) {
    .bicon { width: 56px; height: 56px; margin-bottom: 20px; }
  }
  /* v3 (Curt round 10 — 2026-05-26): switched to filled SVG icons supplied
     by Curt (dollar, crown, up-arrow, idea). Fills `currentColor` instead
     of stroking. */
  .bicon svg { width: 22px; height: 22px; fill: currentColor; }
  @media (min-width: 1024px) {
    .bicon svg { width: 24px; height: 24px; }
  }
  /* v3 (Curt 2026-05-26): "01 —", "02 —" numbered labels removed on both
     mobile + desktop per feedback — they were creating visual clutter and
     not adding meaningful info. */
  .bnum { display: none; }
  .bnum::after { content: ''; width: 28px; height: 1px; background: var(--bb-green-mid); display: block; }
  .btitle {
    font-family: var(--bb-display);
    font-weight: 700;
    color: var(--bb-green-dark);
    font-size: 21px;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin-bottom: 12px;
  }
  .bbody {
    color: var(--bb-text-mid);
    font-family: var(--bb-body);
    font-size: 15px;
    line-height: 1.65;
  }

  /* Trust strip */
  .trust-strip {
    background: var(--bb-white);
    padding: 44px var(--bb-pad-mobile);
    border-top: 1px solid var(--bb-border);
    border-bottom: 1px solid var(--bb-border);
  }
  @media (min-width: 1024px) { .trust-strip { padding: 48px var(--bb-pad-desktop); } }
  .tgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; max-width: 1200px; margin: 0 auto; }
  @media (min-width: 1024px) { .tgrid { grid-template-columns: repeat(4, 1fr); } }
  .tbadge { display: flex; align-items: center; gap: 14px; color: var(--bb-green-dark); }
  .tbadge .ti {
    flex: 0 0 48px; width: 48px; height: 48px; border-radius: 50%;
    background: var(--bb-green-sage);
    display: flex; align-items: center; justify-content: center;
    color: var(--bb-green-mid);
  }
  .tbadge .ti svg { width: 24px; height: 24px; stroke: currentColor; fill: none; stroke-width: 1.5; }
  .tbadge .tl {
    font-family: var(--bb-body);
    font-weight: 700; font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  /* Product carousel */
  .product-cta { padding: 24px var(--bb-pad-mobile); background: var(--bb-green-light); }
  @media (min-width: 1024px) { .product-cta { padding: 32px var(--bb-pad-desktop); } }
  .product-inner {
    background: var(--bb-green-dark);
    color: var(--bb-white);
    border-radius: var(--bb-radius-card);
    padding: 36px 24px 24px;
    /* v3 (Curt round 11 — 2026-05-26): visible overflow so the carousel
       arrows can sit OUTSIDE the dark panel without being clipped. */
    overflow: visible;
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }
  @media (min-width: 1024px) { .product-inner { padding: 28px 48px 20px; } }
