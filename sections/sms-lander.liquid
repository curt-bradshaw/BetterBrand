        var resp = await fetch(SUBMIT_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            phone: d,                  // edge fn converts to E.164
            form: 'sms-vip',
            source: window.location.pathname || 'sms-lander-v3',
          })
        });
        var data = await resp.json();
        if (!data.success) {
          throw new Error(data.error || 'Could not activate VIP status. Please try again.');
        }
        btn.textContent = 'Sent ✓';
        ok.classList.add('show');
        phone.value = '';
      } catch (ex) {
        err.classList.add('show');
        err.textContent = (ex && ex.message) ? ex.message : 'Network error. Please try again.';
        if (phoneWrap) { phoneWrap.classList.add('is-invalid'); setTimeout(function(){ phoneWrap.classList.remove('is-invalid'); }, 350); }
        btn.disabled = false;
        btn.textContent = originalLabel;
      }
    });
  }
  bind('form-hero', 'err-hero', 'ok-hero');
  bind('form-recap', 'err-recap', 'ok-recap');

  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }});
    }, { threshold: 0.18 });
    document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){ el.classList.add('in'); });
  }

  document.querySelectorAll('.faq-item').forEach(function(detail){
    detail.addEventListener('toggle', function(){
      if (detail.open) {
        document.querySelectorAll('.faq-item[open]').forEach(function(other){
          if (other !== detail) other.open = false;
        });
      }
    });
  });

  document.addEventListener('DOMContentLoaded', function(){
    if (typeof Splide === 'undefined') return;
    // v2.1 — Tate feedback 2026-05-22:
    //   Product carousel doesn't actually slide on desktop (4 items @ perPage 4),
    //   so a lone pagination dot was misleading. Hide pagination + arrows on
    //   desktop; reveal them only at breakpoints where items overflow (≤768px).
    //   `mediaQuery: 'min'` + `destroy: true` on the desktop config is fragile,
    //   so we hide via CSS instead (see .product-track .splide__pagination /
    //   .splide__arrows desktop rule below).
    new Splide('#product-carousel', {
      type: 'loop', perPage: 4, perMove: 1, gap: '16px',
      pagination: true, arrows: true, autoplay: true, interval: 4500, pauseOnHover: true,
      breakpoints: { 1200: { perPage: 3 }, 768: { perPage: 2, gap: '12px' }, 560: { perPage: 1, gap: '0' } }
    }).mount();
    new Splide('#reviews-carousel', {
      type: 'loop', perPage: 3, perMove: 1, gap: '20px',
      pagination: true, arrows: true, autoplay: true, interval: 6000, pauseOnHover: true,
      breakpoints: { 1024: { perPage: 2 }, 640: { perPage: 1, gap: '0' } }
    }).mount();
  });
</script>

