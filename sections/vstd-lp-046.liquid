  <script>


 (function(){
  var TARGETS = ["vy-sticky-atc"];
  function wire(sel){
    var links = document.querySelectorAll(sel);
    links.forEach(function(link, i){
      var href = (link.getAttribute('href') || '').trim();
      if (href && href !== '#') return;        // real anchors handled by CSS smooth scroll
      if (link.dataset.cloneNavWired) return;
      link.dataset.cloneNavWired = '1';
      link.addEventListener('click', function(e){
        var id = TARGETS[i]; if (!id) return;
        var t = document.getElementById(id); if (!t) return;
        e.preventDefault();
        t.scrollIntoView({ behavior:'smooth', block:'center' });
      });
    });
  }
  function init(){
    // reliable menu containers; each maps ITS OWN links by index into TARGETS
    // (kept specific so unrelated bare-"#" links elsewhere aren't mis-mapped)
    ['.topMenu a', '.mobilemenu a', 'nav ul li a'].forEach(wire);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})(); 
  
  
  </script>

  <script>


 const TOTAL_NEEDED = 10;

  function injectCharmBar() {
    if (document.getElementById('charm-sticky-bar')) return;

    const bar = document.createElement('div');
    bar.id = 'charm-sticky-bar';
    bar.style = `
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      background: #1e1e1e;
      padding: 14px 20px;
      display: none;
      flex-direction: column;
      align-items: center;
      text-align: center;
      font-family: 'Inter', sans-serif;
      z-index: 100;
    `;

    const msg = document.createElement('div');
    msg.id = 'charm-progress-message';
    msg.style = `
      font-weight: 600;
      font-size: 15px;
      color: #ffffff;
      margin-bottom: 10px;
    `;

    bar.appendChild(msg);
    // Checkout button removed
    document.body.appendChild(bar);
  }

  async function updateCharmBar() {
    try {
      if (window._charmCartUnavailable) return;
      const res = await fetch('/cart.js');
      if (!res.ok) { window._charmCartUnavailable = true; return; }
      const cart = await res.json();

      let charmCount = 0;
      cart.items.forEach(item => {
        const type = item.product_type?.toLowerCase() || '';
        switch (type) {
          case 'mystery10':
            charmCount += item.quantity * 10;
            break;
          case 'mystery5':
            charmCount += item.quantity * 5;
            break;
          case 'charm':
            charmCount += item.quantity;
            break;
        }
      });

      const bar = document.getElementById('charm-sticky-bar');
      const msg = document.getElementById('charm-progress-message');

      if (charmCount >= TOTAL_NEEDED) {
        msg.innerText = '🎉 FREE Bracelet unlocked!.';
        bar.style.display = 'flex';

        if (!window._confettiTriggered) {
          window._confettiTriggered = true;
          confetti({ particleCount: 100, spread: 80, origin: { y: 0.7 } });
        }
      } else {
        bar.style.display = 'none';
        window._confettiTriggered = false;
      }
    } catch (err) {
      console.error('Charm bar error:', err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    injectCharmBar();
    setInterval(updateCharmBar, 2000);
  });

  </script>

