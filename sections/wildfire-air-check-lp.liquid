{%- comment -%}
  ====================================================================
  Wildfire Air Check LP
  ====================================================================
  Port of https://aqi-wildfire.pages.dev/

  Install:
    1. Section: sections/wildfire-air-check-lp.liquid
    2. Template: templates/page.wildfire-air-check.json (layout: theme.old-layout)
    3. Online Store → Pages → assign template "wildfire-air-check"
  ====================================================================
{%- endcomment -%}

<script async type="text/javascript" src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=NYkPJ4"></script>

<style>
/* Hide theme chrome on this page only */
.essential_annoucement_bar_wrapper,
[class*="essential_annoucement_bar"],
[class*="essential_announcement_bar"],
announcement-bar,
.announcement-bar,
.announcement-bar-section,
#shopify-section-announcement-bar,
[id*="announcement"],
[class*="announcement-bar"],
.shopify-section.shipping-bar,
[class*="shipping-bar"],
[id*="shipping_bar"],
[id*="shipping-bar"],
header.header-content,
.header-content,
.site-header,
#shopify-section-header,
#shopify-section-menu-mobile,
#shopify-section-cart-drawer,
[class*="site-header"],
sticky-header,
.header-wrapper,
.shopify-section.section-header,
.shopify-section-header-sticky,
[class*="section-header"],
[id*="section-header"],
.ntg-wrapper > header,
body > header,
footer.footer-content,
.footer-content,
.site-footer,
#shopify-section-footer,
[class*="site-footer"],
.shopify-section .ntg-footer,
.ntg-footer,
[id*="section-footer"],
.patrol-skip-link {
  display: none !important;
}

.ntg-wrapper,
.ntg-main,
#MainContent,
main#MainContent,
.main-content,
[id="MainContent"] {
  padding-top: 0 !important;
  margin-top: 0 !important;
}

/* Theme forces .shopify-section { float: left } — breaks full-width landers */
#shopify-section-{{ section.id }} {
  float: none !important;
  clear: both !important;
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
  display: block !important;
}

/* Beat theme global font-family on * */
.wf-air-check,
.wf-air-check *:not(svg):not(path):not(circle):not(rect):not(line):not(polyline) {
  font-family: var(--font) !important;
}


/* ============ FONTS (open, license-safe for test domain; swap to brand fonts on licensed prod) ============ */
@font-face{font-family:'Hanken';src:url('https://aqi-wildfire.pages.dev/assets/fonts/hankengrotesk-400.woff2') format('woff2');font-weight:400;font-display:swap}
@font-face{font-family:'Hanken';src:url('https://aqi-wildfire.pages.dev/assets/fonts/hankengrotesk-500.woff2') format('woff2');font-weight:500;font-display:swap}
@font-face{font-family:'Hanken';src:url('https://aqi-wildfire.pages.dev/assets/fonts/hankengrotesk-600.woff2') format('woff2');font-weight:600;font-display:swap}
@font-face{font-family:'Hanken';src:url('https://aqi-wildfire.pages.dev/assets/fonts/hankengrotesk-700.woff2') format('woff2');font-weight:700;font-display:swap}
@font-face{font-family:'Hanken';src:url('https://aqi-wildfire.pages.dev/assets/fonts/hankengrotesk-800.woff2') format('woff2');font-weight:800;font-display:swap}

/* ============ TOKENS ============ */
.wf-air-check{
  --bg:#eef1ef; --card:#ffffff; --ink:#1a201c; --muted:#5c655d; --muted-2:#828b82;
  --green:#1A3A1A; --green-2:#0e230f; --green-soft:#2d5a2d;
  --gold:#F2CB49; --gold-2:#d9ad2c; --gold-deep:#234134;
  /* smoke / haze */
  --smoke:#1c1917; --smoke-2:#100e0c; --haze:#c9673a; --haze-soft:#e8ceae;
  /* AQI category scale (semantic, from EPA) */
  --aqi-good:#57a639; --aqi-mod:#e6b800; --aqi-usg:#f57c00; --aqi-bad:#e53935; --aqi-vbad:#8e24aa; --aqi-haz:#7e0023;
  --line:rgba(26,32,28,.12);
  --r:14px; --r-lg:20px; --pill:999px;
  --maxw:1140px;
  --font:'Hanken',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
}
.wf-air-check *,
.wf-air-check *::before,
.wf-air-check *::after{margin:0;padding:0;box-sizing:border-box}
.wf-air-check [hidden]{display:none!important}
.wf-air-check{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
.wf-air-check{font-family:var(--font);color:var(--ink);background:var(--bg);line-height:1.55;font-size:17px;overflow-x:hidden;max-width:100vw}
.wf-air-check img{max-width:100%;display:block}
.wf-air-check a{color:inherit;text-decoration:none}
.wf-air-check button{font-family:inherit;cursor:pointer;border:0;background:0}
.wf-air-check .wf-wrap{max-width:var(--maxw);margin:0 auto;padding:0 22px}
.wf-air-check h1,
.wf-air-check h2,
.wf-air-check h3{line-height:1.04;letter-spacing:-.02em;font-weight:800;color:var(--ink)}
.wf-air-check h1{font-size:clamp(36px,6.2vw,66px)}
.wf-air-check h2{font-size:clamp(28px,4.6vw,46px)}
.wf-air-check h3{font-size:clamp(19px,2.4vw,24px)}
.wf-air-check p{color:var(--muted)}
.wf-air-check .eyebrow{font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--haze)}
.wf-air-check section{position:relative}

/* ============ BUTTONS ============ */
.wf-air-check .wf-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--gold);color:var(--gold-deep);
  font-weight:800;font-size:16px;letter-spacing:.005em;padding:17px 32px;border-radius:var(--pill);cursor:pointer;
  box-shadow:0 12px 26px -12px rgba(217,173,44,.9);transition:transform .15s ease,filter .15s ease;white-space:nowrap}
.wf-air-check .wf-btn:hover{transform:translateY(-2px);filter:brightness(1.02)}
.wf-air-check .wf-btn:active{transform:translateY(0) scale(.985)}
.wf-air-check .wf-btn svg{width:18px;height:18px}

/* ============ TOPBAR ============ */
.wf-air-check .topbar{background:var(--smoke);color:#f0d9b8;text-align:center;font-size:13px;font-weight:600;letter-spacing:.02em;padding:9px 16px;display:flex;align-items:center;justify-content:center;gap:9px}
.wf-air-check .topbar .dot{width:8px;height:8px;border-radius:50%;background:var(--aqi-usg);box-shadow:0 0 0 0 rgba(245,124,0,.6);animation:pulse 1.8s infinite}
.wf-air-check .topbar b{color:#fff}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(245,124,0,.55)}70%{box-shadow:0 0 0 9px rgba(245,124,0,0)}100%{box-shadow:0 0 0 0 rgba(245,124,0,0)}}

/* ============ NAV ============ */
.wf-air-check .nav{position:sticky;top:0;z-index:50;background:rgba(238,241,239,.92);backdrop-filter:saturate(150%) blur(10px);border-bottom:1px solid var(--line)}
.wf-air-check .nav-in{display:flex;align-items:center;justify-content:space-between;height:64px}
.wf-air-check .brand{display:flex;align-items:center;gap:9px}
.wf-air-check .brand img{height:24px;width:auto}
.wf-air-check .brand span{font-weight:800;letter-spacing:-.02em;font-size:17px;color:var(--green)}
.wf-air-check .nav-cta{font-weight:700;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink);border-bottom:2px solid var(--gold);padding-bottom:3px}

/* ============ HERO (full-bleed immersive) ============ */
.wf-air-check .hero{position:relative;isolation:isolate;overflow:hidden;background:#161210;min-height:min(88vh,780px);display:flex;align-items:center;padding:80px 0 64px}
.wf-air-check .hero-bg{position:absolute;inset:0;z-index:-2}
.wf-air-check .hero-bg img{width:100%;height:100%;object-fit:cover;object-position:center 28%}
.wf-air-check .hero-scrim{position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(18,14,11,.5) 0%,rgba(18,14,11,.32) 36%,rgba(18,14,11,.88) 100%)}
.wf-air-check .hero-in{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center}
.wf-air-check .hero-copy .eyebrow{margin-bottom:15px;display:inline-flex;align-items:center;gap:8px;color:#ffca9f}
.wf-air-check .hero-copy .eyebrow .sq{width:9px;height:9px;border-radius:2px;background:var(--aqi-usg)}
.wf-air-check .hero h1{margin-bottom:16px;color:#fff;text-shadow:0 2px 34px rgba(0,0,0,.45)}
.wf-air-check .hero h1 b{color:#ff9a5a}
.wf-air-check .hero-sub{font-size:clamp(16px,1.5vw,19px);color:rgba(255,255,255,.88);max-width:44ch;margin-bottom:24px;line-height:1.55}
.wf-air-check .hero-live{display:inline-flex;align-items:center;gap:13px;background:rgba(16,14,12,.5);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.16);border-radius:12px;padding:11px 16px;color:#fff}
.wf-air-check .hero-live .n{font-size:30px;font-weight:800;line-height:.9;color:#ff6a5a;font-variant-numeric:tabular-nums}
.wf-air-check .hero-live .m b{display:block;font-size:12.5px;font-weight:800;letter-spacing:.04em}
.wf-air-check .hero-live .m i{font-style:normal;font-size:11px;color:#cdd0c9;letter-spacing:.02em}
/* hero form card */
.wf-air-check .check-card{background:var(--card);border:1px solid var(--line);border-radius:var(--r-lg);box-shadow:0 22px 50px -26px rgba(26,58,26,.5);padding:24px 22px}
.wf-air-check .check-card .cc-h{font-size:15px;font-weight:800;color:var(--green);letter-spacing:-.01em;margin-bottom:4px}
.wf-air-check .check-card .cc-s{font-size:13px;color:var(--muted);margin-bottom:16px}
.wf-air-check .air-form{display:flex;flex-direction:column;gap:11px}
.wf-air-check .af-row{display:flex;gap:11px}
.wf-air-check .af-row>*{flex:1;min-width:0}
.wf-air-check .air-input{width:100%;font-family:var(--font);font-size:16px;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:14px 15px;transition:border-color .15s,box-shadow .15s}
.wf-air-check .air-input::placeholder{color:#98a098}
.wf-air-check .air-input:focus{outline:none;border-color:var(--green-soft);box-shadow:0 0 0 3px rgba(45,90,45,.12);background:#fff}
.wf-air-check .air-submit{margin-top:3px;width:100%;background:var(--gold);color:var(--gold-deep);font-family:var(--font);font-weight:800;font-size:16px;letter-spacing:.3px;padding:16px;border-radius:10px;transition:filter .15s,transform .05s}
.wf-air-check .air-submit:hover{filter:brightness(.97)}
.wf-air-check .air-submit:active{transform:translateY(1px)}
.wf-air-check .air-submit[disabled]{opacity:.7;cursor:default}
.wf-air-check .air-consent{font-size:10.5px;line-height:1.5;color:var(--muted-2);margin-top:3px}
.wf-air-check .air-consent a{color:var(--green-soft);text-decoration:underline}
.wf-air-check .air-err{font-size:13px;color:var(--aqi-bad);font-weight:700;margin:0}
.wf-air-check .cc-trust{display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:14px;font-size:11.5px;font-weight:700;letter-spacing:.03em;color:var(--green-soft)}
.wf-air-check .cc-trust span{display:inline-flex;align-items:center;gap:6px}
.wf-air-check .cc-trust .x{color:var(--gold-2)}
.wf-air-check .check-card .cc-h{color:var(--green)}

/* ============ QUADRANT ============ */
.wf-air-check .quad-sec{padding:78px 0}
.wf-air-check .quad-head{text-align:center;max-width:720px;margin:0 auto 40px}
.wf-air-check .quad-head h2{margin-bottom:14px}
.wf-air-check .quad-head p{font-size:17px;max-width:56ch;margin:0 auto}
.wf-air-check .quad{display:grid;grid-template-columns:1fr 1fr;gap:12px;max-width:820px;margin:0 auto;position:relative}
.wf-air-check .qcell{position:relative;background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:26px 24px;overflow:hidden;transition:border-color .5s}
.wf-air-check .qcell .fill{position:absolute;left:0;right:0;bottom:0;height:0;background:linear-gradient(180deg,rgba(229,57,53,.03),rgba(229,57,53,.12));transition:height 1.4s cubic-bezier(.2,.8,.2,1)}
.wf-air-check .qcell.hot .fill{height:100%}
.wf-air-check .qcell.hot{border-color:rgba(229,57,53,.5)}
.wf-air-check .qcell .ql{position:relative;font-size:12.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:6px}
.wf-air-check .qcell .qname{position:relative;font-size:19px;font-weight:800;color:var(--ink);margin-bottom:14px;letter-spacing:-.01em}
.wf-air-check .qcell .qnum{position:relative;font-size:clamp(44px,7vw,64px);font-weight:800;line-height:.9;color:var(--aqi-good);letter-spacing:-.02em;transition:color 1.2s;font-variant-numeric:tabular-nums}
.wf-air-check .qcell .qnum .x{font-size:.5em;font-weight:800;vertical-align:middle;margin-left:2px}
.wf-air-check .qcell.hot .qnum{color:var(--aqi-bad)}
.wf-air-check .qcell .qsub{position:relative;font-size:13.5px;color:var(--muted);margin-top:8px;line-height:1.45}
.wf-air-check .qcell .qbar{position:relative;height:6px;border-radius:6px;background:var(--line);margin-top:14px;overflow:hidden}
.wf-air-check .qcell .qbar i{display:block;height:100%;width:0;border-radius:6px;background:linear-gradient(90deg,var(--aqi-good),var(--aqi-mod),var(--aqi-usg),var(--aqi-bad));transition:width 1.4s cubic-bezier(.2,.8,.2,1)}
.wf-air-check .qcell.hot .qbar i{width:var(--w,88%)}
.wf-air-check .quad-foot{text-align:center;font-size:13px;color:var(--muted-2);max-width:60ch;margin:26px auto 0}
/* drifting particles */
.wf-air-check .particles{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:0}
.wf-air-check .particles span{position:absolute;width:6px;height:6px;border-radius:50%;background:rgba(120,90,60,.28);animation:drift linear infinite}
@keyframes drift{0%{transform:translateY(20px) translateX(0);opacity:0}20%{opacity:1}100%{transform:translateY(-120px) translateX(24px);opacity:0}}

/* ============ CIGARETTE BAND ============ */
.wf-air-check .cig{background:var(--smoke);color:#efe7dc;padding:88px 0;position:relative;overflow:hidden}
.wf-air-check .cig .wf-wrap{position:relative;z-index:1;text-align:center;max-width:820px}
.wf-air-check .cig .eyebrow{color:var(--gold)}
.wf-air-check .cig .big{font-size:clamp(48px,10vw,120px);font-weight:800;line-height:.9;color:#fff;letter-spacing:-.03em;margin:18px 0 6px;font-variant-numeric:tabular-nums}
.wf-air-check .cig .big .u{color:var(--haze)}
.wf-air-check .cig h2{color:#fff;font-size:clamp(24px,3.6vw,36px);max-width:20ch;margin:0 auto 18px}
.wf-air-check .cig p{color:rgba(255,255,255,.7);font-size:16px;max-width:56ch;margin:0 auto 8px}
.wf-air-check .cig .cite{font-size:12.5px;color:rgba(255,255,255,.45);max-width:60ch;margin:16px auto 0}
.wf-air-check .cig-cta{margin-top:30px}

/* ============ PUSH NOTIFICATION ============ */
.wf-air-check .push{padding:84px 0;background:var(--bg)}
.wf-air-check .push-in{display:grid;grid-template-columns:.92fr 1.08fr;gap:52px;align-items:center}
.wf-air-check .push-copy .eyebrow{margin-bottom:13px}
.wf-air-check .push-copy h2{margin-bottom:16px}
.wf-air-check .push-copy p{font-size:17px;margin-bottom:14px}
.wf-air-check .push-copy .checklist{list-style:none;display:grid;gap:11px;margin-top:20px}
.wf-air-check .push-copy .checklist li{display:flex;gap:11px;font-size:15.5px;font-weight:600;color:var(--ink)}
.wf-air-check .push-copy .checklist svg{width:20px;height:20px;color:var(--green-soft);flex:none;margin-top:2px}
/* phone */
.wf-air-check .phone{width:290px;margin:0 auto;background:#000;border-radius:44px;padding:11px;box-shadow:0 40px 80px -30px rgba(0,0,0,.55);border:1px solid #2a2a2a}
.wf-air-check .phone-screen{border-radius:34px;overflow:hidden;position:relative;aspect-ratio:9/19.5;background:
  radial-gradient(120% 80% at 50% 0%, #b5673a 0%, #7a4a2e 42%, #3b2a1e 100%)}
.wf-air-check .phone-notch{position:absolute;top:9px;left:50%;transform:translateX(-50%);width:96px;height:26px;background:#000;border-radius:16px;z-index:3}
.wf-air-check .phone-time{position:absolute;top:64px;left:0;right:0;text-align:center;color:#fff;z-index:2}
.wf-air-check .phone-time .t{font-size:62px;font-weight:700;letter-spacing:-.02em;line-height:1}
.wf-air-check .phone-time .d{font-size:15px;font-weight:600;opacity:.92;margin-top:2px}
.wf-air-check .notif{position:absolute;left:11px;right:11px;top:184px;background:rgba(245,242,238,.82);backdrop-filter:blur(14px);border-radius:17px;padding:12px 13px;z-index:2;
  box-shadow:0 8px 20px rgba(0,0,0,.22);opacity:0;transform:translateY(14px) scale(.98);transition:opacity .6s ease,transform .6s cubic-bezier(.2,.8,.2,1)}
.wf-air-check .notif.in{opacity:1;transform:none}
.wf-air-check .notif-top{display:flex;align-items:center;gap:8px;margin-bottom:5px}
.wf-air-check .notif-ic{width:20px;height:20px;border-radius:5px;background:var(--aqi-usg);display:flex;align-items:center;justify-content:center;flex:none}
.wf-air-check .notif-ic svg{width:13px;height:13px;color:#fff}
.wf-air-check .notif-app{font-size:11.5px;font-weight:700;color:#3a3a3a;letter-spacing:.02em;text-transform:uppercase;flex:1}
.wf-air-check .notif-ago{font-size:11px;color:#8a8a8a}
.wf-air-check .notif-title{font-size:14px;font-weight:800;color:#111;letter-spacing:-.01em;margin-bottom:1px}
.wf-air-check .notif-body{font-size:13px;color:#333;line-height:1.4}

/* ============ SMOKE / INDOOR SECTION ============ */
.wf-air-check .indoor{background:var(--green-2);color:#e7f0e2;padding:84px 0;text-align:center}
.wf-air-check .indoor .eyebrow{color:var(--gold)}
.wf-air-check .indoor h2{color:#fff;max-width:18ch;margin:14px auto 16px}
.wf-air-check .indoor p{color:rgba(255,255,255,.78);font-size:17px;max-width:58ch;margin:0 auto 14px}
.wf-air-check .indoor .cta-row{margin-top:28px}

/* ============ REFRAME / LUNGS ============ */
.wf-air-check .reframe{padding:88px 0}
.wf-air-check .reframe-in{display:grid;grid-template-columns:1fr 1fr;gap:52px;align-items:center}
.wf-air-check .reframe .eyebrow{color:var(--haze);margin-bottom:12px}
.wf-air-check .reframe h2{margin-bottom:16px}
.wf-air-check .reframe p{font-size:17px;margin-bottom:14px}
.wf-air-check .reframe .who{margin-top:18px;font-size:14px;color:var(--muted);font-weight:600}
.wf-air-check .reframe-card{background:var(--green);color:#eaf1e0;border-radius:var(--r-lg);padding:38px 34px}
.wf-air-check .reframe-card h3{color:#fff;margin-bottom:12px}
.wf-air-check .reframe-card p{color:rgba(255,255,255,.8);font-size:15.5px;margin-bottom:18px}
.wf-air-check .reframe-card .wf-btn{width:100%}
.wf-air-check .reframe-card .fine{color:rgba(255,255,255,.55);font-size:12px;margin-top:12px;margin-bottom:0}

/* ============ TRUST STRIP ============ */
.wf-air-check .trust{background:var(--bg);padding:26px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.wf-air-check .trust-in{display:flex;flex-wrap:wrap;justify-content:center;gap:14px 40px;font-size:13.5px;font-weight:700;color:var(--green-soft)}
.wf-air-check .trust-in span{display:inline-flex;align-items:center;gap:8px}
.wf-air-check .trust-in svg{width:18px;height:18px;color:var(--gold-2)}

/* ============ FAQ ============ */
.wf-air-check .faq{padding:76px 0}
.wf-air-check .faq h2{text-align:center;margin-bottom:32px}
.wf-air-check .faq-list{max-width:800px;margin:0 auto}
.wf-air-check details{border-bottom:1px solid var(--line);padding:4px 0}
.wf-air-check summary{list-style:none;cursor:pointer;padding:20px 44px 20px 4px;font-weight:700;font-size:17.5px;color:var(--ink);position:relative;letter-spacing:-.01em}
.wf-air-check summary::-webkit-details-marker{display:none}
.wf-air-check summary::after{content:"+";position:absolute;right:6px;top:15px;font-size:26px;font-weight:400;color:var(--gold-2);transition:transform .2s}
.wf-air-check details[open] summary::after{transform:rotate(45deg)}
.wf-air-check details p{padding:0 44px 22px 4px;font-size:16px;color:var(--muted)}

/* ============ FOOTER ============ */
.wf-air-check footer{background:var(--smoke-2);color:#9a988f;padding:42px 0 30px;font-size:13px}
.wf-air-check .foot-top{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;padding-bottom:24px;border-bottom:1px solid rgba(255,255,255,.08)}
.wf-air-check .foot-brand{display:flex;align-items:center;gap:9px;color:#e7efdc;font-weight:800;font-size:16px}
.wf-air-check .foot-brand img{height:20px}
.wf-air-check .foot-links{display:flex;gap:20px;flex-wrap:wrap}
.wf-air-check .foot-links a{opacity:.8}
