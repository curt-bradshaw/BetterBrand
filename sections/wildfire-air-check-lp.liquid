<script>
// ---- drifting smoke particles in the quadrant section ----
(function(){
  var host=document.getElementById('particles');
  if(!host||window.matchMedia('(prefers-reduced-motion:reduce)').matches) return;
  var n=18;
  for(var i=0;i<n;i++){
    var s=document.createElement('span');
    var size=3+Math.random()*6;
    s.style.left=(Math.random()*100)+'%';
    s.style.bottom=(-10+Math.random()*30)+'px';
    s.style.width=s.style.height=size+'px';
    s.style.animationDuration=(6+Math.random()*7)+'s';
    s.style.animationDelay=(Math.random()*7)+'s';
    s.style.opacity=(0.2+Math.random()*0.3);
    host.appendChild(s);
  }
})();

// ---- quadrant: numbers climb + cells go hot, on scroll into view ----
(function(){
  var quad=document.getElementById('quad');
  if(!quad) return;
  var reduce=window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  var cells=quad.querySelectorAll('.qcell');
  function run(){
    cells.forEach(function(cell,i){
      var numEl=cell.querySelector('.qnum');
      var target=parseInt(numEl.getAttribute('data-target'),10)||0;
      cell.style.setProperty('--w',cell.getAttribute('data-w')||'88%');
      setTimeout(function(){
        cell.classList.add('hot');
        if(reduce){ numEl.firstChild.nodeValue=String(target); return; }
        var dur=1300,t0=performance.now();
        (function tick(now){
          var p=Math.min(1,(now-t0)/dur);
          var eased=1-Math.pow(1-p,3);
          numEl.firstChild.nodeValue=String(Math.round(eased*target));
          if(p<1) requestAnimationFrame(tick); else numEl.firstChild.nodeValue=String(target);
        })(t0);
      }, i*180);
    });
  }
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ run(); io.disconnect(); } });
    },{threshold:.4});
    io.observe(quad);
  } else { run(); }
})();

// ---- cigarette count-up ----
(function(){
  var el=document.getElementById('cig-num');
  if(!el) return;
  var reduce=window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  var target=7;
  if(reduce){ el.textContent=target; return; }
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(!e.isIntersecting) return; io.disconnect();
        var dur=1200,t0=performance.now();
        (function tick(now){
          var p=Math.min(1,(now-t0)/dur);
          el.textContent=Math.round((1-Math.pow(1-p,3))*target);
          if(p<1) requestAnimationFrame(tick); else el.textContent=target;
        })(t0);
      });
    },{threshold:.6});
    io.observe(el);
  } else { el.textContent=target; }
})();

// ---- push notification slide-in ----
(function(){
  var notif=document.getElementById('notif');
  if(!notif) return;
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ setTimeout(function(){notif.classList.add('in');},350); io.disconnect(); } });
    },{threshold:.5});
    io.observe(notif);
  } else { notif.classList.add('in'); }
})();

// ---- live lock-screen clock (uses the visitor's own device time, so it's local to their city) ----
(function(){
  var t=document.getElementById('phone-time'), d=document.getElementById('phone-date');
  if(!t||!d) return;
  var days=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  var months=['January','February','March','April','May','June','July','August','September','October','November','December'];
  function upd(){
    var n=new Date();
    var h=n.getHours()%12; if(h===0) h=12;
    var m=n.getMinutes();
    t.textContent=h+':'+(m<10?'0'+m:m);
    d.textContent=days[n.getDay()]+', '+months[n.getMonth()]+' '+n.getDate();
  }
  upd(); setInterval(upd,15000);
})();

// ---- depth diagram: particles descend into the lungs on scroll ----
(function(){
  var viz=document.querySelector('[data-depth]');
  if(!viz) return;
  if(window.matchMedia('(prefers-reduced-motion:reduce)').matches){ viz.classList.add('go'); return; }
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){viz.classList.add('go');io.disconnect();}});},{threshold:.4});
    io.observe(viz);
  } else { viz.classList.add('go'); }
})();

// ---- custom air-report form -> live AirNow numbers (ported verbatim from AQ v5) ----
(function () {
  const form = document.getElementById('air-form');
  const resultsEl = document.getElementById('air-results');
  if (!form || !resultsEl) return;
  const WORKER = 'https://betterbrand-air-quality.royal-dew-fe05.workers.dev';
  const SERVE = 'https://yswqqjakuifsgslwskgq.supabase.co/functions/v1/serve-form/aq-report/submit';
  const LOGBASE = 'https://yswqqjakuifsgslwskgq.supabase.co/functions/v1/serve-form';
  const VERSION = /(^|\.)trybetterbrand\.com$/.test(location.hostname) ? 'live' : 'aqi-wildfire';
  // BB Pixel: persistent first-party visitor id (survives sessions) — our own tracking, no Northbeam/Meta.
  const VID = (function(){try{let v=localStorage.getItem('bb_vid');if(!v){v='v'+Date.now().toString(36)+Math.random().toString(36).slice(2,10);localStorage.setItem('bb_vid',v);}return v;}catch(_){return '';}})();
  function withRef(u){if(!u)return u;var sep=u.indexOf('?')>-1?'&':'?';return u+sep+'bb_vid='+encodeURIComponent(VID)+'&bb_src='+encodeURIComponent(VERSION);}
  const DISC = 'https://www.trybetterbrand.com/discount/AIR20?redirect=/products/betterlungs-r-mullein-gummies';
  const OFFER_HTML = `<div class="ar-code"><div class="ar-code-top">Your air check unlocked <b>20% off</b> BetterLungs</div><div class="ar-code-chip">CODE: <b>AIR20</b></div><a class="ar-code-cta" href="${withRef(DISC)}" target="_blank" rel="noopener">Shop with 20% off &rarr;</a></div>`;
  function injectOffer(){ var c = resultsEl.querySelector('.ar-cta'); if (c) { c.outerHTML = OFFER_HTML; } else { resultsEl.insertAdjacentHTML('beforeend', OFFER_HTML); } var cc = resultsEl.querySelector('.ar-code-cta'); if (cc) cc.addEventListener('click', function(){ aqTrack('cta_click', { place: 'report_offer' }); }); }
  const SID = (function () {
    try { let s = sessionStorage.getItem('aq_sid'); if (!s) { s = Date.now().toString(36) + Math.random().toString(36).slice(2, 8); sessionStorage.setItem('aq_sid', s); } return s; } catch (_) { return ''; }
  })();
  const T0 = Date.now();
  function aqTrack(type, extra) {
    const payload = Object.assign({ type: type, page_version: VERSION, session_id: SID, vid: VID, path: location.pathname, elapsed_ms: Date.now() - T0 }, extra || {});
    fetch(LOGBASE + '/aq-event', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload), keepalive: true }).catch(() => {});
  }
  (function () {
    try { if (sessionStorage.getItem('aq_viewed')) return; sessionStorage.setItem('aq_viewed', '1'); } catch (_) {}
    fetch(LOGBASE + '/aq-view', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ page_version: VERSION, session_id: SID, vid: VID, path: location.pathname }) }).catch(() => {});
  })();
  (function () {
    let seen = false; const mark = () => { if (!seen) { seen = true; aqTrack('form_seen'); } };
    if ('IntersectionObserver' in window) { const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { mark(); io.disconnect(); } }, { threshold: 0.3 }); io.observe(form); } else { mark(); }
  })();
  (function () {
    let started = false; const touched = {};
    form.addEventListener('focusin', (e) => {
      const f = e.target && e.target.name;
      if (!started) { started = true; aqTrack('form_start', { field: f || '' }); }
      if (f && !touched[f]) { touched[f] = 1; aqTrack('field_focus', { field: f }); }
    });
  })();
  (function(){ var bb = document.querySelector('.wf-btn-buy'); if (bb) { try { bb.href = withRef(bb.getAttribute('href')); } catch (_) {} bb.addEventListener('click', function(){ aqTrack('cta_click', { place: 'offer_section' }); }); } })();
  form.addEventListener('submit', () => { aqTrack('submit_attempt'); }, true);
  const btn = form.querySelector('.air-submit');
  const errEl = form.querySelector('.air-err');
  const escapeHtml = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  function countUp(el, target) {
    const dur = 1100, t0 = performance.now();
    (function tick(now) { const p = Math.min(1, (now - t0) / dur); el.textContent = Math.round((1 - Math.pow(1 - p, 3)) * target); if (p < 1) requestAnimationFrame(tick); else el.textContent = target; })(t0);
  }
  function showErr(m) { if (errEl) { errEl.textContent = m; errEl.hidden = false; } aqTrack('error_shown', { message: m }); }
  function captureLead(d) {
    const digits = (d.phone || '').replace(/\D/g, '');
    if (digits.length >= 10) {
      fetch(SERVE, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ firstName: d.first_name, name: d.first_name, email: d.email, phone: d.phone, page_version: VERSION, properties: { 'Zip Code': d.zip } }) }).catch(() => {});
    } else {
      fetch(WORKER, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: d.email, first_name: d.first_name, zip_code: d.zip, page_version: VERSION }) }).catch(() => {});
    }
  }
  function render(d, email) {
    const worst = d.worst;
    const rest = d.metrics.filter((m) => m.key !== worst.key);
    const pollen = d.pollen ? `<div class="ar-pollen"><b>${escapeHtml(d.pollen.name)} pollen</b> is running <b>${escapeHtml(d.pollen.level)}</b> in your area today.</div>` : '';
    const loc = d.city ? `${escapeHtml(d.city)}${d.state ? ', ' + escapeHtml(d.state) : ''}` : ('ZIP ' + escapeHtml(d.zip));
    resultsEl.innerHTML =
      `<div class="ar-loc">Live air near <b>${loc}</b></div>
       <div class="ar-worst">
         <div class="ar-worst-num" id="ar-worst-num">0</div>
         <div class="ar-worst-meta">
           <div class="ar-worst-label">${escapeHtml(worst.label)} &middot; AQI</div>
           <div class="ar-worst-cat">${escapeHtml(worst.category)}</div>
           <div class="ar-worst-tag">Your highest reading right now</div>
         </div>
       </div>
       ${rest.length ? `<div class="ar-rest">${rest.map((m) => `<div class="ar-chip"><div class="ar-chip-num" data-n="${m.aqi}">0</div><div class="ar-chip-label">${escapeHtml(m.label)}</div><div class="ar-chip-cat" style="color:${escapeHtml(m.color)}">${escapeHtml(m.category)}</div></div>`).join('')}</div>` : ''}
       ${pollen}
       <p class="ar-foot">Live readings from the U.S. EPA AirNow network${email ? `. Your full personalized report is on its way to <b>${escapeHtml(email)}</b>` : ''}.</p>
       <a href="#reframe" class="ar-cta">See how to protect your lungs &darr;</a>`;
    form.hidden = true; resultsEl.hidden = false;
    countUp(document.getElementById('ar-worst-num'), worst.aqi);
    resultsEl.querySelectorAll('.ar-chip-num').forEach((el) => countUp(el, parseInt(el.dataset.n, 10)));
    injectOffer();
  }
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (errEl) errEl.hidden = true;
    const fd = new FormData(form);
    const d = {
      first_name: (fd.get('first_name') || '').toString().trim(),
      zip: (fd.get('zip') || '').toString().replace(/\D/g, '').slice(0, 5),
      email: (fd.get('email') || '').toString().trim(),
      phone: (fd.get('phone') || '').toString().trim(),
    };
    if (d.zip.length !== 5) { showErr('Please enter a valid 5-digit ZIP code.'); return; }
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(d.email)) { showErr('Please enter a valid email address.'); return; }
    btn.disabled = true; const orig = btn.innerHTML; btn.textContent = 'Pulling your live readings…';
    captureLead(d);
    fetch(LOGBASE + '/aq-log', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ page_version: VERSION, session_id: SID, vid: VID, email: d.email, phone: d.phone, zip: d.zip, first_name: d.first_name }), keepalive: true }).catch(() => {});
    try {
      const res = await fetch(WORKER + '/aqi?zip=' + d.zip);
      const data = await res.json();
      if (data && data.ok && data.metrics && data.metrics.length) {
        render(data, d.email);
      } else {
        resultsEl.innerHTML =
          `<div class="ar-loc">You're in &check;</div>
           <p class="ar-foot">We couldn't reach a live monitor near <b>ZIP ${escapeHtml(d.zip)}</b> this minute, but your full personalized report is on its way to <b>${escapeHtml(d.email)}</b>. Keep scrolling to see what the numbers mean.</p>
           <a href="#reframe" class="ar-cta">How to protect your lungs &darr;</a>`;
        form.hidden = true; resultsEl.hidden = false;
        injectOffer();
      }
    } catch (_e) {
      btn.disabled = false; btn.innerHTML = orig;
      showErr("Couldn't pull your readings just now — your report is still on its way. Try again or keep scrolling.");
    }
  });
})();
</script>
</div>

