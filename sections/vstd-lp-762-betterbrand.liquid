  <script>

  document.addEventListener('DOMContentLoaded', () => {
    const journeyItems = document.querySelectorAll('.vy-adv-content__timeline');
    let lastScrollY = window.scrollY;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const target = entry.target;
        const currentScrollY = window.scrollY;
        const isScrollingDown = currentScrollY > lastScrollY;

        if (entry.isIntersecting) {
          // Add a delay before adding the 'active' class
          target._activeTimeout = setTimeout(() => {
            target.classList.add('active');
          }, 300);
        } else {
          clearTimeout(target._activeTimeout);
          // Remove 'active' only when scrolling up
          if (!isScrollingDown) {
            target.classList.remove('active');
          }
        }

        // Update lastScrollY for next entry
        lastScrollY = currentScrollY;
      });
    }, { threshold: 1 });

    journeyItems.forEach(item => {
      observer.observe(item);
    });
  });

  </script>

