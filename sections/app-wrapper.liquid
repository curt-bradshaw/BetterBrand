<div{% if section.settings.section_id != blank %} id="{{ section.settings.section_id | strip | escape }}"{% endif %} class="app-wrapper">
  {%- for block in section.blocks -%}
    {% render block %}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "App wrapper",
  "tag": "section",
  "class": "section app-wrapper-section",
  "settings": [
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Optional HTML id for this section wrapper (e.g. trustpilot-reviews)."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "App wrapper"
    }
  ]
}
{% endschema %}
