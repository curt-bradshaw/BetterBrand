  .aq-cig b{color:var(--danger)}
  .aq-cig .rr-rods{display:flex;align-items:flex-end;flex-wrap:wrap;gap:6px;margin:0 0 13px}
  .aq-cig .rr-rods .rod{width:11px;height:36px;border-radius:2px;background:linear-gradient(180deg,#fff 0 60%,#e7c88c 60%,#caa863);position:relative;border:1px solid rgba(0,0,0,.14)}
