<div class="aq-report-v3">
<!-- ENTRY (full-screen) -->
<section class="entry" id="entry">
  <div class="entry-bg"><img src="https://air-report.pages.dev/assets/img/hero-city.png" alt="A city skyline under heavy smoke haze" fetchpriority="high"></div>
  <div class="entry-scrim"></div>
  <div class="wrap entry-nav">
    <img class="entry-logo" src="https://air-report.pages.dev/assets/img/betterbrand-logo-green.png" alt="BetterBrand">
    <div class="entry-brand" style="font-weight:600;font-size:12.5px;color:rgba(255,255,255,.7);letter-spacing:.06em;text-transform:uppercase">The Air Report</div>
  </div>
  <div class="wrap entry-mid">
    <div class="entry-eyebrow">The Air Report &middot; Live U.S. EPA data</div>
    <h1>What's really in the air you breathe?</h1>
    <p class="entry-sub">Enter your ZIP for a free, full report on what you're breathing where you live, in 60 seconds.</p>
    <form class="entry-form" id="air-form" novalidate>
      <div class="row">
        <input class="fin" type="text" name="first_name" placeholder="First name" autocomplete="given-name">
        <input class="fin" type="text" name="zip" inputmode="numeric" placeholder="ZIP code" autocomplete="postal-code" required>
      </div>
      <input class="fin" type="email" name="email" placeholder="Email address" autocomplete="email" required>
      <input class="fin" type="tel" name="phone" placeholder="Mobile (optional, for air alerts)" autocomplete="tel">
      <button class="fbtn" type="submit">See my air report &rarr;</button>
      <p class="ferr" hidden></p>
    </form>
    <div class="entry-trust">
      <span><span class="x">&#10003;</span> Live EPA data</span>
      <span><span class="x">&#10003;</span> 60 seconds</span>
      <span><span class="x">&#10003;</span> No purchase necessary</span>
    </div>
    <p class="entry-consent">By checking your air you agree to receive your free report and occasional air-quality and product emails or texts from BetterBrand. Unsubscribe anytime.</p>
  </div>
</section>

<div class="report" id="report" hidden></div>
</div>

<script>
(function () {
  const form = document.getElementById('air-form');
  const report = document.getElementById('report');
  if (!form || !report) return;
  const WORKER = 'https://betterbrand-air-quality.royal-dew-fe05.workers.dev';
  const SERVE = 'https://yswqqjakuifsgslwskgq.supabase.co/functions/v1/serve-form/aq-report/submit';
  const LOGBASE = 'https://yswqqjakuifsgslwskgq.supabase.co/functions/v1/serve-form';
  const VERSION = 'air-report';
  const VAR1=50211146957099, SUBPLAN=118714663211;
  const URL_SUB='https://www.trybetterbrand.com/cart/'+VAR1+':1?selling_plan='+SUBPLAN;
  const URL_ONCE='https://www.trybetterbrand.com/cart/'+VAR1+':1?discount=AIR20';
  const BUYBOX=
    '<div class="bb">'+
      '<div class="bb-head"><img class="bb-thumb" src="https://air-report.pages.dev/assets/img/gummies-1bag.jpg" alt="BetterLungs Mullein Gummies pouch" loading="lazy"><div class="bb-htx"><div class="bb-title">BetterLungs® Mullein Gummies</div><div class="bb-supply" id="bb-supply">30-day supply</div></div></div>'+
      '<div class="bb-packs">'+
        '<button type="button" class="pk selected" data-pack="1">1 Bag</button>'+
        '<button type="button" class="pk" data-pack="3">3 Bags<small>Save more</small></button>'+
        '<button type="button" class="pk" data-pack="6">6 Bags<small>Best price</small></button>'+
      '</div>'+
      '<div class="bb-plan selected" id="bb-sub" data-plan="sub"><span class="bb-radio"></span><div class="bb-plan-main"><div class="bb-plan-name">Subscribe &amp; Save <span class="bb-best">Best value</span></div><div class="bb-plan-desc" id="bb-sub-desc">20% off · ships monthly · cancel anytime</div></div><div class="bb-plan-price" id="bb-sub-price"><span class="bb-now">$27.96</span><span class="bb-was">$34.95</span><span class="bb-per">/mo</span></div></div>'+
      '<div class="bb-plan" id="bb-once" data-plan="once"><span class="bb-radio"></span><div class="bb-plan-main"><div class="bb-plan-name">One-time purchase</div><div class="bb-plan-desc">20% off with code AIR20</div></div><div class="bb-plan-price" id="bb-once-price"><span class="bb-now">$27.96</span><span class="bb-was">$34.95</span></div></div>'+
      '<a class="bb-cta" id="bb-cta" href="#" target="_blank" rel="noopener">Subscribe · $27.96/mo &rarr;</a>'+
      '<div class="bb-trust"><span>✓ 365-day guarantee</span><span>✓ Free shipping</span><span>✓ Cancel anytime</span></div>'+
    '</div>';
  const STICKY='<div class="bb-sticky" id="bb-sticky"><div class="bb-sticky-in"><div class="lbl">BetterLungs® Gummies <span id="bb-sticky-sub">Subscribe &amp; Save · $27.96</span></div><a id="bb-sticky-cta" href="'+URL_SUB+'" target="_blank" rel="noopener">Add to cart</a></div></div>';
  const SID = (function(){try{let s=sessionStorage.getItem('aq_sid');if(!s){s=Date.now().toString(36)+Math.random().toString(36).slice(2,8);sessionStorage.setItem('aq_sid',s);}return s;}catch(_){return '';}})();
  // BB Pixel: persistent first-party visitor id (survives sessions) — our own tracking, no Northbeam/Meta.
  const VID = (function(){try{let v=localStorage.getItem('bb_vid');if(!v){v='v'+Date.now().toString(36)+Math.random().toString(36).slice(2,10);localStorage.setItem('bb_vid',v);}return v;}catch(_){return '';}})();
  function withRef(u){var sep=u.indexOf('?')>-1?'&':'?';return u+sep+'bb_vid='+encodeURIComponent(VID)+'&bb_src='+encodeURIComponent(VERSION);}
  const T0 = Date.now();
  function aqTrack(t,x){fetch(LOGBASE+'/aq-event',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.assign({type:t,page_version:VERSION,session_id:SID,vid:VID,path:location.pathname,elapsed_ms:Date.now()-T0},x||{})),keepalive:true}).catch(()=>{});}
  (function(){try{if(sessionStorage.getItem('aq_viewed'))return;sessionStorage.setItem('aq_viewed','1');}catch(_){}fetch(LOGBASE+'/aq-view',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({page_version:VERSION,session_id:SID,vid:VID,path:location.pathname})}).catch(()=>{});})();
  form.addEventListener('focusin',(function(){let s=false;const t={};return function(e){var f=e.target&&e.target.name;if(!s){s=true;aqTrack('form_start',{field:f||''});}if(f&&!t[f]){t[f]=1;aqTrack('field_focus',{field:f});}};})());
  form.addEventListener('submit',()=>{aqTrack('submit_attempt');},true);
  const btn=form.querySelector('.fbtn'), errEl=form.querySelector('.ferr');
  const esc=(s)=>String(s).replace(/[&<>"]/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  function showErr(m){if(errEl){errEl.textContent=m;errEl.hidden=false;}aqTrack('error_shown',{message:m});}
  function captureLead(d){const digits=(d.phone||'').replace(/\D/g,'');if(digits.length>=10){fetch(SERVE,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({firstName:d.first_name,name:d.first_name,email:d.email,phone:d.phone,page_version:VERSION,properties:{'Zip Code':d.zip}})}).catch(()=>{});}else{fetch(WORKER,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:d.email,first_name:d.first_name,zip_code:d.zip,page_version:VERSION})}).catch(()=>{});}}
  function pm25FromAqi(a){var bp=[[0,50,0,9],[51,100,9.1,35.4],[101,150,35.5,55.4],[151,200,55.5,125.4],[201,300,125.5,225.4],[301,500,225.5,325.4]];for(var i=0;i<bp.length;i++){var b=bp[i];if(a<=b[1])return (a-b[0])/(b[1]-b[0])*(b[3]-b[2])+b[2];}return 325;}
  function countUp(el,target,dur){var t0=performance.now();(function tick(now){var p=Math.min(1,(now-t0)/(dur||1200));el.textContent=Math.round((1-Math.pow(1-p,3))*target);if(p<1)requestAnimationFrame(tick);else el.textContent=target;})(t0);}
  function topbar(){return '<div class="rep-top"><img class="rep-logo" src="https://air-report.pages.dev/assets/img/betterbrand-logo-green.png" alt="BetterBrand"><button class="rep-close" id="rep-close">Start over</button></div>';}
  function textColor(cat){cat=(cat||'').toLowerCase();if(cat.indexOf('good')>=0)return '#2f7d20';if(cat.indexOf('sensitive')>=0)return '#c25200';if(cat.indexOf('moderate')>=0)return '#8a6a00';if(cat.indexOf('very')>=0)return '#7b1fa2';if(cat.indexOf('hazard')>=0)return '#7e0023';if(cat.indexOf('unhealthy')>=0)return '#c62828';return '#2a2f33';}
  function closeReport(){report.classList.remove('on');document.body.style.overflow='';setTimeout(function(){report.hidden=true;report.scrollTop=0;},450);}
  var PACKS={
    '1':{v:50211146957099, sub:{plan:118714663211,price:'$27.96',per:'/mo',cad:'ships monthly'}, once:'$27.96', was:'$34.95', supply:'30-day supply'},
    '3':{v:50211146989867, sub:{plan:118714728747,price:'$69.90',per:'/3 mo',cad:'ships every 3 months'}, once:'$75.48', was:'$94.35', supply:'90-day supply · $25.16/bag'},
    '6':{v:51683833741611, sub:null, once:'$142.56', was:'$178.20', supply:'180-day supply · $23.76/bag'}
  };
  function wireBuyBox(){
    var packEls=report.querySelectorAll('.pk'); if(!packEls.length){ var rc0=document.getElementById('rep-close'); if(rc0) rc0.addEventListener('click',closeReport); return; }
    var subCard=document.getElementById('bb-sub'), onceCard=document.getElementById('bb-once'),
        subPrice=document.getElementById('bb-sub-price'), subDesc=document.getElementById('bb-sub-desc'),
        oncePrice=document.getElementById('bb-once-price'), cta=document.getElementById('bb-cta'),
        supplyEl=document.getElementById('bb-supply');
    var st={pack:'1', plan:'sub'};
    function render(){
      var p=PACKS[st.pack];
      if(!p.sub && st.plan==='sub') st.plan='once';
      packEls.forEach(function(b){b.classList.toggle('selected', b.getAttribute('data-pack')===st.pack);});
      supplyEl.textContent=p.supply;
      subCard.classList.toggle('disabled', !p.sub);
      if(p.sub){ subPrice.innerHTML='<span class="bb-now">'+p.sub.price+'</span><span class="bb-was">'+p.was+'</span><span class="bb-per">'+p.sub.per+'</span>'; subDesc.textContent='20% off · '+p.sub.cad+' · cancel anytime'; }
      else { subPrice.innerHTML='<span class="bb-na">Not for this size</span>'; subDesc.textContent='Choose 1 or 3 bags to subscribe'; }
      oncePrice.innerHTML='<span class="bb-now">'+p.once+'</span><span class="bb-was">'+p.was+'</span>';
      subCard.classList.toggle('selected', st.plan==='sub' && !!p.sub);
      onceCard.classList.toggle('selected', st.plan==='once');
      var url,label;
      if(st.plan==='sub' && p.sub){ url='https://www.trybetterbrand.com/cart/'+p.v+':1?selling_plan='+p.sub.plan; label='Subscribe · '+p.sub.price+p.sub.per+' &rarr;'; }
      else { url='https://www.trybetterbrand.com/cart/'+p.v+':1?discount=AIR20'; label='Add to cart · '+p.once+' &rarr;'; }
      cta.setAttribute('href',withRef(url)); cta.innerHTML=label;
    }
    packEls.forEach(function(b){b.addEventListener('click',function(){st.pack=b.getAttribute('data-pack');render();});});
    subCard.addEventListener('click',function(){if(subCard.classList.contains('disabled'))return;st.plan='sub';render();});
    onceCard.addEventListener('click',function(){st.plan='once';render();});
    cta.addEventListener('click',function(){aqTrack('cta_click',{plan:st.plan,pack:st.pack});});
    render();
    var rc=document.getElementById('rep-close'); if(rc) rc.addEventListener('click',closeReport);
  }

  function reveal(){report.hidden=false;document.body.style.overflow='hidden';requestAnimationFrame(function(){report.classList.add('on');});}

  function buildReport(d,email){
    var worst=d.worst;
    var color=worst.color||'#e53935';
    var loc=d.city?esc(d.city)+(d.state?', '+esc(d.state):''):('ZIP '+esc(d.zip));
    var now=new Date(); var months=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var datestr=months[now.getMonth()]+' '+now.getDate()+', '+now.getFullYear();
    var pm=(d.metrics||[]).filter(function(m){return /pm\s*2\.?5/i.test((m.label||'')+' '+(m.key||''));})[0];
    var cigN=null;
    if(pm){var conc=(typeof pm.conc==='number')?pm.conc:(typeof pm.value==='number'?pm.value:pm25FromAqi(pm.aqi));cigN=Math.max(1,Math.round(conc/22));}
    var hook = cigN
      ? 'Breathing today’s air is like <span class="hl">'+cigN+' cigarette'+(cigN===1?'':'s')+' a day</span>'
      : 'The air where you live is <span class="hl">'+esc(worst.category)+'</span> today';
    var rodsHtml='';
    if(cigN){var rn=Math.min(cigN,12),rh='';for(var i=0;i<rn;i++)rh+='<span class="rod"></span>';rodsHtml='<div class="rr-rods">'+rh+'</div>';}
    var tc=textColor(worst.category);
    var rest=(d.metrics||[]).filter(function(m){return m.key!==worst.key;});
    var chips=rest.map(function(m){var mtc=textColor(m.category);return '<div class="rd-o"><span class="l">'+esc(m.label)+'</span><span class="v" data-n="'+m.aqi+'" style="color:'+mtc+'">0</span></div>';}).join('');
    var pollen=d.pollen?' '+esc(d.pollen.name)+' pollen is running <b>'+esc(d.pollen.level)+'</b> today.':'';
    report.innerHTML =
      topbar()+
      '<div class="rr-body">'+
        '<div class="rr-loc">The air in '+loc+'</div>'+
        '<h1 class="rr-hook">'+hook+'</h1>'+
        '<div class="rr-read"><div class="rd-main"><span class="n" id="rr-big" style="color:'+tc+'">0</span><div class="rd-lab"><span class="c" style="color:'+tc+'"><span class="dot" style="background:'+color+'"></span>'+esc(worst.category)+'</span><span class="sub">'+esc(worst.label)+' · AQI</span></div></div>'+
          (chips?'<div class="rd-others">'+chips+'</div>':'')+'</div>'+
        '<div class="rr-src"><b>Live U.S. EPA readings</b> for '+loc+', '+datestr+'.</div>'+
        '<div class="rr-do"><h2 class="rr-do-q">What can I do about it?</h2>'+
          '<p class="rr-do-a">You can’t filter the sky, but you can support <b>your lungs</b>, the one filter you can’t replace. BetterLungs® is a once-a-day mullein gummy that helps.</p></div>'+
        '<div class="rr-side">'+
          BUYBOX+
          (email?'<div class="rr-mailed">Full report also sent to <b>'+esc(email)+'</b></div>':'')+
        '</div>'+
      '</div>'+
      '<section class="rr-disc"><p>The cigarette comparison is an estimate from live PM2.5 (Berkeley Earth: ~22 µg/m³ ≈ one cigarette), not a medical measurement. Air-quality readings are sourced from public monitoring networks for general information only and are not a medical or safety assessment. BetterLungs® is a dietary supplement; these statements have not been evaluated by the FDA and it is not intended to diagnose, treat, cure, or prevent any disease. Individual results vary.</p></section>';
    reveal();
    countUp(document.getElementById('rr-big'), worst.aqi, 1200);
    report.querySelectorAll('.rd-o .v').forEach(function(el){countUp(el,parseInt(el.dataset.n,10),1000);});
    wireBuyBox();
  }
  function buildFallback(zip,email){
    report.innerHTML=
      topbar()+
      '<div class="rr-body">'+
        '<div class="rr-loc">Your air report · ZIP '+esc(zip)+'</div>'+
        '<h1 class="rr-hook">Your report is <span class="hl">on its way</span>.</h1>'+
        '<p class="rr-note">We couldn’t reach a live monitor near you this minute, but your full personalized report is on its way'+(email?' to <b>'+esc(email)+'</b>':'')+'. In the meantime, here’s the daily habit that helps.</p>'+
      '<div class="rr-do"><h2 class="rr-do-q">What can I do about it?</h2><p class="rr-do-a">You can’t filter the sky. But you can support the one filter that’s with you every breath: your lungs. BetterLungs® is a once-a-day mullein gummy made to support easier, fuller breathing.</p></div>'+
      '<div class="rr-side">'+BUYBOX+'</div></div>';
    reveal(); wireBuyBox();
  }

  form.addEventListener('submit', async function(e){
    e.preventDefault();
    if(errEl) errEl.hidden=true;
    var fd=new FormData(form);
    var d={first_name:(fd.get('first_name')||'').toString().trim(),zip:(fd.get('zip')||'').toString().replace(/\D/g,'').slice(0,5),email:(fd.get('email')||'').toString().trim(),phone:(fd.get('phone')||'').toString().trim()};
    if(d.zip.length!==5){showErr('Please enter a valid 5-digit ZIP code.');return;}
    if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(d.email)){showErr('Please enter a valid email address.');return;}
    btn.disabled=true; var orig=btn.innerHTML; btn.textContent='Pulling your live readings…';
    captureLead(d);
    fetch(LOGBASE+'/aq-log',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({page_version:VERSION,session_id:SID,vid:VID,email:d.email,phone:d.phone,zip:d.zip,first_name:d.first_name}),keepalive:true}).catch(()=>{});
    try{
      var res=await fetch(WORKER+'/aqi?zip='+d.zip);
      var data=await res.json();
      if(data&&data.ok&&data.metrics&&data.metrics.length){ buildReport(data,d.email); }
      else { buildFallback(d.zip,d.email); }
    }catch(_e){ btn.disabled=false; btn.innerHTML=orig; showErr('Couldn’t pull your readings just now. Try again in a moment.'); return; }
    btn.disabled=false; btn.innerHTML=orig;
  });

  // Direct preview: open /?zip=78201 (or /?preview) to jump straight to the report, no form, no lead capture
  (function(){
    var m=(location.search||'').match(/[?&]zip=(\d{5})/);
    var zip = m ? m[1] : (/[?&]preview/.test(location.search) ? '10001' : null);
    if(!zip) return;
    fetch(WORKER+'/aqi?zip='+zip).then(function(r){return r.json();}).then(function(data){
      if(data&&data.ok&&data.metrics&&data.metrics.length) buildReport(data,''); else buildFallback(zip,'');
    }).catch(function(){ buildFallback(zip,''); });
  })();
})();
</script>

