  .aq-tips li:last-child{margin-bottom:0}
  .aq-tips li::before{content:"";position:absolute;left:2px;top:7px;width:9px;height:9px;border-radius:50%;background:var(--green)}
  .aq-tips li b{font-weight:800}
  .aq-pollen{font-size:14px;color:var(--ink);background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 15px;margin-top:16px}
  /* the sell — one slim strip, ~10% of the page */
  .aq-sell{display:flex;align-items:center;gap:14px;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px 16px;margin-top:36px}
  .aq-sell img{width:52px;height:52px;border-radius:11px;object-fit:cover;flex:none;border:1px solid var(--line);background:#eef2ec}
  .aq-sell-tx{flex:1;min-width:0}
  .aq-sell-tx .t{font-size:15px;font-weight:800;color:var(--ink);line-height:1.25}
  .aq-sell-tx .s{font-size:12.5px;color:var(--muted);margin-top:4px;line-height:1.45}
  .aq-sell-cta{flex:none;background:var(--gold);color:var(--gold-deep);font-weight:800;font-size:14px;padding:12px 16px;border-radius:10px;white-space:nowrap}
  .aq-sell-cta:hover{filter:brightness(.98)}
  @media(max-width:560px){
    .aq-grid{grid-template-columns:1fr}
    .aq-card{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
