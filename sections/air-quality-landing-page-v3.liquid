.aq-report-v3 .rr-side{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:22px;box-shadow:0 24px 60px -38px rgba(0,0,0,.45);margin-top:16px}
.aq-report-v3 .rr-do{margin-top:34px}
.aq-report-v3 .rr-do-q{font-size:clamp(24px,3.6vw,33px);font-weight:800;color:var(--ink);letter-spacing:-.01em;margin-bottom:12px}
