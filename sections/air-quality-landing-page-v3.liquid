  .aq-block{margin-top:32px}
  .aq-h{font-size:19px;font-weight:800;color:var(--ink);letter-spacing:-.01em;margin:0 0 14px}
  .aq-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
  .aq-card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px}
  .aq-card .top{display:flex;align-items:center;justify-content:space-between;gap:8px}
  .aq-card .lab{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.03em;color:var(--muted)}
  .aq-card .badge{font-size:9.5px;font-weight:800;text-transform:uppercase;letter-spacing:.02em;padding:3px 8px;border-radius:999px;background:#eef2ec;white-space:nowrap}
  .aq-card .val{font-size:34px;font-weight:800;line-height:1;letter-spacing:-.02em;font-variant-numeric:tabular-nums;margin:9px 0}
  .aq-card .desc{font-size:12.5px;color:var(--muted);line-height:1.5;margin:0}
  .aq-guide{font-size:16px;color:var(--ink);line-height:1.6;margin:0;max-width:62ch}
  .aq-note{font-size:13px;color:var(--muted);line-height:1.55;margin:12px 0 0;padding-left:14px;border-left:3px solid var(--line);max-width:62ch}
  .aq-tips{list-style:none;margin:0;padding:0}
