  .aq-big .unit{font-size:15px;font-weight:800;color:var(--muted);letter-spacing:.05em}
  .aq-cat{display:inline-flex;align-items:center;gap:9px;font-size:14px;font-weight:800;text-transform:uppercase;letter-spacing:.03em;margin-top:10px}
  .aq-cat .dot{width:12px;height:12px;border-radius:50%;flex:none}
  .aq-scale{position:relative;height:12px;border-radius:7px;margin:18px 0 7px;background:linear-gradient(90deg,#7cb342 0%,#f9d423 20%,#ff9800 40%,#e53935 60%,#8e24aa 80%,#7e0023 100%)}
  .aq-marker{position:absolute;top:-5px;width:4px;height:22px;background:#0f1512;border-radius:3px;box-shadow:0 0 0 2px #fff;transform:translateX(-2px)}
