.aq-report-v3{
  --bg:#f4f6f7; --card:#fff; --ink:#161a1c; --muted:#5b646a; --muted-2:#8a9196; --line:rgba(22,26,28,.12);
  --green:#1A3A1A; --green-soft:#2d5a2d; --gold:#F2CB49; --gold-2:#d9ad2c; --gold-deep:#234134;
  --muted-2b:#6f767b;
  --charcoal:#14181a; --charcoal-2:#0b0e0f; --danger:#ef4a2a;
  --aqi-good:#57a639; --aqi-mod:#e6b800; --aqi-usg:#f57c00; --aqi-bad:#e53935; --aqi-vbad:#8e24aa; --aqi-haz:#7e0023;
  --font:'Hanken',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  font-family:var(--font);color:var(--ink);background:var(--charcoal);line-height:1.55;font-size:17px;-webkit-font-smoothing:antialiased;
}
.aq-report-v3 *,
.aq-report-v3 *::before,
.aq-report-v3 *::after{margin:0;padding:0;box-sizing:border-box}
.aq-report-v3 [hidden]{display:none!important}
.aq-report-v3 img{max-width:100%;display:block}
.aq-report-v3 a{color:inherit;text-decoration:none}
.aq-report-v3 button{font-family:inherit;cursor:pointer;border:0;background:0}
.aq-report-v3 h1,
.aq-report-v3 h2,
.aq-report-v3 h3{line-height:1.04;letter-spacing:-.02em;font-weight:800}
.aq-report-v3 .wrap{max-width:920px;margin:0 auto;padding:0 22px}

/* ============ ENTRY (full-screen) ============ */
.aq-report-v3 .entry{position:relative;min-height:100dvh;display:flex;flex-direction:column;overflow:hidden;isolation:isolate}
.aq-report-v3 .entry-bg{position:absolute;inset:0;z-index:-2}
.aq-report-v3 .entry-bg img{width:100%;height:100%;object-fit:cover;object-position:center 34%}
.aq-report-v3 .entry-scrim{position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(11,14,15,.7),rgba(11,14,15,.55) 45%,rgba(11,14,15,.9))}
.aq-report-v3 .entry-nav{display:flex;align-items:center;justify-content:space-between;padding:22px 0}
.aq-report-v3 .entry-brand{color:#fff;font-weight:800;font-size:16px}
.aq-report-v3 .entry-brand span{color:rgba(255,255,255,.7);font-weight:600;margin-left:7px}
.aq-report-v3 .entry-logo{height:22px;width:auto;filter:brightness(0) invert(1)}
.aq-report-v3 .rep-logo{height:19px;width:auto}
.aq-report-v3 .entry-mid{flex:1;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:30px 0 60px}
.aq-report-v3 .entry-eyebrow{font-size:12px;font-weight:800;letter-spacing:.22em;text-transform:uppercase;color:#ffca9f;margin-bottom:18px}
.aq-report-v3 .entry h1{color:#fff;font-size:clamp(38px,6vw,68px);max-width:16ch;margin-bottom:16px;text-shadow:0 2px 40px rgba(0,0,0,.5)}
.aq-report-v3 .entry-sub{color:rgba(255,255,255,.85);font-size:clamp(16px,1.6vw,19px);max-width:44ch;margin-bottom:30px}
.aq-report-v3 .entry-form{width:100%;max-width:440px;display:flex;flex-direction:column;gap:11px}
.aq-report-v3 .entry-form .row{display:flex;gap:11px}
.aq-report-v3 .entry-form .row>*{flex:1;min-width:0}
.aq-report-v3 .fin{width:100%;font-family:var(--font);font-size:16px;color:#fff;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.24);border-radius:12px;padding:16px 16px;transition:border-color .15s,background .15s}
.aq-report-v3 .fin::placeholder{color:rgba(255,255,255,.6)}
.aq-report-v3 .fin:focus{outline:none;border-color:var(--gold);background:rgba(255,255,255,.16)}
.aq-report-v3 .fbtn{margin-top:3px;width:100%;background:var(--gold);color:var(--gold-deep);font-weight:800;font-size:17px;padding:17px;border-radius:12px;transition:filter .15s,transform .05s}
.aq-report-v3 .fbtn:hover{filter:brightness(.97)}
.aq-report-v3 .fbtn:active{transform:translateY(1px)}
.aq-report-v3 .fbtn[disabled]{opacity:.7}
.aq-report-v3 .ferr{font-size:13px;color:#ff9a7a;font-weight:700;margin:0}
.aq-report-v3 .entry-trust{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 20px;margin-top:20px;font-size:12px;font-weight:700;color:rgba(255,255,255,.8)}
.aq-report-v3 .entry-trust .x{color:var(--gold)}
.aq-report-v3 .entry-consent{font-size:10.5px;color:rgba(255,255,255,.6);max-width:440px;margin:12px auto 0;line-height:1.5}
.aq-report-v3 .entry-consent a{color:#fff;text-decoration:underline}

/* ============ REPORT (full-screen takeover) ============ */
.aq-report-v3 .report{position:fixed;inset:0;z-index:100;background:var(--bg);overflow-y:auto;-webkit-overflow-scrolling:touch;opacity:0;transform:translateY(16px);transition:opacity .45s ease,transform .45s cubic-bezier(.2,.8,.2,1)}
.aq-report-v3 .report.on{opacity:1;transform:none}
.aq-report-v3 .rep-top{display:flex;align-items:center;justify-content:space-between;padding:14px 22px;position:sticky;top:0;background:rgba(244,246,247,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);z-index:2}
.aq-report-v3 .rep-brand{font-weight:800;font-size:15px;color:var(--green)}
.aq-report-v3 .rep-brand span{color:var(--muted);font-weight:600;margin-left:6px}
.aq-report-v3 .rep-close{font-size:13px;font-weight:700;color:var(--muted);border-bottom:1px solid var(--line);padding-bottom:2px}
.aq-report-v3 .rr-body{max-width:640px;margin:0 auto;padding:32px 22px 8px}
.aq-report-v3 .rr-loc{font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--green-soft);margin-bottom:12px}
.aq-report-v3 .rr-hook{font-size:clamp(30px,4.2vw,48px);font-weight:800;line-height:1.05;letter-spacing:-.02em;color:var(--ink);margin-bottom:20px}
.aq-report-v3 .rr-hook .hl{color:var(--danger)}
.aq-report-v3 .rr-rods{display:flex;gap:5px;margin-bottom:22px}
.aq-report-v3 .rr-rods .rod{width:9px;height:28px;border-radius:2px;background:linear-gradient(180deg,#fff 0 58%,#e7c88c 58%,#caa863);position:relative;border:1px solid rgba(0,0,0,.12)}
.aq-report-v3 .rr-rods .rod::before{content:"";position:absolute;top:-4px;left:0;right:0;height:5px;border-radius:2px;background:radial-gradient(circle at 50% 40%,#ffb14a,#e0521e);box-shadow:0 0 6px rgba(224,82,30,.85)}
.aq-report-v3 .rr-num{display:flex;align-items:center;gap:22px;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px 20px;flex-wrap:wrap}
.aq-report-v3 .rr-aqi{display:flex;flex-direction:column;line-height:1}
.aq-report-v3 .rr-aqi .n{font-size:56px;font-weight:800;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
