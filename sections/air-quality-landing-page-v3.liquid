  .pk.selected{border-color:var(--green);color:var(--green);background:#f3f7f2}
  .bb-plan.disabled{opacity:.45;cursor:default}
  .bb-na{font-size:12px;font-weight:700;color:var(--muted-2b)}
  @media(max-width:400px){ .rd-others{margin-left:0} }
  
  /* ===== Rich air-quality report (info-first; sell held to ~10%) ===== */
  .rr-body{max-width:680px;padding:26px 22px 10px}
  .aq-loc{font-size:13px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--green-soft)}
  .aq-loc span{color:var(--muted);font-weight:700}
  .aq-observed{font-size:12px;color:var(--muted);margin-top:5px}
