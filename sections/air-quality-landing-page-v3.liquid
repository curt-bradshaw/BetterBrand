.aq-report-v3 .bb-plan-price{text-align:right;flex:none}
.aq-report-v3 .bb-now{font-size:17px;font-weight:800;color:var(--ink)}
.aq-report-v3 .bb-was{font-size:12px;color:var(--muted-2);text-decoration:line-through;margin-left:5px}
.aq-report-v3 .bb-per{display:block;font-size:11px;color:var(--muted);margin-top:1px}
.aq-report-v3 .bb-cta{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;background:var(--gold);color:var(--gold-deep);font-weight:800;font-size:16px;padding:16px;border-radius:12px;margin-top:6px;box-shadow:0 14px 28px -14px rgba(217,173,44,.9);transition:filter .15s}
.aq-report-v3 .bb-cta:hover{filter:brightness(.98)}
.aq-report-v3 .bb-trust{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 14px;margin-top:12px;font-size:11.5px;font-weight:700;color:var(--green-soft)}
.aq-report-v3 .bb-sticky{position:fixed;bottom:0;left:0;right:0;z-index:120;background:rgba(255,255,255,.97);backdrop-filter:blur(10px);border-top:1px solid var(--line);padding:11px 18px;box-shadow:0 -8px 24px -16px rgba(0,0,0,.4);display:none;transform:translateY(110%);transition:transform .3s ease}
.aq-report-v3 .bb-sticky.show{transform:none}
.aq-report-v3 .bb-sticky-in{display:flex;align-items:center;gap:12px}
.aq-report-v3 .bb-sticky .lbl{flex:1;min-width:0;font-size:13px;font-weight:700;color:var(--ink);line-height:1.25}
.aq-report-v3 .bb-sticky .lbl span{display:block;font-size:11px;color:var(--muted);font-weight:600}
.aq-report-v3 .bb-sticky a{background:var(--gold);color:var(--gold-deep);font-weight:800;font-size:15px;padding:14px 22px;border-radius:999px;white-space:nowrap}

