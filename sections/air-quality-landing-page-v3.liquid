      if(cig!==null){var cr=Math.round(cig*10)/10;var cw=(cr===1)?'cigarette':'cigarettes';var whole=Math.min(20,Math.floor(cig));var frac=cig-Math.floor(cig);var rods='<div class="rr-rods" aria-hidden="true">';for(var ri=0;ri<whole;ri++)rods+='<span class="rod"></span>';if(whole<20&&(frac>0.08||whole===0)){var ph=Math.max(8,Math.round(36*(whole===0?Math.max(frac,0.12):frac)));rods+='<span class="rod part" style="height:'+ph+'px"></span>';}if(Math.floor(cig)>20)rods+='<span class="rr-rods-more">+</span>';rods+='</div>';cigTxt='<div class="aq-cig">'+rods+'<div class="aq-cig-tx">Breathing this air for a full day is roughly like smoking <b>'+cr+' '+cw+'</b>.'+((typeof d.pm25_ugm3==='number')?(' Today’s fine-particle level (PM2.5) is <b>'+(Math.round(d.pm25_ugm3*10)/10)+' µg/m³</b>.'):'')+'</div></div>';}
      var cards=(d.metrics||[]).map(function(m){var b=textColor(m.category);return '<div class="aq-card"><div class="top"><span class="lab">'+esc(m.label)+'</span><span class="badge" style="color:'+b+'">'+esc(m.category)+'</span></div><div class="val" data-n="'+m.aqi+'" style="color:'+b+'">0</div><p class="desc">'+(AQ_DESC[m.key]||'')+'</p></div>';}).join('');
      var pollen=d.pollen?'<div class="aq-pollen"><b>'+esc(d.pollen.name||'Pollen')+'</b> is running <b>'+esc(d.pollen.level||'')+'</b> in your area today.</div>':'';
      report.innerHTML=
        topbar()+
        '<div class="rr-body">'+
          '<div class="aq-loc">The air in '+loc+' &middot; <span>Live U.S. EPA data</span></div>'+
          (d.observed?'<div class="aq-observed">Observed '+esc(d.observed)+'</div>':'')+
          '<section class="aq-hero">'+
            '<div class="aq-big"><span class="n" id="rr-big" style="color:'+tc+'">0</span><span class="unit">AQI</span></div>'+
            '<div class="aq-cat" style="color:'+tc+'"><span class="dot" style="background:'+color+'"></span>'+esc(worst.category||'')+'</div>'+
            '<div class="aq-scale"><span class="aq-marker" style="left:'+markerPct+'%"></span></div>'+
            '<div class="aq-scale-lbls"><span>0</span><span>50</span><span>100</span><span>150</span><span>200</span><span>300</span><span>500</span></div>'+
            '<div class="aq-primary">Primary pollutant right now: <b>'+esc(worst.label||'')+'</b></div>'+
          '</section>'+
          cigTxt+
          '<section class="aq-block"><h2 class="aq-h">The pollutants in your air</h2><div class="aq-grid">'+cards+'</div></section>'+
          '<section class="aq-block"><h2 class="aq-h">What this means for you today</h2><p class="aq-guide">'+aqGuide(worst.category)+'</p><p class="aq-note">The Air Quality Index runs from 0 to 500. Under 50 is good, over 100 begins to affect sensitive groups, and over 150 can affect everyone.</p></section>'+
          '<section class="aq-block"><h2 class="aq-h">How to protect yourself today</h2><ul class="aq-tips">'+TIPS+'</ul></section>'+
          pollen+
          sellStrip()+
          (email?'<div class="rr-mailed">Full report also sent to <b>'+esc(email)+'</b></div>':'')+
        '</div>'+
        DISCLAIMER;
      reveal();
      countUp(document.getElementById('rr-big'),overall,1200);
      report.querySelectorAll('.aq-card .val').forEach(function(el){countUp(el,parseInt(el.dataset.n,10),1000);});
      wireReport();
    }
    function buildFallback(zip,email){
      report.innerHTML=
        topbar()+
        '<div class="rr-body">'+
          '<div class="aq-loc">Your air report &middot; ZIP '+esc(zip)+'</div>'+
          '<section class="aq-hero"><h1 class="aq-h" style="font-size:26px;margin-bottom:10px">Your report is on its way</h1><p class="aq-guide">We couldn’t reach a live monitor near you this minute, but your full personalized report is on its way'+(email?' to <b>'+esc(email)+'</b>':'')+'. Here is how to protect your lungs in the meantime.</p></section>'+
          '<section class="aq-block"><h2 class="aq-h">How to protect yourself today</h2><ul class="aq-tips">'+TIPS+'</ul></section>'+
          sellStrip()+
        '</div>'+
        DISCLAIMER;
      reveal(); wireReport();
    }
  
    form.addEventListener('submit', async function(e){
      e.preventDefault();
      if(errEl) errEl.hidden=true;
      var fd=new FormData(form);
      var d={first_name:(fd.get('first_name')||'').toString().trim(),zip:(fd.get('zip')||'').toString().replace(/\D/g,'').slice(0,5),email:(fd.get('email')||'').toString().trim(),phone:(fd.get('phone')||'').toString().trim()};
      if(d.zip.length!==5){showErr('Please enter a valid 5-digit ZIP code.');return;}
      if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(d.email)){showErr('Please enter a valid email address.');return;}
      btn.disabled=true; var orig=btn.innerHTML; btn.textContent='Pulling your live readings…';
      captureLead(d);
      fetch(LOGBASE+'/aq-log',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({page_version:VERSION,variant:VARIANT,day:dayKey(),ts:new Date().toISOString(),session_id:SID,vid:VID,email:d.email,phone:d.phone,zip:d.zip,first_name:d.first_name}),keepalive:true}).catch(()=>{});
      try{if(window.fbq)fbq('trackSingle',PIXEL_ID,'Lead',{content_name:'air-report',page_version:VERSION,variant:VARIANT});}catch(_){}
      try{if(window.Northbeam&&Northbeam.fireEmailCaptureEvent)Northbeam.fireEmailCaptureEvent(d.email);}catch(_){}
      try{
        var res=await fetch(WORKER+'/aqi?zip='+d.zip);
        var data=await res.json();
        if(data&&data.ok&&data.metrics&&data.metrics.length){ buildReport(data,d.email); }
        else { buildFallback(d.zip,d.email); }
      }catch(_e){ btn.disabled=false; btn.innerHTML=orig; showErr('Couldn’t pull your readings just now. Try again in a moment.'); return; }
      btn.disabled=false; btn.innerHTML=orig;
    });
  
    // Direct preview: open /?zip=78201 (or /?preview) to jump straight to the report, no form, no lead capture
    (function(){
      var m=(location.search||'').match(/[?&]zip=(\d{5})/);
      var zip = m ? m[1] : (/[?&]preview/.test(location.search) ? '10001' : null);
      if(!zip) return;
      fetch(WORKER+'/aqi?zip='+zip).then(function(r){return r.json();}).then(function(data){
        if(data&&data.ok&&data.metrics&&data.metrics.length) buildReport(data,''); else buildFallback(zip,'');
      }).catch(function(){ buildFallback(zip,''); });
    })();
  })();
