/* ─── Polaroid family-album collage ───────────────────────────────── */
.polaroid-stack {
  margin: 36px 0 40px;
}
.poly-board {
  position: relative;
  width: 100%;
  max-width: 740px;
  margin: 8px auto 0;
  min-height: 480px;
  padding: 12px;
}
.poly {
  position: absolute;
  width: 30%;
  background: #fbf7ed;
  padding: 12px 12px 44px;
  box-shadow:
    0 18px 30px -10px rgba(20, 30, 25, 0.32),
    0 4px 10px rgba(20, 30, 25, 0.15),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);
  border-radius: 2px;
  transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), z-index 0s;
}
.poly:hover {
  transform: scale(1.08) rotate(0deg) !important;
  z-index: 20;
}
.poly img {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  object-position: center;
  display: block;
  background: #ddd5c5;
  filter: saturate(0.92) contrast(1.02);
}
.poly-cap {
  position: absolute;
  bottom: 10px;
  left: 0;
  right: 0;
  text-align: center;
  font-family: var(--font-script);
  font-size: 22px;
  font-weight: 500;
  color: var(--bb-ink-700);
}

/* Polaroid positions — staggered, "scattered on a table" */
.poly-army  { top:  0%;  left:  2%; transform: rotate(-6deg); z-index: 1; }
.poly-tank  { top:  4%;  left: 33%; transform: rotate( 4deg); z-index: 3; }
.poly-truck { top:  2%;  right: 2%; transform: rotate( 7deg); z-index: 2; }
.poly-van   { bottom: 0%; left: 12%; transform: rotate( 5deg); z-index: 4; }
.poly-swim  { bottom: 2%; right:14%; transform: rotate(-4deg); z-index: 5; width: 34%; }
.poly-swim img { aspect-ratio: 4 / 3; }

@media (max-width: 720px) {
  .poly-board {
    min-height: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px;
    padding: 16px 4px;
  }
  .poly {
    position: relative;
    top: auto !important; left: auto !important;
    right: auto !important; bottom: auto !important;
    width: 44%;
  }
  .poly-swim { width: 60%; }
  .poly-army  { transform: rotate(-4deg); }
  .poly-tank  { transform: rotate( 3deg); }
  .poly-truck { transform: rotate( 5deg); }
  .poly-van   { transform: rotate(-3deg); }
  .poly-swim  { transform: rotate( 2deg); }
}


/* ─── TikTok comments — 2-on-top, 1-on-bottom scattered stack ──── */
.comments {
  margin: 20px 0 26px;
}
.comments-stack {
  position: relative;
  width: 100%;
  max-width: 600px;
  margin: 0 auto;
  min-height: 360px;
  padding: 6px;
}
.comments-stack img {
  position: absolute;
  display: block;
  border-radius: 12px;
  background: #0a0a0a;
  box-shadow:
    0 14px 26px -10px rgba(0, 0, 0, 0.45),
    0 3px 8px rgba(0, 0, 0, 0.20);
  transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), z-index 0s;
}
.comments-stack img:nth-child(1) { /* top-left */
  width: 58%;
  top: 0;
  left: 2%;
  transform: rotate(-2deg);
  z-index: 1;
}
.comments-stack img:nth-child(2) { /* top-right — sits on top of everything */
  width: 60%;
  top: 4%;
  right: 2%;
  transform: rotate(2.5deg);
  z-index: 5;
}
.comments-stack img:nth-child(3) { /* bottom-center, tucked under the top-right card */
  width: 60%;
  top: 32%;
  left: 50%;
  margin-left: -30%;
  transform: rotate(-1.2deg);
  z-index: 3;
}
.comments-stack img:hover {
  transform: scale(1.07) rotate(0deg) !important;
  z-index: 20;
  box-shadow:
    0 22px 40px -10px rgba(0, 0, 0, 0.55),
    0 5px 12px rgba(0, 0, 0, 0.25);
}
@media (max-width: 540px) {
  .comments-stack { min-height: 320px; max-width: 100%; }
  .comments-stack img:nth-child(1) { width: 62%; }
  .comments-stack img:nth-child(2) { width: 62%; }
  .comments-stack img:nth-child(3) { width: 66%; margin-left: -33%; top: 34%; }
}


/* ─── Inline product links + small inline CTA pills ──────────────── */
.body a.product-link {
