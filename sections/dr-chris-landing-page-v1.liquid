:root {
  /* ===================================================================
     COLOR — base palette
     Sampled directly from the live Betterbrand site:
     wordmark green #174233, sage product background ≈ #bed7b0, etc.
     =================================================================== */

  /* Brand forest green (primary). Wordmark + every CTA + headline accent. */
  --bb-forest-950: #0a1f17;   /* near-black; "darkest" headline / hover */
  --bb-forest-900: #0e2a20;
  --bb-forest-800: #102f24;
  --bb-forest-700: #174233;   /* CORE BRAND GREEN — the logo color */
  --bb-forest-600: #1f5a45;
  --bb-forest-500: #2a7158;
  --bb-forest-400: #4a8e76;
  --bb-forest-300: #84b3a0;
  --bb-forest-200: #c2d8cd;
  --bb-forest-100: #e3eee8;
  --bb-forest-50:  #f0f6f2;

  /* Sage — the soft mint background on product photography & section bands. */
  --bb-sage-400: #9ec48a;
  --bb-sage-300: #bed7b0;     /* tincture / hero photo bg */
  --bb-sage-200: #d2e3c6;
  --bb-sage-100: #e3edd6;
  --bb-sage-50:  #f1f6ec;     /* lightest mint band */

  /* Cream / paper — warm neutral surface (the box & off-white sections). */
  --bb-cream-400: #ece4cf;
  --bb-cream-300: #f1ead7;
  --bb-cream-200: #f5efe1;
  --bb-cream-100: #f7f3ea;    /* primary "warm white" page background */
  --bb-cream-50:  #fbf9f3;

  /* Honey / sun-yellow — secondary warm accent.
     Brand sample comes from the CTA pill (#f2cb49) — a saturated sun-yellow,
     not gold. Use this on "Save 20%" tags, secondary CTAs against forest,
     and tonal highlights. The dark end stays usable as readable text. */
  --bb-honey-800: #6e4f0a;
  --bb-honey-700: #946d18;    /* readable on cream as text */
  --bb-honey-600: #c39e2f;
  --bb-honey-500: #f2cb49;    /* CORE — brand sun-yellow */
  --bb-honey-400: #f6d869;
  --bb-honey-300: #fae39a;
  --bb-honey-200: #fdefc4;
  --bb-honey-100: #fff7df;

  /* Amber glass — the tincture bottle hue. Used sparingly. */
  --bb-amberglass: #7d4e1a;

  /* Neutrals (warm, very slightly green). */
  --bb-ink-950: #0c1410;      /* darkest body */
  --bb-ink-900: #16221d;      /* body text */
  --bb-ink-800: #243029;
  --bb-ink-700: #3a4641;
  --bb-ink-600: #5a665f;      /* muted body / captions */
  --bb-ink-500: #7d8881;      /* secondary muted */
  --bb-ink-400: #a8b1ab;      /* placeholder text */
  --bb-ink-300: #c7ccc6;      /* hairline borders */
  --bb-ink-200: #e2e5df;      /* surface borders */
  --bb-ink-100: #eeefe9;      /* card divider */
  --bb-ink-50:  #f6f7f3;      /* faint surface */
  --bb-white:   #ffffff;
  --bb-black:   #000000;

  /* Status — semantic, kept on-palette where possible. */
  --bb-success: #2a7158;      /* brand-aligned green */
  --bb-warning: #c39e2f;      /* honey-600 — darkened brand yellow */
  --bb-danger:  #b5443a;      /* warm earthy red */
  --bb-info:    #2f6790;      /* deep cool blue, used very sparingly */

  /* Promo / sale — bright tomato (used on "ON SALE" labels). */
  --bb-sale: #d83a2e;

  /* ===================================================================
     SEMANTIC color tokens — prefer these in components
     =================================================================== */
  --bg-page:        var(--bb-cream-100);
  --bg-page-alt:    var(--bb-sage-50);
  --bg-band-dark:   var(--bb-forest-700);
  --bg-band-honey:  var(--bb-honey-200);
  --bg-card:        var(--bb-white);
  --bg-card-warm:   var(--bb-cream-50);
  --bg-elevated:    var(--bb-white);

  --fg-default:     var(--bb-ink-900);
  --fg-muted:       var(--bb-ink-600);
  --fg-subtle:      var(--bb-ink-500);
  --fg-inverse:     var(--bb-cream-50);
  --fg-brand:       var(--bb-forest-700);
  --fg-on-brand:    var(--bb-cream-50);
  --fg-on-honey:    var(--bb-forest-800);

  --border-default: var(--bb-ink-200);
  --border-strong:  var(--bb-ink-300);
  --border-brand:   var(--bb-forest-700);

  --ring-focus:     rgba(23, 66, 51, 0.35);

  /* ===================================================================
     TYPE — base
     =================================================================== */
  --font-display: 'Antonio', 'Oswald', 'Bebas Neue', system-ui, sans-serif;
  --font-body:    'DM Sans', ui-sans-serif, system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;
  --font-script:  'Caveat', 'Brush Script MT', cursive;
  --font-mono:    ui-monospace, 'SF Mono', Menlo, Consolas, monospace;

  /* Sizes — modular scale, slightly tightened for product/marketing density. */
  --fs-xs:    12px;
  --fs-sm:    14px;
  --fs-base:  16px;
  --fs-md:    18px;
  --fs-lg:    20px;
  --fs-xl:    24px;
  --fs-2xl:   30px;
  --fs-3xl:   38px;
  --fs-4xl:   48px;
  --fs-5xl:   64px;
  --fs-6xl:   84px;
  --fs-display: 120px;        /* hero billboard wordmark scale */

  --lh-tight:  1.05;
  --lh-snug:   1.18;
  --lh-normal: 1.4;
  --lh-loose:  1.6;

  --tracking-display: -0.01em;
  --tracking-allcaps: 0.04em;     /* labels, eyebrows */
  --tracking-wordmark: 0.02em;    /* BETTERBRAND-style headings */
  --tracking-body: 0em;

  /* ===================================================================
     SPACING, RADIUS, SHADOW, MOTION
     =================================================================== */
  --space-1:  4px;
  --space-2:  8px;
  --space-3:  12px;
  --space-4:  16px;
  --space-5:  20px;
  --space-6:  24px;
  --space-8:  32px;
  --space-10: 40px;
  --space-12: 48px;
  --space-16: 64px;
  --space-20: 80px;
  --space-24: 96px;

  --radius-xs:    2px;
  --radius-sm:    4px;
  --radius-md:    8px;
  --radius-lg:    14px;
  --radius-xl:    20px;
  --radius-2xl:   28px;
  --radius-pill:  999px;

  /* Shadows — soft, warm, never bluish. */
  --shadow-xs: 0 1px 1px rgba(20, 30, 25, 0.04);
  --shadow-sm: 0 2px 6px rgba(20, 30, 25, 0.06);
  --shadow-md: 0 8px 22px rgba(20, 30, 25, 0.08);
  --shadow-lg: 0 18px 40px rgba(20, 30, 25, 0.10);
  --shadow-product: 0 24px 60px rgba(23, 66, 51, 0.18);
  --shadow-inset-soft: inset 0 1px 0 rgba(255, 255, 255, 0.7);

  --ease-out: cubic-bezier(0.2, 0.7, 0.2, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
  --dur-fast:    140ms;
  --dur-base:    220ms;
  --dur-slow:    420ms;
}

/* =====================================================================
   SEMANTIC TYPE — element defaults
   ===================================================================== */
html, body {
  font-family: var(--font-body);
  font-size: var(--fs-base);
  line-height: var(--lh-normal);
  color: var(--fg-default);
  background: var(--bg-page);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

/* Display: condensed all-caps wordmark style. Reserve for hero & sections. */
.h-display,
h1.bb-display {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(56px, 9vw, var(--fs-display));
  line-height: 0.92;
  letter-spacing: var(--tracking-wordmark);
  text-transform: uppercase;
  color: var(--fg-brand);
  text-wrap: balance;
}

h1, .h1 {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: var(--fs-5xl);
  line-height: var(--lh-tight);
  letter-spacing: var(--tracking-wordmark);
  text-transform: uppercase;
  color: var(--fg-brand);
  text-wrap: balance;
}

h2, .h2 {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: var(--fs-4xl);
  line-height: var(--lh-tight);
  letter-spacing: var(--tracking-wordmark);
  text-transform: uppercase;
  color: var(--fg-brand);
  text-wrap: balance;
}

h3, .h3 {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: var(--fs-3xl);
  line-height: var(--lh-snug);
  letter-spacing: var(--tracking-wordmark);
  text-transform: uppercase;
  color: var(--fg-default);
}

h4, .h4 {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: var(--fs-xl);
  line-height: var(--lh-snug);
  letter-spacing: 0;
  color: var(--fg-default);
}

h5, .h5 {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: var(--fs-lg);
  line-height: var(--lh-snug);
  color: var(--fg-default);
}

/* Eyebrow / section-prefix label, e.g. "OUR STORY", "WHY BETTERBRAND" */
.eyebrow {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: var(--fs-xs);
  letter-spacing: var(--tracking-allcaps);
  text-transform: uppercase;
  color: var(--fg-brand);
}

/* Script accent — for hand-lettered phrases on labels & section breaks */
.script {
  font-family: var(--font-script);
  font-weight: 500;
  color: var(--fg-brand);
  font-size: 1.6em;
  line-height: 1;
}

/* Body */
p, .body { font-size: var(--fs-base); line-height: var(--lh-loose); }
.lead    { font-size: var(--fs-md);  line-height: var(--lh-loose); color: var(--fg-muted); }
small, .caption {
  font-size: var(--fs-sm);
  line-height: var(--lh-normal);
  color: var(--fg-muted);
}
.micro {
  font-size: var(--fs-xs);
  letter-spacing: var(--tracking-allcaps);
  text-transform: uppercase;
  color: var(--fg-muted);
}

a {
  color: var(--fg-brand);
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-thickness: 1px;
  transition: color var(--dur-fast) var(--ease-out);
}
a:hover { color: var(--bb-forest-500); }

code, kbd, pre {
  font-family: var(--font-mono);
  font-size: 0.92em;
  background: var(--bb-ink-50);
  padding: 1px 5px;
  border-radius: var(--radius-xs);
}

::selection { background: var(--bb-forest-200); color: var(--bb-forest-900); }

/* =====================================================================
   PRICE TYPE — IMPORTANT
   Prices use the BODY font (DM Sans), bold, never the tall display face.
   Antonio at small sizes reads as awkwardly narrow and is hard to scan.
   Reserve display type for headlines, eyebrows, hero stats (e.g. "81%").
   ===================================================================== */
.bb-price {
  font-family: var(--font-body);
  font-weight: 700;
  color: var(--bb-forest-700);
  letter-spacing: 0;
  font-variant-numeric: tabular-nums;
}
.bb-price--sm { font-size: 16px; }
.bb-price--md { font-size: 20px; }
.bb-price--lg { font-size: 24px; }
.bb-price--xl { font-size: 28px; }

.bb-price-compare {
  font-family: var(--font-body);
  font-weight: 500;
  color: var(--bb-ink-500);
  text-decoration: line-through;
  font-variant-numeric: tabular-nums;
}


* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--bg-page);
  color: var(--fg-default);
  font-family: var(--font-body);
  font-size: 20px;
  line-height: 1.6;
  font-weight: 600;
  -webkit-font-smoothing: antialiased;
}

img { display: block; max-width: 100%; height: auto; }

/* ─── Top advertorial strip ──────────────────────────────────────────── */
.adv-strip {
  background: transparent;
  color: var(--bb-ink-500);
  text-align: center;
  font-family: var(--font-body);
  font-size: 10px;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  font-weight: 500;
  padding: 10px 16px 2px;
}

/* ─── Article container ──────────────────────────────────────────────── */
.article {
  max-width: 820px;
  margin: 0 auto;
  padding: 8px 24px 56px;
}

/* Headline — left-aligned, no brackets, breathes immediately */
.headline {
  font-family: var(--font-body);
  font-weight: 700;
  font-size: clamp(30px, 5vw, 42px);
  line-height: 1.1;
  letter-spacing: -0.02em;
  text-transform: none;
  color: var(--fg-default);
  text-align: left;
  margin: 8px 0 18px;
  text-wrap: balance;
}
.headline em {
  font-style: normal;
  color: var(--fg-brand);
}

.dek {
  font-family: var(--font-body);
  font-size: 26px;
  line-height: 1.4;
  font-weight: 600;
  color: var(--fg-muted);
  text-align: left;
  margin: 0 0 16px;
  text-wrap: pretty;
}

/* Byline — tight, one line, small */
.byline {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10px;
  margin: 0 0 20px;
  font-family: var(--font-body);
  font-size: 15px;
  font-weight: 600;
  color: var(--fg-muted);
}
.byline-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--bb-sage-200);
  overflow: hidden;
  flex-shrink: 0;
}
.byline-avatar img { width: 100%; height: 100%; object-fit: cover; }
.byline-name { color: var(--fg-default); font-weight: 600; }
.byline-name b { color: var(--fg-brand); font-weight: 600; }

/* ─── Body copy ──────────────────────────────────────────────────────── */

.body {
  font-family: var(--font-body);
  font-size: 36px;
  line-height: 1.4;
  font-weight: 600;
  color: var(--fg-default);
}
.body p {
  margin: 0 0 16px;
  text-wrap: pretty;
}
.body p.spacer { margin-bottom: 32px; }
.body strong { font-weight: 800; color: var(--fg-default); }
.body em { font-style: italic; font-weight: 600; color: var(--fg-default); }

/* In-line green emphasis (looks like a link, isn't one) */
.body .hl {
  color: var(--fg-brand);
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-thickness: 1.5px;
  text-decoration-color: var(--fg-brand);
}

.body h2 {
  font-family: var(--font-body);
  font-weight: 800;
  font-size: 38px;
  line-height: 1.18;
  letter-spacing: -0.01em;
  text-transform: none;
  color: var(--fg-default);
  margin: 52px 0 22px;
  text-wrap: balance;
}

.body ol, .body ul {
  margin: 0 0 24px;
  padding-left: 0;
  list-style: none;
}
.body ol li, .body ul li {
  position: relative;
  padding-left: 40px;
  margin-bottom: 12px;
  line-height: 1.4;
  font-weight: 600;
}
.body ol {
  counter-reset: bb;
}
.body ol li {
  counter-increment: bb;
}
.body ol li::before {
  content: counter(bb);
  position: absolute;
  left: 0;
  top: 2px;
  width: 28px;
  height: 28px;
  background: var(--fg-brand);
  color: var(--fg-on-brand);
  border-radius: 50%;
  font-size: 15px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  font-variant-numeric: tabular-nums;
}
.body ul li::before {
  content: "";
  position: absolute;
  left: 8px;
  top: 11px;
  width: 8px;
  height: 8px;
  background: var(--fg-brand);
  border-radius: 50%;
}

/* Sign-off */
.signoff {
  margin: 36px 0 12px;
  font-weight: 600;
  color: var(--fg-default);
}
.signoff small {
  display: block;
  font-weight: 400;
  color: var(--fg-muted);
  font-size: 14px;
  margin-top: 2px;
}

/* ─── Figure / photo blocks ──────────────────────────────────────────── */

.fig {
  margin: 22px 0 26px;
}
.fig img {
  width: 100%;
  border-radius: var(--radius-md);
  display: block;
}
.fig figcaption {
  margin-top: 10px;
  font-family: var(--font-body);
  font-size: 13px;
  line-height: 1.5;
  color: var(--fg-muted);
  text-align: center;
  font-style: italic;
}

/* Placeholder photo slot */
.ph {
  background: var(--bb-sage-100);
  border: 1px dashed var(--bb-sage-400);
  border-radius: var(--radius-md);
  aspect-ratio: 4 / 3;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.ph.portrait { aspect-ratio: 3 / 4; }
.ph.wide { aspect-ratio: 16 / 9; }
.ph.square { aspect-ratio: 1 / 1; }

.ph-inner {
  text-align: center;
  padding: 20px;
  max-width: 320px;
  color: var(--bb-forest-700);
}
.ph-inner .ph-icon {
  width: 36px;
  height: 36px;
  margin: 0 auto 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bb-forest-700);
  color: var(--fg-on-brand);
  border-radius: 50%;
  font-size: 18px;
}
.ph-inner .ph-label {
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-weight: 700;
  margin-bottom: 6px;
  opacity: 0.7;
}
.ph-inner .ph-desc {
  font-size: 14px;
  line-height: 1.45;
  font-weight: 500;
}

/* ─── TikTok milestone grid ──────────────────────────────────────────── */
.tt-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin: 28px 0;
}
@media (max-width: 540px) {
  .tt-grid { grid-template-columns: repeat(2, 1fr); }
}

.tt-card {
  background: #0b0b0b;
  color: #fff;
  aspect-ratio: 9 / 16;
  border-radius: var(--radius-md);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 12px;
}
.tt-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 30% 30%, rgba(255, 90, 130, 0.4), transparent 55%),
    radial-gradient(circle at 70% 70%, rgba(0, 200, 220, 0.4), transparent 55%),
    linear-gradient(180deg, #1a1a1a, #050505);
}
.tt-card > * { position: relative; z-index: 1; }
.tt-day {
  font-family: var(--font-body);
  font-weight: 800;
  font-size: 28px;
  line-height: 1;
  letter-spacing: -0.02em;
}
.tt-day small {
  display: block;
  font-size: 9px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-weight: 600;
  opacity: 0.7;
  margin-bottom: 4px;
}
.tt-quote {
  font-size: 12px;
  line-height: 1.35;
  font-weight: 500;
  opacity: 0.95;
  text-wrap: pretty;
}
.tt-handle {
  font-size: 10px;
  letter-spacing: 0.04em;
  opacity: 0.7;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}
.tt-handle::before {
  content: "▶";
  font-size: 7px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 14px;
  height: 14px;
  border: 1px solid currentColor;
  border-radius: 50%;
}

.tt-caption {
  text-align: center;
  font-size: 13px;
  color: var(--fg-muted);
  font-style: italic;
  margin-top: -12px;
  margin-bottom: 32px;
}
.tt-caption a {
  color: var(--fg-brand);
  font-weight: 600;
}

/* ─── "His three reasons" — featured reasons card ────────────────────── */
.reasons {
  margin: 32px 0 36px;
  padding: 28px 32px 30px;
  background: var(--bb-sage-50);
  border: 1px solid var(--bb-sage-200);
  border-radius: var(--radius-lg);
}
.reasons-eyebrow {
  font-family: var(--font-body);
  font-size: 12px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--fg-brand);
  margin: 0 0 22px;
}
.reasons-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 22px;
}
.reasons-list li,
.body .reasons-list li {
  display: block;
  padding: 0;
  padding-left: 0;
  margin: 0;
  margin-bottom: 0;
  line-height: 1.3;
}
.reasons-list li::before,
.body .reasons-list li::before { content: none; }

.reasons-list h3 {
  display: flex;
  align-items: center;
  gap: 14px;
  font-family: var(--font-body);
  font-size: 30px;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.01em;
  color: var(--fg-brand);
  margin: 0 0 8px;
  text-transform: none;
}
.reasons-list > li > p {
  margin: 0;
  font-size: 22px;
  line-height: 1.35;
  font-weight: 600;
  color: var(--fg-default);
  text-wrap: pretty;
}

.reasons-num {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--fg-brand);
  color: var(--fg-on-brand);
  font-family: var(--font-body);
  font-weight: 800;
  font-size: 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
  line-height: 1;
}

@media (max-width: 540px) {
  .reasons { padding: 22px 18px 24px; margin: 24px 0 28px; }
  .reasons-list { gap: 18px; }
  .reasons-num { width: 32px; height: 32px; font-size: 15px; }
  .reasons-list h3 { font-size: 22px; gap: 10px; }
  .reasons-list > li > p { font-size: 17px; }
}

/* ─── Pull quote ─────────────────────────────────────────────────────── */
.pq {
  border-left: 5px solid var(--fg-brand);
  padding: 8px 0 8px 26px;
  margin: 36px 0;
  font-size: 34px;
  line-height: 1.26;
  font-weight: 700;
  color: var(--fg-default);
  text-wrap: pretty;
}
.pq cite {
  display: block;
  margin-top: 12px;
  font-size: 13px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-style: normal;
  font-weight: 700;
  color: var(--fg-muted);
}

/* ─── CTA block ──────────────────────────────────────────────────────── */
.cta {
  background: var(--bb-forest-700);
  color: var(--fg-on-brand);
  margin: 48px -24px 0;
  padding: 36px 28px 40px;
  border-radius: var(--radius-lg);
  text-align: center;
}
.cta-bottle {
  width: 220px;
  height: 220px;
  object-fit: cover;
  margin: 0 auto 22px;
  display: block;
  border-radius: var(--radius-lg);
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25);
}
.cta-eyebrow {
  font-family: var(--font-body);
  font-size: 11px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--bb-honey-400);
  margin-bottom: 12px;
}
.cta h3 {
  font-family: var(--font-body);
  font-size: 28px;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: -0.01em;
  text-transform: none;
  margin: 0 auto 36px;
  max-width: 460px;
  color: var(--bb-cream-50);
  text-wrap: balance;
}
.cta h3 em {
  font-style: normal;
  color: var(--bb-honey-400);
  font-weight: 700;
}
.cta p {
  font-size: 18px;
  line-height: 1.5;
  font-weight: 600;
  margin: 0 auto 26px;
  max-width: 480px;
  color: var(--bb-cream-200);
}
.cta-btn {
  display: inline-block;
  background: var(--bb-honey-500);
  color: var(--bb-forest-800);
  font-family: var(--font-body);
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 18px 36px;
  border-radius: var(--radius-pill);
  text-decoration: none;
  border: 0;
  cursor: pointer;
}
.cta-btn:hover { filter: brightness(1.05); }

.cta-offer {
  display: none;
  margin-top: 14px;
  font-size: 13px;
  letter-spacing: 0.05em;
  color: var(--bb-honey-300);
  font-weight: 600;
}
[data-cta="medium"] .cta-offer { display: block; }
[data-cta="medium"] .cta h3 { font-size: 28px; }

.cta-stats {
  display: flex;
  gap: 20px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 26px;
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-weight: 600;
  color: var(--bb-cream-200);
}
.cta-stats span { display: inline-flex; align-items: center; gap: 6px; }
.cta-stats span::before {
  content: "\2713";
  color: var(--bb-honey-400);
}

/* Trust seal row */
.seals {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24px;
  margin: 36px 0 0;
  flex-wrap: wrap;
}
.seals img {
  width: 64px;
  height: auto;
  opacity: 0.9;
}
[data-seals="off"] .seals { display: none; }

/* ─── Product-line variants (gummies vs Quit Smoking Bundle) ─────────
   Each variant in tweaks-app sets body[data-product] to "gummies" or
   "bundle". The back-half copy, the pre-CTA figure, the mullein-plant
   figure, and the buy box all have parallel [data-product] blocks.
   Hide whichever doesn't match the active variant.
   ─────────────────────────────────────────────────────────────────── */
body[data-product="gummies"] [data-product="bundle"],
body[data-product="bundle"] [data-product="gummies"] {
  display: none !important;
}

/* ─── Footer ─────────────────────────────────────────────────────────── */
.foot {
  max-width: 680px;
  margin: 0 auto;
  padding: 32px 24px 56px;
  font-size: 11px;
  line-height: 1.55;
  color: var(--bb-ink-500);
  text-align: center;
}
