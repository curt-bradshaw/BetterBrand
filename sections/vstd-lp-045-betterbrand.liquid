  <script>


(function(){
  var TARGETS = ["hpd-sticky-atc"];
  function wire(sel){
    var links = document.querySelectorAll(sel);
    links.forEach(function(link, i){
      var href = (link.getAttribute('href') || '').trim();
      if (href && href !== '#') return;        // real anchors handled by CSS smooth scroll
      if (link.dataset.cloneNavWired) return;
      link.dataset.cloneNavWired = '1';
      link.addEventListener('click', function(e){
        var id = TARGETS[i]; if (!id) return;
        var t = document.getElementById(id); if (!t) return;
        e.preventDefault();
        t.scrollIntoView({ behavior:'smooth', block:'center' });
      });
    });
  }
  function init(){
    // reliable menu containers; each maps ITS OWN links by index into TARGETS
    // (kept specific so unrelated bare-"#" links elsewhere aren't mis-mapped)
    ['.topMenu a', '.mobilemenu a', 'nav ul li a'].forEach(wire);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
  
  
