  document.head.appendChild(st);
  function frac(){
    var doc=document.documentElement, body=document.body;
    var top=window.pageYOffset||doc.scrollTop||body.scrollTop||0;
    var sh=Math.max(doc.scrollHeight, body.scrollHeight);
    var max=sh-window.innerHeight;
    return max>0?top/max:0;
  }
  function upd(){
    bar.style.setProperty('display','block','important');
    bar.style.transform = frac()>=0.30 ? 'translateY(0)' : 'translateY(130%)';
  }
  window.addEventListener('scroll',upd,{passive:true});
  document.addEventListener('scroll',upd,{passive:true,capture:true});
  window.addEventListener('resize',upd,{passive:true});
  setInterval(upd,250);
  upd();
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();

  
  
  
