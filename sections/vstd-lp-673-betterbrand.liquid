  <script>

      document.addEventListener('DOMContentLoaded', function () {
        const buttons = document.querySelectorAll('.vy-block__top-scroll-button');

        if (!buttons.length) return;

        buttons.forEach(function (btn) {
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            scrollToTop(0, 300);
          });
        });

        window.addEventListener('scroll', function () {
          const isScrolled =
            document.body.scrollTop > 10 ||
            document.documentElement.scrollTop > 10;

          buttons.forEach(function (btn) {
            btn.style.transform = isScrolled ? 'scale(1)' : 'scale(0)';
          });
        });

        function scrollToTop(target, duration) {
          if (duration <= 0) return;

          const currentScroll =
            document.documentElement.scrollTop || document.body.scrollTop;

          const difference = target - currentScroll;
          const speed = (difference / duration) * 10;

          setTimeout(function () {
            document.documentElement.scrollTop = currentScroll + speed;
            document.body.scrollTop = currentScroll + speed;

            const newScroll =
              document.documentElement.scrollTop || document.body.scrollTop;

            if (Math.abs(newScroll - target) <= 1) {
              document.documentElement.scrollTop = target;
              document.body.scrollTop = target;
              return;
            }

            scrollToTop(target, duration - 10);
          }, 10);
        }
      });
   
  </script>

