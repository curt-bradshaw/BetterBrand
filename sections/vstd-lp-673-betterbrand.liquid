  <script>

  document.addEventListener('DOMContentLoaded', function() {
    // Only run on product-v2 template
    
    
    const carousel = document.querySelector('media-carousel');
    if (!carousel) return;

    const slider = carousel.querySelector('.vy-product-gallery__media-slider');
    const slides = carousel.querySelectorAll('.vy-product-gallery__media');
    const thumbnails = document.querySelectorAll('.vy-product-gallery__thumbnail');
    
    // Find arrow buttons in the thumbnail wrapper
    const thumbnailWrapper = document.querySelector('.vy-product-gallery__thumbnail-list-wrapper');
    const prevBtn = thumbnailWrapper ? thumbnailWrapper.querySelector('.vy-product-gallery__arrow--prev') : null;
    const nextBtn = thumbnailWrapper ? thumbnailWrapper.querySelector('.vy-product-gallery__arrow--next') : null;
    
    let currentIndex = 0;
    let isAnimating = false;

    // Find current selected slide index
    slides.forEach((slide, index) => {
      if (slide.classList.contains('vy-is-selected')) {
        currentIndex = index;
      }
    });

    // Initialize first slide
    if (slides.length > 0 && !slides[currentIndex]?.classList.contains('vy-is-selected')) {
      slides[0].classList.add('vy-is-selected');
      currentIndex = 0;
    }

    function updateCarousel(newIndex) {
      if (isAnimating || newIndex === currentIndex || !slides[newIndex]) return;
      
      isAnimating = true;

      // Remove selected state from all slides
      slides.forEach(slide => {
        slide.classList.remove('vy-is-selected');
      });
      
      // Add selected state to new slide
      slides[newIndex].classList.add('vy-is-selected');
      
      // Update slider position without smooth scroll - INSTANT JUMP
      if (slider) {
        const slideWidth = slides[newIndex].offsetWidth;
        slider.scrollLeft = newIndex * slideWidth;
      }

      // Update thumbnails
      thumbnails.forEach((thumb, index) => {
        if (index === newIndex) {
          thumb.setAttribute('aria-current', 'true');
        } else {
          thumb.setAttribute('aria-current', 'false');
        }
      });

      currentIndex = newIndex;

      // Reset animation lock after transition
      setTimeout(() => {
        isAnimating = false;
      }, 400);
    }

    function nextSlide() {
      const newIndex = (currentIndex + 1) % slides.length;
      updateCarousel(newIndex);
    }

    function prevSlide() {
      const newIndex = (currentIndex - 1 + slides.length) % slides.length;
      updateCarousel(newIndex);
    }

    // Click handlers for arrows in thumbnail section
    if (prevBtn) {
      prevBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        prevSlide();
      });
    }
    
    if (nextBtn) {
      nextBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        nextSlide();
      });
    }

    // Click handlers for thumbnails
    thumbnails.forEach((thumb, index) => {
      thumb.addEventListener('click', function() {
        updateCarousel(index);
      });
    });

    // Handle scroll snap changes - for manual scrolling only
    if (slider) {
      let scrollTimeout;
      slider.addEventListener('scroll', function() {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          // Find which slide is currently in view
          const slideWidth = slides[0]?.offsetWidth || 0;
          const scrollPosition = slider.scrollLeft;
          const newIndex = Math.round(scrollPosition / slideWidth);
          
          if (newIndex !== currentIndex && newIndex < slides.length && newIndex >= 0) {
            // Update thumbnails on scroll
            thumbnails.forEach((thumb, index) => {
              thumb.setAttribute('aria-current', index === newIndex ? 'true' : 'false');
            });
            currentIndex = newIndex;
          }
        }, 50);
      });
    }

    // Keyboard navigation
    document.addEventListener('keydown', function(e) {
      // Only if carousel is visible
      if (!carousel.offsetParent) return;
      
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prevSlide();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        nextSlide();
      }
    });

    // Touch/swipe support
    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;
    let touchEndY = 0;
    let isSwiping = false;

    carousel.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
      isSwiping = true;
    }, { passive: true });

    carousel.addEventListener('touchmove', function(e) {
      if (!isSwiping) return;
      touchEndX = e.changedTouches[0].screenX;
      touchEndY = e.changedTouches[0].screenY;
    }, { passive: true });

    carousel.addEventListener('touchend', function(e) {
      if (!isSwiping) return;
      isSwiping = false;
      
      touchEndX = e.changedTouches[0].screenX;
      touchEndY = e.changedTouches[0].screenY;
      
      const diffX = touchStartX - touchEndX;
      const diffY = touchStartY - touchEndY;
      
      // Only trigger if horizontal swipe is greater than vertical
      if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 50) {
        if (diffX > 0) {
          nextSlide();
        } else {
          prevSlide();
        }
      }
    }, { passive: true });

    // Auto-play functionality (if enabled)
    let autoplayInterval;
    
    if (carousel.hasAttribute('autoplay')) {
      function startAutoplay() {
        stopAutoplay();
        autoplayInterval = setInterval(() => {
          nextSlide();
        }, 5000);
      }
      
      function stopAutoplay() {
        if (autoplayInterval) {
          clearInterval(autoplayInterval);
          autoplayInterval = null;
        }
      }
      
      // Start autoplay
      startAutoplay();
      
      // Pause on hover
      carousel.addEventListener('mouseenter', stopAutoplay);
      carousel.addEventListener('mouseleave', startAutoplay);
      
      // Pause on touch
      carousel.addEventListener('touchstart', stopAutoplay);
      carousel.addEventListener('touchend', startAutoplay);
    }

    // Handle window resize
    let resizeTimeout;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        // Recalculate current slide based on scroll position
        if (slider) {
          const slideWidth = slides[0]?.offsetWidth || 0;
          const scrollPosition = slider.scrollLeft;
          const newIndex = Math.round(scrollPosition / slideWidth);
          if (newIndex < slides.length && newIndex >= 0) {
            currentIndex = newIndex;
          }
        }
      }, 250);
    });

    console.log('Product gallery carousel initialized with ' + slides.length + ' slides');
    
    
  });

  </script>

