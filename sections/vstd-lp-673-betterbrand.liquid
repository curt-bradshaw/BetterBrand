{%- comment -%} vystodian agent: lp-673-betterbrand. Offers come from the CURRENT product, so a duplicated
product needs no edit here: variant[0] = single, variant[1] = 3-pack, subscription = its 3-month selling plan. {%- endcomment -%}
{%- assign bl_v1 = product.variants[0] -%}
{%- assign bl_v3 = product.variants[1] -%}
{%- assign bl_sub_price = bl_v3.price -%}
{%- assign bl_sub_plan_id = '' -%}
{%- for alloc in bl_v3.selling_plan_allocations -%}
  {%- assign pn = alloc.selling_plan.name | downcase -%}
  {%- if bl_sub_plan_id == '' and pn contains 'every 3 month' -%}
    {%- assign bl_sub_price = alloc.price -%}{%- assign bl_sub_plan_id = alloc.selling_plan.id -%}
  {%- endif -%}
{%- endfor -%}
{%- if bl_sub_plan_id == '' -%}
  {%- for alloc in bl_v3.selling_plan_allocations -%}
    {%- if bl_sub_plan_id == '' -%}
      {%- assign bl_sub_price = alloc.price -%}{%- assign bl_sub_plan_id = alloc.selling_plan.id -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign bl_cmp = bl_v1.price | times: 3 -%}
{%- assign bl_sub_save = bl_cmp | minus: bl_sub_price -%}
{%- assign bl_3_save = bl_cmp | minus: bl_v3.price -%}
{%- assign bl_sub_pct = bl_sub_save | times: 100.0 | divided_by: bl_cmp | round -%}
{%- assign bl_3_pct = bl_3_save | times: 100.0 | divided_by: bl_cmp | round -%}
